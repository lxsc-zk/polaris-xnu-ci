+/* RPMh client: cmd_db at 0x85fe0000, apps RSC DRV0 at 0x179c0000. */
+#define RPMH_CMD_DB_PA		0x85fe0000ull
+#define RPMH_CMD_DB_LEN		0x20000u
+#define RPMH_RSC_DRV0_PA	0x179c0000ull
+#define RPMH_RSC_LEN		0x10000u
+#define RPMH_TCS_STRIDE		0x2a0u
+#define RPMH_CMD_STRIDE		0x14u
+#define RPMH_IRQ_STATUS		0x04u
+#define RPMH_IRQ_CLEAR		0x08u
+#define RPMH_CMD_ENABLE		0x1cu
+#define RPMH_CMD_MSGID		0x30u
+#define RPMH_CMD_ADDR		0x34u
+#define RPMH_CMD_DATA		0x38u
+#define RPMH_MSGID_WRITE	(8u | (1u << 16))
+
+struct rpmh_res {
+	uint32_t addr;
+	const char *name;
+	uint32_t levels;
+};
+
+static uint32_t
+rpmh_db_u16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static uint32_t
+rpmh_db_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Look a resource up by its 8 byte cmd_db id. */
+static int
+rpmh_cmd_db_find(const uint8_t *db, const char *name, struct rpmh_res *out)
+{
+	int i, j;
+	const uint8_t *ent_base, *data_base;
+	char want[8];
+
+	for (i = 0; i < 8; i++) {
+		want[i] = name[i];
+		if (name[i] == 0) {
+			for (j = i; j < 8; j++) {
+				want[j] = 0;
+			}
+			break;
+		}
+	}
+	/* header is 0x90 bytes: version(4) magic(4) rsc_hdr[8](16 each) cksum(4) rsvd(4) */
+	for (i = 0; i < 8; i++) {
+		const uint8_t *rh = db + 8 + i * 16;
+		uint32_t cnt = rpmh_db_u16(rh + 6);
+		uint32_t hoff = rpmh_db_u16(rh + 2);
+		uint32_t doff = rpmh_db_u16(rh + 4);
+		if (cnt == 0 || cnt > 256) {
+			continue;
+		}
+		ent_base = db + 0x90 + hoff;
+		data_base = db + 0x90 + doff;
+		for (j = 0; j < (int)cnt; j++) {
+			const uint8_t *e = ent_base + j * 24;
+			if (e[0] == want[0] && e[1] == want[1] &&
+			    e[2] == want[2] && e[3] == want[3] &&
+			    e[4] == want[4] && e[5] == want[5] &&
+			    e[6] == want[6] && e[7] == want[7]) {
+				out->name = name;
+				out->addr = rpmh_db_u32(e + 16);
+				out->levels = rpmh_db_u16(e + 20) / 2;
+				return 0;
+			}
+		}
+	}
+	return -1;
+}
+
+/* Send one level command to a resource through TCS 0. */
+static int
+rpmh_write_level(vm_offset_t rsc, uint32_t addr, uint32_t level,
+    const char *what)
+{
+	uint32_t base = 0;	/* tcs 0 */
+	uint32_t v, i;
+	int ok = 0;
+
+	base = 0;
+	pwr_write(rsc, base + RPMH_CMD_MSGID, RPMH_MSGID_WRITE | (1u << 8));
+	pwr_write(rsc, base + RPMH_CMD_ADDR, addr);
+	pwr_write(rsc, base + RPMH_CMD_DATA, level);
+	pwr_delay();
+	pwr_write(rsc, base + RPMH_IRQ_CLEAR, 0xffffffffu);
+	pwr_write(rsc, base + RPMH_CMD_ENABLE, 1u);
+	for (i = 0; i < 20000; i++) {
+		v = pwr_read(rsc, base + RPMH_IRQ_STATUS);
+		if (v & 1u) {
+			ok = 1;
+			break;
+		}
+		pwr_delay();
+	}
+	printf("POLARIS RPMH: %s addr=0x%08x level=%u irq=0x%08x polls=%u %s\n",
+	    what, addr, level, pwr_read(rsc, base + RPMH_IRQ_STATUS), i,
+	    ok ? "OK" : "TIMEOUT");
+	pwr_write(rsc, base + RPMH_IRQ_CLEAR, 0xffffffffu);
+	return ok ? 0 : -1;
+}
+
+void
+polaris_gpu_rpmh(void)
+{
+	int optin = 0;
+	vm_offset_t gpucc, gcc, db, rsc, gmu;
+	uint8_t *d;
+	struct rpmh_res gfx, cx, mx;
+	uint32_t v, i, magic;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 24) {
+		return;
+	}
+	db = ml_io_map(RPMH_CMD_DB_PA, RPMH_CMD_DB_LEN);
+	rsc = ml_io_map(RPMH_RSC_DRV0_PA, RPMH_RSC_LEN);
+	gpucc = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!db || !rsc || !gpucc || !gcc || !gmu) {
+		printf("POLARIS RPMH: map failed\n");
+		return;
+	}
+	d = (uint8_t *)db;
+	magic = rpmh_db_u32(d + 4);
+	printf("POLARIS RPMH: cmd_db magic=0x%08x (want 0x0c0330db) ver=0x%08x\n",
+	    magic, rpmh_db_u32(d));
+	if (rpmh_cmd_db_find(d, "gfx.lvl", &gfx) != 0) {
+		printf("POLARIS RPMH: gfx.lvl not found\n");
+	} else {
+		printf("POLARIS RPMH: gfx.lvl addr=0x%08x levels=%u\n",
+		    gfx.addr, gfx.levels);
+	}
+	if (rpmh_cmd_db_find(d, "cx.lvl", &cx) != 0) {
+		printf("POLARIS RPMH: cx.lvl not found\n");
+		cx.addr = 0;
+	} else {
+		printf("POLARIS RPMH: cx.lvl addr=0x%08x levels=%u\n",
+		    cx.addr, cx.levels);
+	}
+	if (rpmh_cmd_db_find(d, "mx.lvl", &mx) != 0) {
+		printf("POLARIS RPMH: mx.lvl not found\n");
+		mx.addr = 0;
+	} else {
+		printf("POLARIS RPMH: mx.lvl addr=0x%08x levels=%u\n",
+		    mx.addr, mx.levels);
+	}
+	printf("POLARIS RPMH: rsc control=0x%08x status=0x%08x irq=0x%08x\n",
+	    pwr_read(rsc, 0x14u), pwr_read(rsc, 0x18u), pwr_read(rsc, 0x04u));
+	/* CX / MX first, then the GPU rail */
+	if (mx.addr && mx.levels) {
+		rpmh_write_level(rsc, mx.addr, mx.levels - 1, "mx.lvl");
+	}
+	if (cx.addr && cx.levels) {
+		rpmh_write_level(rsc, cx.addr, cx.levels - 1, "cx.lvl");
+	}
+	if (gfx.addr && gfx.levels) {
+		rpmh_write_level(rsc, gfx.addr, gfx.levels - 1, "gfx.lvl");
+	}
+	pwr_delay();
+	/* now the GPU side */
+	v = pwr_read(gpucc, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(gpucc, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(gpucc, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	pwr_write(gpucc, 0x101cu, 0x00000002u);
+	pwr_delay();
+	pwr_write(gpucc, 0x1020u, 0x00000501u);
+	pwr_delay();
+	v = pwr_read(gpucc, 0x1054u);
+	pwr_write(gpucc, 0x1054u, v | 1u);
+	pwr_delay();
+	printf("POLARIS RPMH: branch1054=0x%08x CX=0x%08x GX=0x%08x\n",
+	    pwr_read(gpucc, 0x1054u), pwr_read(gpucc, GDSC_CX),
+	    pwr_read(gpucc, GDSC_GX));
+	v = pwr_read(gpucc, GDSC_GX);
+	pwr_write(gpucc, GDSC_GX, v & ~1u);
+	for (i = 0; i < 5000; i++) {
+		pwr_delay();
+		v = pwr_read(gpucc, GDSC_GX);
+		if (v & (1u << 31)) {
+			break;
+		}
+	}
+	printf("POLARIS RPMH: GX=0x%08x polls=%u %s\n", v, i,
+	    (v & (1u << 31)) ? "ON" : "OFF");
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	v = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS RPMH: general7=0x%08x %s\n", v,
+	    (v == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	printf("POLARIS RPMH: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
