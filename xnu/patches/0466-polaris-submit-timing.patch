--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -18,4 +18,5 @@
 #include <sys/param.h>
 #include <sys/systm.h>
-#include <machine/machine_routines.h>
+#include <machine/machine_routines.h>
+#include <mach/mach_time.h>
 #include <pexpert/pexpert.h>
@@ -2301,7 +2301,9 @@
 uint32_t
-sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned count)
-{
-	if (!gpu_live || ib_iova == NULL || ib_dwords == NULL || count == 0) {
-		return 0;
-	}
+sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned count)
+{
+	uint64_t t0 = mach_absolute_time();
+
+	if (!gpu_live || ib_iova == NULL || ib_dwords == NULL || count == 0) {
+		return 0;
+	}
 	for (unsigned i = 0; i < count; i++) {
@@ -2341,10 +2341,31 @@
 		uint32_t used = (gpu_cp_wptr + dwords - (rptr % dwords)) % dwords;
 
-		if (used > dwords - 512u) {
-			if (!gpu_ring_wait_idle(gpu_core, "ring full")) {
-				return 0;
-			}
-		}
-	}
-	return gpu_cp_seq;
+		if (used > dwords - 512u) {
+			if (!gpu_ring_wait_idle(gpu_core, "ring full")) {
+				return 0;
+			}
+		}
+	}
+	{
+		/*
+		 * How long our own submit path takes, averaged over 32 calls. The compositor
+		 * produced a frame every dozen seconds with the ring empty, so the time is either
+		 * here or in the client's wait; this separates the two. Ticks are the platform
+		 * timebase (24 MHz on this SoC), so ticks / 24 is microseconds.
+		 */
+		static uint64_t t_sum, t_worst;
+		static unsigned t_n;
+		uint64_t t_dt = mach_absolute_time() - t0;
+
+		t_sum += t_dt;
+		if (t_dt > t_worst) {
+			t_worst = t_dt;
+		}
+		if (++t_n == 32) {
+			printf("SWEET GPU: submit timing: avg %llu us worst %llu us over %u\n",
+			    (unsigned long long)(t_sum / 32 / 24), (unsigned long long)(t_worst / 24), t_n);
+			t_sum = 0; t_worst = 0; t_n = 0;
+		}
+	}
+	return gpu_cp_seq;
 }
