Subject: [PATCH] polaris: dipper's boot order -- rail grant and SPTPRAC before HFI

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -3435,6 +3435,31 @@
 	printf("adreno: %u: polaris: after 50 ms: fence=%#x ao_fence=%#x hfi_status=%#x fw_init=%#x\n", step,
 	    rd(gmu.base + GMU_AHB_FENCE_STATUS), rd(gmu.base + 0x24c4cu), rd(gmu.base + GMU_HFI_CTRL_STATUS),
 	    rd(gmu.base + GMU_CM3_FW_INIT_RESULT));
+	/*
+	 * polaris (0369): dipper's order -- the rail grant and SPTPRAC power-up come before HFI,
+	 * not after. gmu_gfx_rail_on() writes the GX/MX votes, asks 22/30, then powers SPTPRAC
+	 * up; only then does gmu_hfi_start() run.
+	 */
+	{
+		uint32_t grant = 0;
+
+		wr(gmu.base + 0x8fe0u, 0);
+		wr(gmu.base + 0x8fe4u, 3u);            /* bring-up: rail idx gx=3 mx=3 */
+		wr(gmu.base + 0x8fe8u, 3u);
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		wr(gmu.base + GMU_HOST2GMU_INTR_SET, 1u << 22);
+		for (int i = 0; i < 5000 && !(grant & (1u << 30)); i++) {
+			sleep_us(100);
+			grant = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
+		}
+		wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 1u << 30);
+		printf("adreno: %u: polaris: before HFI: rail set 22 -> ack 30 %s (info %#x, rpmh %#x)\n", step,
+		    (grant & (1u << 30)) ? "ACKED" : "TIMEOUT", grant, rd(gmu.base + GMU_RPMH_POWER_STATE));
+		wr(gmu.base + 0x204u, 0x778000u);
+		printf("adreno: %u: polaris: before HFI: SPTPRAC enable -> %#x (%s)\n", step,
+		    rd(gmu.base + GMU_SPTPRAC_PWR_CLK_STATUS),
+		    wait_for(&gmu, GMU_SPTPRAC_PWR_CLK_STATUS, 0x38, 0x28, 200) ? "on" : "NOT on");
+	}
 	put(&gmu, "hfi_ctrl_init", GMU_HFI_CTRL_INIT, 1);
 	/*
 	 * polaris: whatever the firmware does next may wedge the GMU block, and the read that
@@ -3851,39 +3876,6 @@
 	}
 
 gpu_set:
-	/*
-	 * polaris (0367): the GX rail grant comes first. The bring-up's log has
-	 * "oob set 22 ack 30 -> ACKED" and only then "oob set 16 ack 24 -> ACKED"; asking for the
-	 * core without it leaves rpmh_power_state at 0 and the 16/24 grant never arrives.
-	 */
-	{
-		uint32_t rail_grant = 0;
-
-		put(&gmu, "host2gmu_intr_set", GMU_HOST2GMU_INTR_SET, 1u << 22);
-		for (int i = 0; i < 5000 && !(rail_grant & (1u << 30)); i++) {
-			sleep_us(100);
-			rail_grant = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
-		}
-		put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 1u << 30);
-		printf("adreno: %u: polaris: rail grant: set 22 -> ack 30 %s (info %#x, rpmh %#x)\n", step,
-		    (rail_grant & (1u << 30)) ? "ACKED" : "TIMEOUT", rail_grant,
-		    rd(gmu.base + GMU_RPMH_POWER_STATE));
-	}
-	/*
-	 * polaris (0368): dipper's gmu_sptprac_enable(), with this board's registers. Its
-	 * gmu_gfx_rail_on() powers SPTPRAC up between the rail grant and HFI; without it the
-	 * firmware never issues the GPU_SET grant at 0x507e648 bit 24.
-	 *   control 0x778000 at gmu+0x204   (dipper GMU_SPTPRAC_CTRL_W)
-	 *   status 0x38 == 0x28 at gmu+0x340 (this driver's GMU_SPTPRAC_PWR_CLK_STATUS)
-	 */
-	wr(gmu.base + 0x204u, 0x778000u);
-	{
-		bool sptp_on = wait_for(&gmu, GMU_SPTPRAC_PWR_CLK_STATUS, 0x38, 0x28, 200);
-
-		printf("adreno: %u: polaris: SPTPRAC enable: status %#x (%s), gx_gdscr %#x\n", step,
-		    rd(gmu.base + GMU_SPTPRAC_PWR_CLK_STATUS), sptp_on ? "on" : "NOT on",
-		    rd(gpucc.base + GPUCC_GX_GDSCR));
-	}
 	announce("ask the GMU to power the 3D core and keep it powered");
 	get(&gmu, "sptprac_pwr_clk_status", GMU_SPTPRAC_PWR_CLK_STATUS);
 	get(&gpucc, "gx_gdscr", GPUCC_GX_GDSCR);
