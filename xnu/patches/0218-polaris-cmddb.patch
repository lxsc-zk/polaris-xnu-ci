+/* ---- RPMh command database: the per-resource level lists the PERF table
+ * votes must index (a6xx_gmu_rpmh_arc_votes_init). ---- */
+#define POLARIS_CMD_DB_PHYS 0x85fe0000ull
+#define POLARIS_CMD_DB_SIZE 0x20000u
+
+struct polaris_cmd_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct polaris_cmd_hdr {
+	uint32_t version;
+	uint8_t magic[4];
+	struct polaris_cmd_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct polaris_cmd_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static const uint16_t *
+polaris_cmd_levels(vm_offset_t db, const char *name, uint32_t *count)
+{
+	const struct polaris_cmd_hdr *h = (const struct polaris_cmd_hdr *)db;
+	char id[8];
+	uint32_t s, i, k;
+
+	for (k = 0; k < 8u; k++) {
+		id[k] = name[k];
+	}
+	for (s = 0; s < 8u; s++) {
+		const struct polaris_cmd_slave *sl = &h->slave[s];
+		const struct polaris_cmd_entry *e;
+
+		if (sl->id == 0u || sl->header_offset >= POLARIS_CMD_DB_SIZE - 0x1000u ||
+		    sl->count > 512u) {
+			continue;
+		}
+		e = (const struct polaris_cmd_entry *)((vm_offset_t)db + sl->header_offset);
+		for (i = 0; i < sl->count; i++) {
+			uint32_t same = 1u;
+
+			for (k = 0; k < 8u; k++) {
+				if (e[i].id[k] != id[k]) {
+					same = 0u;
+					break;
+				}
+			}
+			if (!same) {
+				continue;
+			}
+			if (e[i].length < 2u || e[i].length > 64u ||
+			    sl->data_offset + e[i].offset + e[i].length >= POLARIS_CMD_DB_SIZE - 0x1000u) {
+				return NULL;
+			}
+			*count = e[i].length / 2u;
+			return (const uint16_t *)((vm_offset_t)db + sl->data_offset + e[i].offset);
+		}
+	}
+	return NULL;
+}
