+	printf("POLARIS RPMH: solver=0x%08x prnt=0x%08x\n",
+	    pwr_read(rsc, 0x04u), pwr_read(rsc, 0x0cu));
+	printf("POLARIS RPMH: tcs irq_en=0x%08x irq_sts=0x%08x\n",
+	    pwr_read(rsc, RPMH_TCS_BASE_OFF), pwr_read(rsc, RPMH_TCS_BASE_OFF + 0x04u));
 	printf("POLARIS RPMH: tcs0 cmd_enable=0x%08x status=0x%08x\n",
 	    pwr_read(rsc, RPMH_TCS_BASE_OFF + 0x1cu),
 	    pwr_read(rsc, RPMH_TCS_BASE_OFF + 0x18u));
