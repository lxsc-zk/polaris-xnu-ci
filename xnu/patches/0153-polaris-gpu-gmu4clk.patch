diff --git a/bsd/dev/polaris_gpu_power.c b/bsd/dev/polaris_gpu_power.c
index 91fc805..0f924ab 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -2606,6 +2606,98 @@ polaris_gpu_arc(void)
 	}
 }
 
+/*
+ * The GMU needs four clocks (DT order): gmu_clk (GPUCC 0x1098),
+ * cxo_clk (GPUCC 0x109c), axi_clk (GCC 0x44038) and memnoc_clk
+ * (GCC 0x7100c). Only the first and last were being enabled, so the GMU
+ * register interface never answered.
+ */
+void
+polaris_gpu_gmu4clk(void)
+{
+	int optin = 0;
+	vm_offset_t gpucc, gcc, gmu;
+	uint32_t v, i;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 30) {
+		return;
+	}
+	gpucc = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!gpucc || !gcc || !gmu) {
+		printf("POLARIS G4: map failed\n");
+		return;
+	}
+	/* CX domain */
+	v = pwr_read(gpucc, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(gpucc, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(gpucc, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	printf("POLARIS G4: CX=0x%08x\n", pwr_read(gpucc, GDSC_CX));
+	/* GCC parents + axi + memnoc */
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	pwr_write(gcc, 0x71004u, pwr_read(gcc, 0x71004u) | 1u);
+	pwr_write(gcc, 0x7100cu, pwr_read(gcc, 0x7100cu) | 1u);
+	pwr_write(gcc, 0x71018u, pwr_read(gcc, 0x71018u) | 1u);
+	pwr_write(gcc, 0x44038u, pwr_read(gcc, 0x44038u) | 1u);
+	pwr_delay();
+	printf("POLARIS G4: gcc axi=0x%08x memnoc=0x%08x\n",
+	    pwr_read(gcc, 0x44038u), pwr_read(gcc, 0x7100cu));
+	/* GMU clock source: 200 MHz from GPLL0/1.5 */
+	pwr_write(gpucc, 0x1120u, 0x00000002u);
+	pwr_delay();
+	pwr_write(gpucc, 0x1124u, 0x00000601u);
+	pwr_delay();
+	pwr_write(gpucc, 0x1120u, 0x00000003u);
+	pwr_delay();
+	printf("POLARIS G4: rcg1120=0x%08x cfg=0x%08x\n",
+	    pwr_read(gpucc, 0x1120u), pwr_read(gpucc, 0x1124u));
+	/* gmu_clk and cxo_clk branches with wake/sleep nibbles */
+	{
+		static const uint32_t br[2] = { 0x1098u, 0x109cu };
+		for (i = 0; i < 2; i++) {
+			uint32_t b = pwr_read(gpucc, br[i]);
+			uint32_t w = b;
+			w |= (0xfu << 8) | (0xfu << 4);
+			w &= ~(1u << 31);
+			w |= 1u;
+			pwr_write(gpucc, br[i], w);
+			pwr_delay();
+			printf("POLARIS G4: cbcr%04x 0x%08x -> 0x%08x\n",
+			    br[i], b, pwr_read(gpucc, br[i]));
+		}
+	}
+	/* GMU register write test */
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	v = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS G4: general7=0x%08x %s\n", v,
+	    (v == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	pwr_delay();
+	printf("POLARIS G4: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
