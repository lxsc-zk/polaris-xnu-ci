 		return;
 	}
 	printf("POLARIS GPU SMMU: va=0x%llx (read-only)\n", (uint64_t)base);
-	printf("POLARIS GPU SMMU: sCR0=0x%08x\n", pwr_read(base, SMMU_sCR0));
-	printf("POLARIS GPU SMMU: IDR0=0x%08x IDR1=0x%08x\n",
