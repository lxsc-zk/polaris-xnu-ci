+			if (q[4] == 0xdbu && q[5] == 0x30u && q[6] == 0x03u && q[7] == 0x0cu) {
+				uint32_t ver = (uint32_t)q[0] | ((uint32_t)q[1] << 8) |
+				    ((uint32_t)q[2] << 16) | ((uint32_t)q[3] << 24);
+
+				printf("POLARIS DB: HIT at 0x%08x version=%u\n",
+				    0x84000000u + off, ver);
+				hits++;
+				if (hits >= 4u) {
+					break;
+				}
+			}
+		}
+		printf("POLARIS DB: scan done, %u hit(s)\n", hits);
 		return;
 	}
