diff --git a/bsd/dev/polaris_gpu_diag.c b/bsd/dev/polaris_gpu_diag.c
index 9c4fbb5..c7d749e 100644
--- a/bsd/dev/polaris_gpu_diag.c
+++ b/bsd/dev/polaris_gpu_diag.c
@@ -792,7 +792,34 @@ polaris_gpu_gmu_boot(void)
 	    optin != 50 && optin != 51 && optin != 52 && optin != 53 &&
 	    optin != 54 && optin != 55 && optin != 56 && optin != 57 &&
 	    optin != 58 && optin != 59 && optin != 60 && optin != 61 &&
-	    optin != 62 && optin != 63 && optin != 64) {
+	    optin != 62 && optin != 63 && optin != 64 && optin != 67) {
+		return;
+	}
+	if (optin == 67) {
+		vm_offset_t win = ml_io_map(0x84000000ull, 0x4000000ull);
+		uint32_t off, hits = 0u;
+
+		if (win == 0) {
+			printf("POLARIS DB: map failed\n");
+			return;
+		}
+		printf("POLARIS DB: scanning 0x84000000..0x88000000 for db 30 03 0c\n");
