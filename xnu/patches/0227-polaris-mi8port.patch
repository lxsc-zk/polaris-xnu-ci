+/* =====================================================================================
+ * optin 70: a faithful port of the dipper (MI8) a630 bring-up, steps 3 to 17.
+ * Every region, offset and value here is copied from bsd/dev/mi8_adreno.c.
+ * ===================================================================================== */
+static int
+polaris_mi8_flow(vm_offset_t fw)
+{
+	vm_offset_t cc, gc, g, pd, sq, rs, s;
+	uint8_t *hm;
+	uint32_t v, i, j, k, gi = 0u, mi = 0u, wrong = 0u;
+	uint8_t *hfimem;
+	static const struct { uint8_t reg; uint16_t w; uint32_t val; } tbl[] = {
+		{ 0, 0x0004, 1u << 24 }, { 0, 0x000b, 1 }, { 0, 0x000e, 0 }, { 0, 0x000d, 0 },
+		{ 0, 0x0010, 0 }, { 0, 0x000f, 0 }, { 0, 0x0012, 0x80000000u }, { 0, 0x0011, 0 },
+		{ 0, 0x0100, 0 }, { 0, 0x0008, 0x4520 }, { 0, 0x0009, 0x4510 }, { 0, 0x000a, 0x4514 },
+		{ 0, 0x0180, 0xa7a506a0u }, { 0, 0x0181, 0xa1e6a6e7u }, { 0, 0x0182, 0xa2e081e1u },
+		{ 0, 0x0183, 0xe9a982e2u }, { 0, 0x0184, 0x0020e8a8u },
+		{ 2, 0x0000, 0xfebea1e1u }, { 2, 0x0001, 0xa5a4a3a2u }, { 2, 0x0002, 0x8382a6e0u },
+		{ 2, 0x0003, 0xbce3e284u }, { 2, 0x0004, 0x002081fcu },
+		{ 1, 0x1573, 7 }, { 1, 0x1574, 0 }, { 1, 0x1572, 0 },
+		{ 1, 0x1575, 0x10108 }, { 1, 0x1576, 0x30010 }, { 1, 0x1577, 1 },
+		{ 1, 0x1579, 0x10108 }, { 1, 0x157a, 0x30000 }, { 1, 0x157b, 0 },
+		{ 1, 0x157d, 0x10108 }, { 1, 0x157e, 0x30080 }, { 1, 0x157f, 0 },
+		{ 1, 0x15d7, 7 }, { 1, 0x15d8, 0 }, { 1, 0x15d6, 0 },
+		{ 1, 0x15d9, 0x10108 }, { 1, 0x15da, 0x30010 }, { 1, 0x15db, 2 },
+		{ 1, 0x15dd, 0x10108 }, { 1, 0x15de, 0x30000 }, { 1, 0x15df, 3 },
+		{ 1, 0x15e1, 0x10108 }, { 1, 0x15e2, 0x30080 }, { 1, 0x15e3, 3 },
+		{ 1, 0x1148, 0 }, { 1, 0x1140, 0x80000001u },
+	};
+	static const struct { uint16_t w; uint32_t val; } boot[] = {
+		{ 0x51cc, 0x1 }, { 0x501c, 0x0 }, { 0x5001, 0x2 }, { 0x5185, 0x60009000u },
+		{ 0x5184, 0x1 }, { 0x9311, 0x802800a0u }, { 0x502d, 0x4052 }, { 0x5182, 0x06030100u },
+		{ 0x5100, 0x60005003u }, { 0x4c0f, 0x1 }, { 0x4c00, 0x1 }, { 0x4c01, 0x1 },
+		{ 0x50c0, 0x9c40400u }, { 0x50e8, 0xf11u }, { 0x5101, 0x0 },
+	};
+	v = 0;
+	gc = ml_io_map(0x00100000ull, 0x100000ull);
+	cc = ml_io_map(0x05090000ull, 0x9000ull);
+	g = ml_io_map(0x0506a000ull, 0x30000ull);
+	pd = ml_io_map(0x0b280000ull, 0x10000ull);
+	sq = ml_io_map(0x0b480000ull, 0x10000ull);
+	if (!gc || !cc || !g || !pd || !sq) {
+		printf("POLARIS M8: map failed\n");
+		return -1;
+	}
+	rs = g + 0x23000u;
+
+	/* step 3: is the GPU's register bus running? */
+	v = *(volatile uint32_t *)(gc + 0x71004u);
+	printf("POLARIS M8: gcc_gpu_cfg_ahb=0x%08x %s\n", v, (v & (1u << 31)) ? "OFF" : "on");
+	if (v & (1u << 31)) {
+		return -1;
+	}
+	printf("POLARIS M8: GX GDSCR=0x%08x CX GDSCR=0x%08x CX hwctl=0x%08x\n",
+	    *(volatile uint32_t *)(cc + 0x100cu), *(volatile uint32_t *)(cc + 0x106cu),
+	    *(volatile uint32_t *)(cc + 0x1540u));
+
+	/* step 4: CX on, judged by 0x1540 bit31 */
+	v = *(volatile uint32_t *)(cc + 0x106cu);
+	if (!(v & (1u << 31))) {
+		*(volatile uint32_t *)(cc + 0x106cu) = (v & ~(0xfu << 12)) | (8u << 12);
+		v = *(volatile uint32_t *)(cc + 0x106cu);
+		*(volatile uint32_t *)(cc + 0x106cu) = v & ~1u;
+		for (i = 0; i < 2000u; i++) {
+			if (*(volatile uint32_t *)(cc + 0x1540u) & (1u << 31)) {
+				break;
+			}
+			__asm__ __volatile__("nop");
+		}
+	}
+	printf("POLARIS M8: CX after: GDSCR=0x%08x hwctl=0x%08x %s\n",
+	    *(volatile uint32_t *)(cc + 0x106cu), *(volatile uint32_t *)(cc + 0x1540u),
+	    (*(volatile uint32_t *)(cc + 0x1540u) & (1u << 31)) ? "ON" : "OFF");
+
+	/* step 5: clocks */
+	*(volatile uint32_t *)(gc + 0x71004u) |= 1u;
+	*(volatile uint32_t *)(gc + 0x7100cu) |= 1u;
+	*(volatile uint32_t *)(gc + 0x71018u) |= 1u;
+	v = *(volatile uint32_t *)(cc + 0x1124u);
+	*(volatile uint32_t *)(cc + 0x1124u) = v & ~((7u << 8) | 0x1fu);
+	*(volatile uint32_t *)(cc + 0x1120u) |= (1u << 0) | (1u << 1);
+	for (i = 0; i < 1000u; i++) {
+		v = *(volatile uint32_t *)(cc + 0x1120u);
+		if (!(v & (1u << 0)) && !(v & (1u << 31))) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	*(volatile uint32_t *)(cc + 0x1098u) = (*(volatile uint32_t *)(cc + 0x1098u) &
+	    ~((0xfu << 8) | (0xfu << 4))) | (0xfu << 8) | (0xfu << 4);
+	*(volatile uint32_t *)(cc + 0x109cu) |= 1u;
+	*(volatile uint32_t *)(cc + 0x1098u) |= 1u;
+	printf("POLARIS M8: clocks rcg=0x%08x gmu=0x%08x cxo=0x%08x\n",
+	    *(volatile uint32_t *)(cc + 0x1120u), *(volatile uint32_t *)(cc + 0x1098u),
+	    *(volatile uint32_t *)(cc + 0x109cu));
+
+	/* step 9: TCM test, needs the processor held in reset */
+	if (*(volatile uint32_t *)(g + 0x14000u) != 1u) {
+		printf("POLARIS M8: SYSRESET != 1, not touching the TCM\n");
+		return -1;
+	}
+	{
+		static const uint32_t pat[2] = { 0xa5a5a5a5u, 0x5a5a5a5au };
+		static const uint32_t off[2] = { 0x3000u, 0x7000u };
+		uint32_t m;
+
+		for (m = 0; m < 2u; m++) {
+			uint32_t o0 = *(volatile uint32_t *)(g + off[m]);
+			uint32_t o1 = *(volatile uint32_t *)(g + off[m] + 4u);
+
+			*(volatile uint32_t *)(g + off[m]) = pat[0];
+			*(volatile uint32_t *)(g + off[m] + 4u) = pat[1];
+			__asm__ __volatile__("dsb sy" ::: "memory");
+			wrong += (*(volatile uint32_t *)(g + off[m]) != pat[0]);
+			wrong += (*(volatile uint32_t *)(g + off[m] + 4u) != pat[1]);
+			*(volatile uint32_t *)(g + off[m]) = o0;
+			*(volatile uint32_t *)(g + off[m] + 4u) = o1;
+		}
+		printf("POLARIS M8: TCM test %s (%u bad words)\n", wrong ? "DIFFERENT" : "same", wrong);
+	}
+
+	/* step 10: firmware into ITCM, read back */
+	for (i = 0; i < 8192u; i++) {
+		*(volatile uint32_t *)(g + 0x3000u + i * 4u) = *(volatile uint32_t *)(fw + i * 4u);
+	}
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	wrong = 0;
+	for (i = 0; i < 8192u; i++) {
+		if (*(volatile uint32_t *)(g + 0x3000u + i * 4u) != *(volatile uint32_t *)(fw + i * 4u)) {
+			wrong++;
+		}
+	}
+	printf("POLARIS M8: firmware 32768 bytes, %u words read back wrong\n", wrong);
+	if (wrong) {
+		return -1;
+	}
+
+	/* step 11: RSC/PDC ucode, MI8's regions and offsets */
+	for (i = 0; i < sizeof(tbl) / sizeof(tbl[0]); i++) {
+		vm_offset_t base = (tbl[i].reg == 0) ? rs : ((tbl[i].reg == 1) ? pd : sq);
+
+		*(volatile uint32_t *)(base + 4u * tbl[i].w) = tbl[i].val;
+	}
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS M8: rsc/pdc table written (%u entries); rscc status0=0x%08x pdc enable=0x%08x\n",
+	    (uint32_t)(sizeof(tbl) / sizeof(tbl[0])), *(volatile uint32_t *)(rs + 0x010u),
+	    *(volatile uint32_t *)(pd + 4u * 0x1140u));
+
+	/* step 12: the GMU's own address space, MI8's four regions */
+	hm = polaris_scratch;
+	s = ml_io_map(POLARIS_SMMU_PA, POLARIS_SMMU_LEN);
+	if (s == 0) {
+		printf("POLARIS M8: smmu map failed\n");
+		return -1;
+	}
+	for (k = 0; k < 13u * 4096u; k++) {
+		hm[k] = 0;
+	}
+	{
+		uint8_t *t = hm + 0x9000u;
+		static const uint32_t ids[3] = { 0u, 4u, 5u };
+
+		*(volatile uint32_t *)(t + 0x00u) = 0u;
+		*(volatile uint32_t *)(t + 0x04u) = 168u;
+		*(volatile uint32_t *)(t + 0x08u) = 6u;
+		*(volatile uint32_t *)(t + 0x0cu) = 12u;
+		*(volatile uint32_t *)(t + 0x10u) = 3u;
+		*(volatile uint32_t *)(t + 0x14u) = 3u;
+		for (i = 0; i < 3u; i++) {
+			uint32_t h = 0x18u + i * 48u;
+
+			*(volatile uint32_t *)(t + h + 0x00u) = 1u;
+			*(volatile uint32_t *)(t + h + 0x04u) = 0x60009000u + 0x1000u * (i + 1u);
+			*(volatile uint32_t *)(t + h + 0x08u) = (10u << 8) | ids[i];
+			*(volatile uint32_t *)(t + h + 0x0cu) = 1024u;
+			*(volatile uint32_t *)(t + h + 0x18u) = 1u;
+			*(volatile uint32_t *)(t + h + 0x1cu) = 1u;
+			*(volatile uint32_t *)(t + h + 0x20u) = 1u;
+		}
+	}
+	for (k = 0; k < 13u; k++) {
+		polaris_pt_map(0x60000000ull + (uint64_t)k * 0x1000ull,
+		    kvtophys((vm_offset_t)(hm + k * 4096u)));
+	}
+	polaris_pt_clean((vm_offset_t)hm, 13u * 4096u);
+	polaris_tcr_ps = 1u;
+	(void)polaris_smmu_space_on(s, 1u, 1u, 5u);
+	*(volatile uint32_t *)(s + POLARIS_S2CR(2)) = 1u;
+	*(volatile uint32_t *)(s + POLARIS_SMR(2)) = 0x80000004u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+
+	/* step 14: the 15 boot registers, in MI8's order */
+	for (i = 0; i < sizeof(boot) / sizeof(boot[0]); i++) {
+		if (boot[i].w == 0x50e8u) {
+			*(volatile uint32_t *)(g + 4u * boot[i].w) |= boot[i].val;
+		} else {
+			*(volatile uint32_t *)(g + 4u * boot[i].w) = boot[i].val;
+		}
+	}
+	*(volatile uint32_t *)(g + 0x14008u) = 0u;	/* WFI_CONFIG */
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS M8: boot regs: qtbl=0x%08x info=0x%08x sfr=0x%08x fence=0x%08x cpmsg=0x%08x\n",
+	    *(volatile uint32_t *)(g + 0x14614u), *(volatile uint32_t *)(g + 0x14610u),
+	    *(volatile uint32_t *)(g + 0x14608u), *(volatile uint32_t *)(g + 0x24c44u),
+	    *(volatile uint32_t *)(g + 0x14400u));
+
+	/* step 15: release the reset */
+	*(volatile uint32_t *)(g + 0x14000u) = 1u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(g + 0x14000u) = 0u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	v = 0;
+	for (i = 0; i < 300000u; i++) {
+		v = *(volatile uint32_t *)(g + 0x14070u);
+		if (v == 0xbabefaceu) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	printf("POLARIS M8: FW_INIT_RESULT=0x%08x polls=%u %s\n", v, i,
+	    (v == 0xbabefaceu) ? "GMU-BOOTED" : "FAIL");
+	if (v != 0xbabefaceu) {
+		return -1;
+	}
+
+	/* step 16: the rail, indices from the command database */
+	{
+		vm_offset_t dict = ml_io_map(0x0c3f000cu, 8);
+		uint32_t pa = 0u, sz = 0u, gcn = 0u, mcn = 0u;
+		const uint16_t *l1 = NULL, *l2 = NULL;
+
+		if (dict) {
+			pa = *(volatile uint32_t *)dict;
+			sz = *(volatile uint32_t *)(dict + 4u);
+		}
+		if (pa && sz) {
+			vm_offset_t db = ml_io_map(pa, sz);
+
+			if (db) {
+				l1 = polaris_cmd_levels(db, "gfx.lvl", &gcn);
+				l2 = polaris_cmd_levels(db, "mx.lvl", &mcn);
+			}
+			printf("POLARIS M8: cmd_db at 0x%08x size 0x%x: gfx=%u mx=%u\n",
+			    pa, sz, gcn, mcn);
+		} else {
+			printf("POLARIS M8: no cmd_db descriptor at 0x0c3f000c (0x%08x 0x%x)\n", pa, sz);
+		}
+		if (l1) {
+			for (j = 0; j < gcn && j < 12u; j++) {
+				printf("POLARIS M8: gfx.lvl[%u]=%u\n", j, l1[j]);
+				if (l1[j] >= 64u && gi == 0u) {
+					gi = j;
+				}
+			}
+		}
+		if (l2) {
+			for (j = 0; j < mcn && j < 12u; j++) {
+				printf("POLARIS M8: mx.lvl[%u]=%u\n", j, l2[j]);
+				if (l2[j] >= 64u && mi == 0u) {
+					mi = j;
+				}
+			}
+		}
+	}
+	printf("POLARIS M8: rail idx gx=%u mx=%u\n", gi, mi);
+	*(volatile uint32_t *)(g + 0x8fe0u) = 0u;
+	*(volatile uint32_t *)(g + 0x8fe4u) = gi;
+	*(volatile uint32_t *)(g + 0x8fe8u) = mi;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	(void)polaris_oob(g, 22u, 30u);
+	*(volatile uint32_t *)(g + 0x204u) = 0x778000u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	for (i = 0; i < 200000u; i++) {
+		if ((*(volatile uint32_t *)(g + 0x14340u) & 0x38u) == 0x28u) {
+			break;
+		}
+	}
+	printf("POLARIS M8: after rail GX=0x%08x powerstate=0x%08x sptprac=0x%08x\n",
+	    *(volatile uint32_t *)(cc + 0x100cu), *(volatile uint32_t *)(g + 0x143b0u),
+	    *(volatile uint32_t *)(g + 0x14340u));
+
+	/* step 17: HFI */
+	*(volatile uint32_t *)(g + 0x14618u) = 1u;
+	v = 0;
+	for (i = 0; i < 500u; i++) {
+		v = *(volatile uint32_t *)(g + 0x14600u);
+		if (v & 1u) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	printf("POLARIS M8: HFI_CTRL_STATUS=0x%08x %s\n", v, (v & 1u) ? "started" : "NOT started");
+	if (!(v & 1u)) {
+		return -1;
+	}
+	{
+		uint8_t *t = hm + 0x9000u;
+		static uint32_t m[160];
+		static const uint32_t gk[8] = { 0u, 257000u, 342000u, 414000u, 520000u, 596000u, 675000u, 710000u };
+
+		for (k = 0; k < 160u; k++) { m[k] = 0u; }
+		m[1] = 0u; m[2] = 0x60001000u; m[3] = 0x4000u; m[4] = 1u;
+		(void)polaris_hfi_xfer(g, t, hm, 0u, m, 5u, NULL);
+		for (k = 0; k < 160u; k++) { m[k] = 0u; }
+		m[1] = (1u << 28) | (1u << 19) | (1u << 17);
+		(void)polaris_hfi_xfer(g, t, hm, 1u, m, 2u, NULL);
+		for (k = 0; k < 160u; k++) { m[k] = 0u; }
+		m[1] = 8u; m[2] = 3u;
+		for (i = 0; i < 8u; i++) {
+			m[3u + 2u * i] = (gk[i] ? 64u : 0u) << 16 | (i << 8) | i;
+			m[4u + 2u * i] = gk[i];
+		}
+		(void)polaris_hfi_xfer(g, t, hm, 4u, m, 43u, NULL);
+		for (k = 0; k < 160u; k++) { m[k] = 0u; }
+		m[1] = 1u; m[2] = 3u; m[3] = 3u; m[4] = 5u; m[5] = 7u;
+		m[6] = 0x50034u; m[7] = 0x5007cu; m[8] = 0x5004cu;
+		m[12] = 0x40000000u; m[14] = 0x40000000u;
+		m[18] = 0x60000001u; m[19] = 0x20000001u; m[20] = 0x60000001u;
+		m[24] = 0x50000u; m[25] = 0x5005cu; m[26] = 0x5000cu;
+		m[32] = 0x40000000u; m[33] = 0x40000000u; m[34] = 0x40000000u;
+		(void)polaris_hfi_xfer(g, t, hm, 3u, m, 160u, NULL);
+		for (k = 0; k < 160u; k++) { m[k] = 0u; }
+		(void)polaris_hfi_xfer(g, t, hm, 5u, m, 1u, NULL);
+	}
+	(void)polaris_oob(g, 16u, 24u);
+	*(volatile uint32_t *)(g + 0x14644u) = (1u << 24) | (1u << 30);
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS M8: after GPU_SET GX=0x%08x powerstate=0x%08x info=0x%08x\n",
+	    *(volatile uint32_t *)(cc + 0x100cu), *(volatile uint32_t *)(g + 0x143b0u),
+	    *(volatile uint32_t *)(g + 0x14648u));
+	return 0;
+}
+
 void
 polaris_gpu_gmu_boot(void)
 {
@@ -856,7 +1189,8 @@ polaris_gpu_gmu_boot(void)
 	    optin != 50 && optin != 51 && optin != 52 && optin != 53 &&
 	    optin != 54 && optin != 55 && optin != 56 && optin != 57 &&
 	    optin != 58 && optin != 59 && optin != 60 && optin != 61 &&
-	    optin != 62 && optin != 63 && optin != 64 && optin != 67) {
+	    optin != 62 && optin != 63 && optin != 64 && optin != 67 &&
+	    optin != 70) {
 		return;
 	}
 	if (optin == 67) {
@@ -893,6 +1227,12 @@ polaris_gpu_gmu_boot(void)
 		    (unsigned long long)blob_size);
 		return;
 	}
+	src = ml_io_map((vm_offset_t)blob, (vm_size_t)blob_size);
+	if (optin == 70) {
+		printf("POLARIS M8: port of the dipper flow\n");
+		(void)polaris_mi8_flow(src);
+		return;
+	}
 	printf("POLARIS BOOT: blob=0x%llx size=%llu\n",
 	    (unsigned long long)blob, (unsigned long long)blob_size);
 
