-					uint32_t b = pwr_read(gcc, g[i]);
-					pwr_write(gcc, g[i], b | 1u);
-					pwr_delay();
-					printf("POLARIS GPU SMMU: gcc 0x%05x 0x%08x -> 0x%08x\n",
-					    g[i], b, pwr_read(gcc, g[i]));
-				}
-			}
-		}
+	/* Ask the secure world to program each context bank's aperture. */
+	for (i = 0; i < 5; i++) {
+		uint64_t res = 0;
+		int rc = polaris_scm_mp(0xFFFF0000ull | (0ull << 8) | i,
+		    0xFFFFFFFFull, 0xFFFFFFFFull, 0xFFFFFFFFull, &res);
+		printf("POLARIS GPU SMMU: scm aperture cb=%u rc=%d res=0x%llx\n",
+		    i, rc, (unsigned long long)res);
 	}
 
 	printf("POLARIS GPU SMMU: retry CB0 TTBR0 write\n");
