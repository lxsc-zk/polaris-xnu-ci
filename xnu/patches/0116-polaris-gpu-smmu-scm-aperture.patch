@@ -385,6 +385,34 @@ polaris_gpu_smmu_probe(void)
 #define GCC_PA   0x100000ull
 #define GCC_LEN  0x100000ull
 
+
+/*
+ * Vendor kgsl programs each SMMU context bank's aperture through the secure
+ * world: scm_call2(SCM_SIP_FNID(SCM_SVC_MP, 0x1B), desc) with
+ *   args[0] = 0xFFFF0000 | (aperture_reg << 8) | cb, args[1..3] = ~0
+ * Replicate that call from XNU, then write the CB register again.
+ */
+static int
+polaris_scm_mp(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t *res)
+{
+	register uint64_t x0 __asm__("x0") = 0x42000C1Bull;
+	register uint64_t x1 __asm__("x1") = 4ull;
+	register uint64_t x2 __asm__("x2") = a0;
+	register uint64_t x3 __asm__("x3") = a1;
+	register uint64_t x4 __asm__("x4") = a2;
+	register uint64_t x5 __asm__("x5") = a3;
+
+	__asm__ __volatile__(
+	    "smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5)
+	    :
+	    : "memory");
+	if (res) {
+		*res = x0;
+	}
+	return (int)x0;
+}
+
 void
 polaris_gpu_smmu_clocks(void)
 {
@@ -431,33 +459,13 @@ polaris_gpu_smmu_clocks(void)
