Subject: [PATCH] polaris: put SID 5 back in slot 0, aimed at context bank 1

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -2662,16 +2662,27 @@
 	for (int i = 0; i < 100000 && (rd(smmu.base + to + SMMU_CB_TLBSTATUS) & 1); i++) {
 	}
 	wr(smmu.base + to + SMMU_CB_SCTLR, control | 1u);
-	/* the streams: 5 -> slot 1, 4 -> slot 2, both to context bank 1 */
+	/*
+	 * polaris: the streams. Slot 1 refused the SMR write in 0319 (it read back 0), so put
+	 * SID 5 in slot 0 -- cleared first -- and SID 4 in slot 2, both aimed at context bank 1.
+	 * S2CR goes first in each case: once an SMR is valid the entry latches and a later
+	 * S2CR write is dropped (the bring-up notes this).
+	 */
+	wr(smmu.base + SMMU_SMR(0), 0);
+	wr(smmu.base + SMMU_SMR(1), 0);
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	wr(smmu.base + SMMU_S2CR(0), 1);
+	wr(smmu.base + SMMU_SMR(0), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 5u);
 	wr(smmu.base + SMMU_S2CR(1), 1);
-	wr(smmu.base + SMMU_SMR(1), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 5u);
+	wr(smmu.base + SMMU_SMR(1), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 4u);
 	wr(smmu.base + SMMU_S2CR(2), 1);
-	wr(smmu.base + SMMU_SMR(2), 0x80000004u);
-	wr(smmu.base + SMMU_SMR(0), 0);                         /* drop the context-2 entry for SID 5 */
+	wr(smmu.base + SMMU_SMR(2), SMMU_SMR_VALID | SMMU_STREAM_MASK << 16 | 4u);
 	__asm__ __volatile__("dsb sy" ::: "memory");
-	printf("adreno: %u: polaris: CB1 mirrors CB2 (root %#llx, asid 1); slots: 1=0x%x/0x%x 2=0x%x/0x%x 0=0x%x\n", step,
-	    (unsigned long long)root, rd(smmu.base + SMMU_S2CR(1)), rd(smmu.base + SMMU_SMR(1)),
-	    rd(smmu.base + SMMU_S2CR(2)), rd(smmu.base + SMMU_SMR(2)), rd(smmu.base + SMMU_SMR(0)));
+	printf("adreno: %u: polaris: CB1 mirrors CB2 (root %#llx, asid 1); slots: 0=0x%x/0x%x 1=0x%x/0x%x 2=0x%x/0x%x\n",
+	    step, (unsigned long long)root,
+	    rd(smmu.base + SMMU_S2CR(0)), rd(smmu.base + SMMU_SMR(0)),
+	    rd(smmu.base + SMMU_S2CR(1)), rd(smmu.base + SMMU_SMR(1)),
+	    rd(smmu.base + SMMU_S2CR(2)), rd(smmu.base + SMMU_SMR(2)));
 }
 
