+/* a6xx_gmu_set_oob: raise bit `set` of HOST2GMU_INTR_SET and wait for `ack`
+ * in GMU2HOST_INTR_INFO; the ack bit is cleared again afterwards. */
+static int
+polaris_oob(vm_offset_t gpu, uint32_t set, uint32_t ack)
+{
+	uint32_t info = 0u, k;
+
+	*(volatile uint32_t *)(gpu + 0x14650u) = 1u << set;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	for (k = 0; k < 2000000u; k++) {
+		info = *(volatile uint32_t *)(gpu + 0x14648u);
+		if (info & (1u << ack)) {
+			break;
+		}
+	}
+	*(volatile uint32_t *)(gpu + 0x14644u) = 1u << ack;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS GX: oob set %u ack %u -> info=0x%08x %s\n",
+	    set, ack, info, (info & (1u << ack)) ? "ACKED" : "TIMEOUT");
+	return (info & (1u << ack)) ? 0 : -1;
+}
