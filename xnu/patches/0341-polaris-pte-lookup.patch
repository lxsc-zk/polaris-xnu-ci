+/* What the GPU would find at this address: the PTE the page tables hold, or 0. */
+uint64_t
+sweet_gpu_vm_lookup(uint64_t iova)
+{
+	volatile uint64_t *l3;
+
+	if (!gpu_live || !gpu_va_to_local(iova, 0x1000, NULL)) {
+		return 0;
+	}
+	l3 = gpu_l3_for(iova);
+	if (l3 == NULL) {
+		return 0;
+	}
+	return l3[(iova >> 12) & 0x1ff];
+}
