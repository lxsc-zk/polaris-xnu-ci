 		*(volatile uint32_t *)(gpu + 0x14610u) = 1u;
 		__asm__ __volatile__("dsb sy" ::: "memory");
@@ -1313,6 +1327,31 @@ polaris_gpu_gmu_boot(void)
 			printf("POLARIS BOOT: hfi_ctrl=0x%08x polls=%u info=0x%08x\n",
 			    *(volatile uint32_t *)(gpu + 0x14600u), i,
 			    *(volatile uint32_t *)(gpu + 0x14648u));
+			if (optin == 46) {
+				vm_offset_t s6 = ml_io_map(POLARIS_SMMU_PA, POLARIS_SMMU_LEN);
+
+				if (s6) {
+					printf("POLARIS FAULT: gfsr=0x%08x synr0=0x%08x synr1=0x%08x\n",
+					    *(volatile uint32_t *)(s6 + 0x048u),
+					    *(volatile uint32_t *)(s6 + 0x04cu),
+					    *(volatile uint32_t *)(s6 + 0x050u));
+					printf("POLARIS FAULT: cb1 fsr=0x%08x far=0x%08x/%08x synr=0x%08x\n",
+					    *(volatile uint32_t *)(s6 + 0x9000u + 0x58u),
+					    *(volatile uint32_t *)(s6 + 0x9000u + 0x64u),
+					    *(volatile uint32_t *)(s6 + 0x9000u + 0x60u),
+					    *(volatile uint32_t *)(s6 + 0x9000u + 0x68u));
+					printf("POLARIS FAULT: smr0..3=0x%08x 0x%08x 0x%08x 0x%08x\n",
+					    *(volatile uint32_t *)(s6 + 0x800u),
+					    *(volatile uint32_t *)(s6 + 0x804u),
+					    *(volatile uint32_t *)(s6 + 0x808u),
+					    *(volatile uint32_t *)(s6 + 0x80cu));
+					printf("POLARIS FAULT: s2cr0..3=0x%08x 0x%08x 0x%08x 0x%08x\n",
+					    *(volatile uint32_t *)(s6 + 0xc00u),
+					    *(volatile uint32_t *)(s6 + 0xc04u),
+					    *(volatile uint32_t *)(s6 + 0xc08u),
+					    *(volatile uint32_t *)(s6 + 0xc0cu));
+				}
+			}
 		}
