@@ -567,6 +567,10 @@ bsd_init(void)
 		extern void polaris_gpu_gmu_rsc(void);
 		polaris_gpu_gmu_rsc();
 	}
+	{
+		extern void polaris_gpu_gx_clocks(void);
+		polaris_gpu_gx_clocks();
+	}
 	{
 		extern void polaris_gpu_gmu_window(void);
 		polaris_gpu_gmu_window();
