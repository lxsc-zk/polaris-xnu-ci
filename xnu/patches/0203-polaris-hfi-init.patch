+		*(volatile uint32_t *)(b + 0x08u) = 6u;
+		*(volatile uint32_t *)(b + 0x0cu) = 12u;
+		*(volatile uint32_t *)(b + 0x10u) = 3u;
+		*(volatile uint32_t *)(b + 0x14u) = 3u;
+		for (i = 0; i < 3u; i++) {
+			uint32_t h = 0x18u + i * 48u;
+			*(volatile uint32_t *)(b + h + 0x00u) = 0x60000000u + 168u + i * 4112u;
+			*(volatile uint32_t *)(b + h + 0x04u) = i | (((i == 2u) ? 40u : 10u) << 8);
+			*(volatile uint32_t *)(b + h + 0x08u) = 1u;
