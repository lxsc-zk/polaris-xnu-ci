--- a/bsd/dev/hakios.adreno.c	2026-11-01 16:07:52.332463217 +0800
+++ b/bsd/dev/hakios.adreno.c	2026-11-01 16:07:52.352491310 +0800
@@ -917,9 +917,9 @@
 #define GMU_WORD(n)             (4u * (n))
 #define GMU_DTCM                GMU_WORD(0x1c00)        /* the processor's 16K of data memory (its code: 0x0c00) */
 #define GMU_DTCM_VERSIONS       GMU_WORD(0x1c00 + 0xff8) /* five words where loaded firmware carries its versions */
-#define GMU_CM3_SYSRESET        0x1f800u        /* 1: the processor is held in reset */
-#define GMU_CM3_BOOT_CONFIG     0x1f801u
-#define GMU_CM3_FW_INIT_RESULT  0x1f81cu        /* 0xbabeface once firmware has started */
+#define GMU_CM3_SYSRESET        GMU_WORD(0x5000)   /* 0x14000: proven by this port own GMU bring-up */        /* 1: the processor is held in reset */
+#define GMU_CM3_BOOT_CONFIG     GMU_WORD(0x5001)   /* 0x14004 */
+#define GMU_CM3_FW_INIT_RESULT  GMU_WORD(0x501c)   /* 0x14070: where 0xbabeface appears */        /* 0xbabeface once firmware has started */
 #define GMU_CM3_CFG             GMU_WORD(0x502d)
 #define GMU_ALWAYS_ON_COUNTER_L GMU_WORD(0x5088)        /* counts the 19.2 MHz crystal */
 #define GMU_ALWAYS_ON_COUNTER_H GMU_WORD(0x5089)
@@ -959,14 +959,7 @@
 	announce("read registers of the GMU (0x3d6a000): the first words from the GPU block itself");
 	get(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET);
