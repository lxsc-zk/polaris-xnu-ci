--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -1098,5 +1098,19 @@
 
 #define NEED(T) do { if (in < sizeof(T)) { return kIOReturnBadArgument; } } while (0)
-	/* Which selector the client asked for, before anything can panic on it. */
-	IOLog("SWEET ADRENO: selector %#x in %u bytes\n", selector, (unsigned)in);
+	/*
+	 * Per-ioctl logging sits on the hot path: the compositor issues thousands of GEM_INFO
+	 * and BO_SYNC calls per frame, and formatting plus console output for each costs more
+	 * than the ioctl itself. Off unless boot-arg sweetadreno_log=1 asks for it.
+	 */
+	{
+		static int selog = -1;
+
+		if (selog < 0) {
+			selog = 0;
+			PE_parse_boot_argn("sweetadreno_log", &selog, sizeof(selog));
+		}
+		if (selog != 0) {
+			IOLog("SWEET ADRENO: selector %#x in %u bytes\n", selector, (unsigned)in);
+		}
+	}
 
