Subject: [PATCH] polaris: vote the GPU rail through the RSC's TCS, as the bring-up does

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -1994,6 +1994,7 @@
 
 /* the always-on sequencer's side of the GMU's RPMh channel (defined with step 16's macros) */
 static void gmu_pdc_rsc_setup(void);
+static bool gmu_rail_vote(void);
 
 #define GMU_ICACHE_CONFIG       GMU_WORD(0x4c00)
 #define GMU_DCACHE_CONFIG       GMU_WORD(0x4c01)
@@ -2118,6 +2119,11 @@
 	} else {
 		gmu_pdc_rsc_setup();
 	}
+	/*
+	 * polaris: and the rail's own vote, through the path this board was tested with --
+	 * the RSCC table above cannot serve the firmware's RPMh requests on its own.
+	 */
+	gmu_rail_vote();
 	put(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT, 0);
 	put(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG, 2);
 	put(&gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, 0x60009000u);
@@ -2292,6 +2298,136 @@
  * left to step 16 -- i.e. after the boot that never happens -- every RSSС slot reads
  * back empty and the CM3 never executes. Idempotent: step 16 asks for it again.
  */
+/*
+ * polaris: the GPU rail's own vote path -- ported from this port's bring-up
+ * (polaris_gpu_power.c: polaris_gpu_vrm(), the `polarisgpu=28` test whose console output is
+ * on record: "voting 416 mV mode=7 enable=1", "vote status=0x00010101 polls=3 OK").
+ *
+ * The rail is the RPMh resource "vrm.gfx" (0x42700), voted through the RSC's TCS command
+ * slots at 0x179e0d00, not through the RSCC sequence memory the a660 code writes. The
+ * voltage levels come from the bootloader's command database ("gfx.lvl", aux offset 0xa0),
+ * which is also where this driver's step 1 reads them from.
+ */
+#define POLARIS_TCS_PA          0x179e0d00ull
+#define POLARIS_TCS_LEN         0x3000u
+#define POLARIS_DICT_PA         0x0c3f000cull
+
+static bool
+gmu_rail_vote(void)
+{
+	vm_offset_t dict, db, tcs;
+	uint32_t pa, size, i, j, h, cnt, ent, addr = 0, aux_base, aux_off, aux_len;
+	uint32_t mv = 0, v;
+	unsigned found = 0;
+	char name[9];
+
+	dict = ml_io_map(POLARIS_DICT_PA, 8);
+	tcs = ml_io_map(POLARIS_TCS_PA, POLARIS_TCS_LEN);
+	if (dict == 0 || tcs == 0) {
+		printf("adreno: %u: polaris: the vote dictionary or the RSC's TCS does not map\n", step);
+		return false;
+	}
+	pa = rd(dict);
+	size = rd(dict + 4);
+	db = ml_io_map(pa, size);
+	if (db == 0) {
+		printf("adreno: %u: polaris: the command database at %#x (%u bytes) does not map\n", step, pa, size);
+		return false;
+	}
+	for (i = 0; i < 8 && !found; i++) {
+		h = 8u + 16u * i;
+		v = rd(db + h + 4u);
+		cnt = (v >> 16) & 0xffffu;
+		if (cnt == 0 || cnt > 200) {
+			continue;
+		}
+		ent = 0x90u + ((rd(db + h) >> 16) & 0xffffu);
+		aux_base = 0x90u + (v & 0xffffu);
+		for (j = 0; j < cnt; j++) {
+			uint32_t e = ent + 24u * j;
+			uint32_t w0 = rd(db + e), w1 = rd(db + e + 4u), w2 = rd(db + e + 16u);
+
+			for (int c = 0; c < 8; c++) {
+				name[c] = (char)((c < 4 ? w0 : w1) >> (8 * (c & 3)));
+			}
+			name[8] = 0;
+			if (memcmp(name, "gfx.lvl", 7) == 0) {
+				uint32_t al = rd(db + e + 20u) & 0xffffu;
+				uint32_t ao = (rd(db + e + 20u) >> 16) & 0xffffu;
+				uint32_t n = al / 2u;
+
+				if (n > 20u) {
+					n = 20u;
+				}
+				aux_len = al;
+				aux_off = ao;
+				for (uint32_t k = 0; k < n; k++) {
+					uint32_t off = aux_base + ao + 2u * k;
+					uint32_t w = rd(db + (off & ~3u));
+					uint32_t val = (off & 2u) ? (w >> 16) : (w & 0xffffu);
+
+					if (val > mv) {
+						mv = val;
+					}
+				}
+				continue;
+			}
+			if (memcmp(name, "vrm.gfx", 7) == 0) {
+				addr = w2;
+				found = 1;
+				break;
+			}
+		}
+	}
+	(void)aux_base;
+	(void)aux_off;
+	(void)aux_len;
+	if (!found || addr == 0) {
+		printf("adreno: %u: polaris: vrm.gfx is not in the command database; not voting\n", step);
+		return false;
+	}
+	for (i = 0; i < 3; i++) {
+		static const uint32_t offs[3] = { 0, 8, 4 };
+		uint32_t vals[3] = { mv, 7, 1 };
+		uint32_t cst = 0, k;
+		int ok = 0;
+
+		for (k = 0; k < 3; k++) {
+			wr(tcs + k * 0x14u + 0x30u, 8u | (1u << 8) | (1u << 16));
+			wr(tcs + k * 0x14u + 0x34u, addr + offs[k]);
+			wr(tcs + k * 0x14u + 0x38u, vals[k]);
+		}
+		wr(tcs + 0x10u, 7u);
+		wr(tcs + 0x1cu, 7u);
+		wr(tcs + 0x14u, 0u);
+		wr(tcs + 0x14u, 1u << 16);
+		sleep_us(10);
+		wr(tcs + 0x14u, (1u << 16) | (1u << 24));
+		for (k = 0; k < 20000; k++) {
+			uint32_t complete = 1;
+
+			for (uint32_t c = 0; c < 3; c++) {
+				cst = rd(tcs + c * 0x14u + 0x3cu);
+				if ((cst & 0x00010100u) != 0x00010100u) {
+					complete = 0;
+				}
+			}
+			if (complete) {
+				ok = 1;
+				break;
+			}
+			sleep_us(10);
+		}
+		printf("adreno: %u: polaris: voted %u mV on vrm.gfx (%#x), status=%#x polls=%u %s\n",
+		    step, mv, addr, cst, k, ok ? "OK" : "TIMEOUT");
+		if (!ok) {
+			return false;
+		}
+		break;
+	}
+	return true;
+}
+
 static void
 gmu_pdc_rsc_setup(void)
 {
