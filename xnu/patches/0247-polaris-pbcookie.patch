+/* ---- create /private/preboot/<boot-manifest-hash>/ (the cookie launchd insists on) ---- */
+#include <kern/thread.h>
+#include <IOKit/IOLib.h>
+
+static int
+polaris_mkdir_in(const char *dirpath, const char *name, vfs_context_t ctx)
+{
+	vnode_t dvp = NULLVP, vp = NULLVP;
+	struct vnode_attr va;
+	int error;
+
+	error = vnode_lookup(dirpath, 0, &dvp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	va.va_mode = 0755;
+	va.va_uid = 0;
+	va.va_gid = 0;
+	error = VNOP_MKDIR(dvp, name, &va, &vp, ctx);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return error;
+}
+
+static void
+polaris_preboot_doit(void)
+{
+	char uuid[200];
+	char path[512];
+	const void *prop = NULL;
+	vfs_context_t ctx;
+	vnode_t vp = NULLVP;
+	uint32_t len = 0;
+	int i, r;
+	const uint8_t *hash;
+
+	if (!SecureDTLookupEntry(NULL, "/chosen", &vp)) {
+		printf("POLARIS PREBOOT: no /chosen node\n");
+		return;
+	}
+	if (!SecureDTGetProperty(vp, "boot-manifest-hash", &prop, &len) || prop == NULL) {
+		printf("POLARIS PREBOOT: no boot-manifest-hash\n");
+		return;
+	}
+	if (len == 0 || len > 64) {
+		printf("POLARIS PREBOOT: odd hash length %u\n", len);
+		return;
+	}
+	hash = (const uint8_t *)prop;
+	for (i = 0; i < (int)len; i++) {
+		static const char hexdig[] = "0123456789ABCDEF";
+
+		uuid[i * 2] = hexdig[(hash[i] >> 4) & 0xf];
+		uuid[i * 2 + 1] = hexdig[hash[i] & 0xf];
+	}
+	uuid[len * 2] = 0;
+	printf("POLARIS PREBOOT: cookie dir '%s'\n", uuid);
+	ctx = vfs_context_create(NULL);
+	if (ctx == NULL) {
+		return;
+	}
+	r = polaris_mkdir_in("/private/preboot", uuid, ctx);
+	printf("POLARIS PREBOOT: mkdir preboot/UUID -> %d\n", r);
+	if (r == 0 || r == EEXIST) {
+		snprintf(path, sizeof(path), "/private/preboot/%s", uuid);
+		printf("POLARIS PREBOOT: mkdir usr -> %d\n", polaris_mkdir_in(path, "usr", ctx));
+		printf("POLARIS PREBOOT: mkdir boot -> %d\n", polaris_mkdir_in(path, "boot", ctx));
+		snprintf(path, sizeof(path), "/private/preboot/%s/usr", uuid);
+		printf("POLARIS PREBOOT: mkdir standalone -> %d\n",
+		    polaris_mkdir_in(path, "standalone", ctx));
+		snprintf(path, sizeof(path), "/private/preboot/%s/usr/standalone", uuid);
+		printf("POLARIS PREBOOT: mkdir firmware -> %d\n",
+		    polaris_mkdir_in(path, "firmware", ctx));
+		snprintf(path, sizeof(path), "/private/preboot/%s/.roots-installed", uuid);
+		{
+			int fd = 0;
+
+			r = vn_open(path, UIO_SYSSPACE, O_CREAT | O_RDWR, 0644, &fd, 0, ctx);
+			if (r == 0) {
+				file_drop(fd);
+			}
+			printf("POLARIS PREBOOT: create .roots-installed -> %d\n", r);
+		}
+	}
+	vfs_context_rele(ctx);
+	printf("POLARIS PREBOOT: done\n");
+}
+
+static void
+polaris_preboot_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	IOSleep(20000);
+	polaris_preboot_doit();
+	(void)thread_terminate(current_thread());
+}
+
+static void
+polaris_preboot_start(void)
+{
+	thread_t th = NULL;
+
+	if (kernel_thread_start(polaris_preboot_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("POLARIS PREBOOT: could not start the thread\n");
+		return;
+	}
+	thread_deallocate(th);
+	printf("POLARIS PREBOOT: thread started, it waits 20 s for the root, then creates the cookie\n");
+}
