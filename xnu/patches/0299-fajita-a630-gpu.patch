+/* "0x<pa>:0x<size>", the form tools/mkpayload.py --blob announces */
+static bool
+gpu_parse_range(const char *s, uint64_t *pa, uint64_t *size)
+{
+	uint64_t v[2] = { 0, 0 };
+	int n = 0;
+
+	for (; *s != '\0' && n < 2; s++) {
+		if (*s == '0' && (s[1] == 'x' || s[1] == 'X')) {
+			s += 2;        /* both the '0' and the 'x' */
+			v[n] = 0;
+			while ((*s >= '0' && *s <= '9') || (*s >= 'a' && *s <= 'f') ||
+			    (*s >= 'A' && *s <= 'F')) {
+				uint32_t d = *s <= '9' ? (uint32_t)(*s - '0') :
+				    (uint32_t)((*s | 0x20) - 'a' + 10);
+				v[n] = (v[n] << 4) | d;
+				s++;
+			}
+			n++;
+			s--;
+		} else if (*s == ':') {
+			continue;
+		} else {
+			return false;
+		}
+	}
+	if (n != 2) {
+		return false;
+	}
+	*pa = v[0];
+	*size = v[1];
+	return true;
+}
+
+/* A read that does not announce itself: for groups that are flushed once. */
+static void
+gpu_wr_quiet(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+static uint32_t
+gpu_rd_quiet(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint32_t
+gpu_probe_rd(const char *what, vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+
+	if (base == 0) {
+		printf("SWEET GPU: %s +%#x: no mapping\n", what, off);
+		return 0;
+	}
+	printf("SWEET GPU: read %s +%#x\n", what, off);
+	/*
+	 * No flush here: it is a polled UFS write and this runs before the UFS
+	 * driver exists. console47 panicked inside one of them, and the panic flush
+	 * then waited for the same lock, so the disk kept an older ring. The probe
+	 * flushes twice instead, around the reset.
+	 */
+	v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	printf("SWEET GPU: %s +%#x = %#x\n", what, off, v);
+	return v;
+}
