+/* ------------------------------------------------------------------ */
+
+bool
+SweetAdrenoUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	if (!sweet_gpu_ready() || gAdrenoLock == NULL) {
+		return false;
+	}
+	fTask = owningTask;
+	fGems = (struct sweet_gem *)IOMallocZeroData(sizeof(struct sweet_gem) * GEM_MAX);
+	return fGems != NULL;
+}
+
+void
+SweetAdrenoUserClient::free()
+{
+	if (fGems != NULL) {
+		IOFreeData(fGems, sizeof(struct sweet_gem) * GEM_MAX);
+		fGems = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetAdrenoUserClient::clientClose(void)
+{
+	IOLockLock(gAdrenoLock);
+	if (!fClosed) {
+		fClosed = true;
+		if (fGems != NULL) {
+			for (uint32_t i = 0; i < GEM_MAX; i++) {
+				if (fGems[i].md != NULL) {
+					releaseGem(&fGems[i]);
+				}
+			}
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Lock held. */
+struct sweet_gem *
+SweetAdrenoUserClient::gem(uint32_t handle)
+{
+	if (fGems == NULL || handle == 0 || handle > GEM_MAX || fGems[handle - 1].md == NULL) {
+		return NULL;
+	}
+	return &fGems[handle - 1];
+}
+
+/* Copy from the caller's address space. */
+IOReturn
+SweetAdrenoUserClient::copyIn(uint64_t addr, void *dst, size_t len)
+{
+	if (len == 0) {
+		return kIOReturnSuccess;
+	}
+	if (addr == 0) {
+		return kIOReturnBadArgument;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)addr, len, kIODirectionOut, fTask);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOReturn ret = md->prepare();
+	if (ret == kIOReturnSuccess) {
+		ret = md->readBytes(0, dst, len) == len ? kIOReturnSuccess : kIOReturnVMError;
+		md->complete();
+	}
+	md->release();
+	return ret;
+}
+
+/*
+ * Wait for sequence number `fence` (lock held, dropped while waiting). ns == 0 polls once.
+ * A wait that runs into WAIT_PATIENCE_MS (or its own limit when that is longer than 1 s)
+ * declares the GPU lost: nothing is recovered, nothing more is submitted.
+ */
+bool
+SweetAdrenoUserClient::waitFence(uint32_t fence, uint64_t ns)
+{
+	uint64_t began = mach_absolute_time(), limit, cap, early;
+
+	if (fence == 0 || sweet_gpu_fence_done(fence)) {
+		return true;
+	}
+	if (ns == 0) {
+		return false;
+	}
+	nanoseconds_to_absolutetime(ns, &limit);
+	nanoseconds_to_absolutetime((uint64_t)WAIT_PATIENCE_MS * NSEC_PER_MSEC, &cap);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &early);
+	for (;;) {
+		uint64_t waited = mach_absolute_time() - began;
+		if (sweet_gpu_fence_done(fence)) {
+			return true;
+		}
+		if (!sweet_gpu_ready()) {
+			return false;
+		}
+		if (waited >= limit || waited >= cap) {
+			if (ns >= NSEC_PER_SEC && waited >= cap) {
+				sweet_gpu_mark_lost();
+			}
+			return false;
+		}
+		IOLockUnlock(gAdrenoLock);
+		if (waited < early) {           /* short jobs: spin; longer ones: sleep a millisecond at a time */
+			delay_for_interval(100, NSEC_PER_USEC);
+		} else {
+			IOSleep(1);
+		}
+		IOLockLock(gAdrenoLock);
+	}
+}
+
+/*
+ * Give a BO back (lock held). If the GPU might still use it (a submission that did not
+ * complete), the memory and its GPU mapping are deliberately leaked: freeing pages the GPU
+ * can still write would corrupt the kernel.
+ */
+void
+SweetAdrenoUserClient::releaseGem(struct sweet_gem *g)
+{
+	bool done = true;
+
+	if (g->lastFence != 0 && !sweet_gpu_fence_done(g->lastFence)) {
+		done = waitFence(g->lastFence, (uint64_t)CLOSE_PATIENCE_MS * NSEC_PER_MSEC);
+	}
+	if (!sweet_gpu_ready()) {
+		done = false;
+	}
+	if (!done) {
+		IOLog("SWEET GPU: BO iova %#llx size %llu still in use by the GPU; leaked\n", g->iova, g->size);
+		g->md->retain();
+		if (g->surface != NULL) {
+			g->surface->retain();
+		}
+	} else if (g->iova != IOVA_UNSET) {
+		sweet_gpu_vm_unmap(g->iova, g->size);
+		sweet_gpu_iova_free(g->iova, g->vaLen);
+		if (g->pa != 0) {
+			/* Arena memory goes back to the free list; a leaked BO keeps it, on purpose. */
+			sweet_gpu_free_pages(g->pa, g->size);
+		}
+	}
+	OSSafeReleaseNULL(g->md);
+	g->buf = NULL;
+	if (g->surface != NULL) {
+		g->surface->release();
+		g->surface = NULL;
+	}
+	g->kva = NULL;
+	g->pa = 0;
+	g->iova = IOVA_UNSET;
+}
+
+/* Enter the pages of g->md into the GPU address space and give out a handle (lock held). */
+IOReturn
+SweetAdrenoUserClient::mapGem(struct sweet_gem *slot, uint32_t flags, uint32_t *handle, uint64_t setIova)
+{
+	uint64_t iova, taken, size = slot->size;
+	bool ro = (flags & SWEET_MSM_BO_GPU_READONLY) != 0;
+
+	if (setIova != 0) {
+		if (!sweet_gpu_iova_reserve(setIova, size)) {
+			return kIOReturnNoSpace;
+		}
+		iova = setIova;
+		taken = size;
+	} else if (!sweet_gpu_iova_alloc(size, &iova, &taken)) {
+		IOLog("SWEET GPU: no GPU address space for %llu bytes\n", size);
+		{ IOLog("SWEET GPU: no iova for %llu bytes (arena %#llx)\n", size, slot->pa); return kIOReturnNoSpace; }
+	}
+	bool ok = true;
+	uint64_t mapped = 0;
+	for (; mapped < size && ok; mapped += PAGE_SIZE) {
+		uint64_t pa;
+		if (slot->pa != 0) {
+			/* GEM_NEW: the arena address is already known, no descriptor walk needed. */
+			pa = slot->pa + mapped;
+		} else {
+			IOByteCount length = 0;
+			pa = (uint64_t)slot->md->getPhysicalSegment(mapped, &length, kIOMemoryMapperNone);
+		}
+		ok = pa != 0 && (pa & (PAGE_SIZE - 1)) == 0 && sweet_gpu_vm_map(iova + mapped, pa, ro);
+		if (!ok) {
+			IOLog("SWEET GPU: mapGem page %llu of %llu failed: iova %#llx pa %#llx\n",
+			    mapped / PAGE_SIZE, size / PAGE_SIZE, iova, pa);
+		}
+	}
+	if (!ok) {
+		sweet_gpu_vm_unmap(iova, mapped);
+		sweet_gpu_iova_free(iova, taken);
+		IOLog("SWEET GPU: cannot map %llu bytes into the GPU address space (page %llu)\n", size, mapped / PAGE_SIZE);
+		return kIOReturnNoMemory;
+	}
+	slot->iova = iova;
+	slot->vaLen = taken;
+	slot->flags = flags;
+	*handle = (uint32_t)(slot - fGems) + 1;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAdrenoUserClient::gemNew(struct sweet_msm_gem_new *r)
+{
+	uint64_t size = round_page_64(r->size);
+
+	if (r->size == 0 || size > GEM_SIZE_MAX) {
+		return kIOReturnBadArgument;
+	}
+	/*
+	 * The arena, not the VM: this port's free lists hold pages below gPhysBase and pmap panics
+	 * on them (phys_to_kv_range). sweet_gpu_alloc_pages() hands out contiguous, zeroed arena
+	 * memory above the base - the same memory the CP ring and the chardev BOs use.
+	 *
+	 * withPhysicalAddress() is IOMemoryDescriptor's static (OSPtr is a plain pointer here, so
+	 * it returns IOMemoryDescriptor *); SweetSurface.cpp wraps the panel with the same call.
+	 */
+	uint64_t pa = 0;
+	void *akva = NULL;
+	if (!sweet_gpu_alloc_pages(size, &pa, &akva)) {
+		return kIOReturnNoMemory;
+	}
+	IOMemoryDescriptor *buf = IOMemoryDescriptor::withPhysicalAddress(
+	    (IOPhysicalAddress)pa, (IOByteCount)size, kIODirectionInOut);
+	if (buf == NULL) {
+		sweet_gpu_free_pages(pa, size);
+		return kIOReturnNoMemory;
+	}
+	uint8_t *kva = (uint8_t *)akva;
+	/*
+	 * Not bzero(): bzero uses dc zva (osfmk/arm64/bzero.s), and dc zva is not permitted on
+	 * I/O mapped memory - the arena comes from ml_io_map, so it faults (unaligned kernel data
+	 * abort). sweet_gpu_alloc_pages() already zeroed these pages with 32-bit stores, and
+	 * uncached memory needs no cache maintenance.
+	 */
+
+	IOLockLock(gAdrenoLock);
+	IOReturn ret = kIOReturnNoResources;
+	if (!sweet_gpu_ready()) {
+		ret = kIOReturnNotReady;
+	} else {
+		for (uint32_t n = 0; n < GEM_MAX; n++) {
+			uint32_t i = (fNextGem + n) % GEM_MAX;
+			if (fGems[i].md == NULL) {
+				struct sweet_gem *g = &fGems[i];
+				bzero(g, sizeof(*g));
+				g->md = buf;
+				g->kva = kva;
+				g->pa = pa;
+				g->size = size;
+				ret = mapGem(g, r->flags, &r->handle, 0);
+				if (ret != kIOReturnSuccess) {
+					bzero(g, sizeof(*g));
+				} else {
+					fNextGem = i + 1;
+				}
+				break;
+			}
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	if (ret != kIOReturnSuccess) {
+		buf->release();
+	}
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::gemInfo(struct sweet_msm_gem_info *r)
+{
+	IOLockLock(gAdrenoLock);
+	struct sweet_gem *g = gem(r->handle);
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (g != NULL) {
+		ret = kIOReturnSuccess;
+		switch (r->info) {
+		case SWEET_MSM_INFO_GET_OFFSET:
+			r->value = r->handle;
+			break;
+		case SWEET_MSM_INFO_GET_IOVA:
+			r->value = g->iova;
+			break;
+		case SWEET_MSM_INFO_SET_NAME:
+			break;
+		case SWEET_MSM_INFO_GET_FLAGS:
+			r->value = g->flags;
+			break;
+		case SWEET_MSM_INFO_SET_IOVA:
+			if (g->submitted || r->value == g->iova) {
+				ret = r->value == g->iova ? kIOReturnSuccess : kIOReturnNotPermitted;
+			} else if (!sweet_gpu_iova_reserve(r->value, g->size)) {
+				ret = kIOReturnNoSpace;
+			} else {
+				/* move: map at the new place first, then drop the old range */
+				uint64_t old = g->iova, oldLen = g->vaLen, newIova = r->value;
+				bool ok = true;
+				uint64_t mapped = 0;
+				for (; mapped < g->size && ok; mapped += PAGE_SIZE) {
+					IOByteCount length = 0;
+					addr64_t pa = g->md->getPhysicalSegment(mapped, &length, kIOMemoryMapperNone);
+					ok = pa != 0 && sweet_gpu_vm_map(newIova + mapped, pa, (g->flags & SWEET_MSM_BO_GPU_READONLY) != 0);
+				}
+				if (!ok) {
+					sweet_gpu_vm_unmap(newIova, mapped);
+					sweet_gpu_iova_free(newIova, g->size);
+					ret = kIOReturnNoMemory;
+				} else {
+					sweet_gpu_vm_unmap(old, g->size);
+					sweet_gpu_iova_free(old, oldLen);
+					g->iova = newIova;
+					g->vaLen = g->size;
+				}
+			}
+			break;
+		default:
+			ret = kIOReturnUnsupported;
+			break;
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::cpuPrep(struct sweet_msm_gem_cpu_prep *r)
+{
+	IOLockLock(gAdrenoLock);
+	struct sweet_gem *g = gem(r->handle);
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (g != NULL) {
+		ret = kIOReturnSuccess;
+		if (!(r->op & SWEET_MSM_PREP_NOSYNC)) {
+			uint32_t f = (r->op & SWEET_MSM_PREP_WRITE) ? g->lastFence : g->lastWrite;
+			uint64_t ns = (uint64_t)r->timeout.tv_sec * NSEC_PER_SEC + (uint64_t)r->timeout.tv_nsec;
+			if (r->timeout.tv_sec < 0 || r->timeout.tv_nsec < 0) {
+				ns = 0;
+			}
+			if (!waitFence(f, ns)) {
+				ret = kIOReturnTimeout;
+			}
+		} else if (g->lastFence != 0 && !sweet_gpu_fence_done((r->op & SWEET_MSM_PREP_WRITE) ? g->lastFence : g->lastWrite)) {
+			ret = kIOReturnBusy;
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::submit(struct sweet_msm_gem_submit *r)
+{
+	struct sweet_msm_gem_submit_bo *bos = NULL;
+	struct sweet_msm_gem_submit_cmd *cmds = NULL;
+	struct sweet_msm_gem_submit_reloc *relocs = NULL;
+	struct sweet_gem **objs = NULL;
+	uint64_t ib[SUBMIT_CMDS_MAX];
+	uint32_t ibn[SUBMIT_CMDS_MAX];
+	uint32_t totalRelocs = 0;
+	IOReturn ret;
+
+	if (r->nr_bos == 0 || r->nr_bos > SUBMIT_BOS_MAX || r->nr_cmds == 0 || r->nr_cmds > SUBMIT_CMDS_MAX) {
+		return kIOReturnBadArgument;
+	}
+	if ((r->flags & ~SWEET_MSM_SUBMIT_NO_IMPLICIT) != 0 || r->nr_in_syncobjs != 0 || r->nr_out_syncobjs != 0 ||
+	    r->in_syncobjs != 0 || r->out_syncobjs != 0 || (r->queueid >= QUEUE_IDS) ||
+	    (r->queueid != 0 && !(fQueues & (1ull << r->queueid)))) {
+		return kIOReturnUnsupported;
+	}
+	const size_t bosSize = sizeof(*bos) * r->nr_bos, cmdsSize = sizeof(*cmds) * r->nr_cmds;
+	bos = (struct sweet_msm_gem_submit_bo *)IOMallocData(bosSize);
+	cmds = (struct sweet_msm_gem_submit_cmd *)IOMallocData(cmdsSize);
+	objs = (struct sweet_gem **)IOMallocZeroData(sizeof(*objs) * r->nr_bos);
+	if (bos == NULL || cmds == NULL || objs == NULL) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	if ((ret = copyIn(r->bos, bos, bosSize)) != kIOReturnSuccess ||
+	    (ret = copyIn(r->cmds, cmds, cmdsSize)) != kIOReturnSuccess) {
+		goto out;
+	}
+	for (uint32_t i = 0; i < r->nr_cmds; i++) {
+		if (cmds[i].nr_relocs > SUBMIT_RELOCS_MAX) {
+			ret = kIOReturnBadArgument;
+			goto out;
+		}
+	}
+
+	/* Relocations are copied in before the lock (they come from user memory); patched under it. */
+	for (uint32_t i = 0; i < r->nr_cmds; i++) {
+		totalRelocs += cmds[i].nr_relocs;
+		if (totalRelocs > SUBMIT_RELOCS_MAX) {
+			ret = kIOReturnBadArgument;
+			goto out;
+		}
+	}
+	if (totalRelocs != 0) {
+		relocs = (struct sweet_msm_gem_submit_reloc *)IOMallocData(sizeof(*relocs) * totalRelocs);
+		if (relocs == NULL) {
+			ret = kIOReturnNoMemory;
+			goto out;
+		}
+		uint32_t at = 0;
+		for (uint32_t i = 0; i < r->nr_cmds; i++) {
+			if ((ret = copyIn(cmds[i].relocs, &relocs[at], sizeof(*relocs) * cmds[i].nr_relocs)) != kIOReturnSuccess) {
+				goto out;
+			}
+			at += cmds[i].nr_relocs;
+		}
+	}
+
+	IOLockLock(gAdrenoLock);
+	if (!sweet_gpu_ready()) {
+		ret = kIOReturnNotReady;
+		goto unlock;
+	}
+	for (uint32_t i = 0; i < r->nr_bos; i++) {
+		if ((bos[i].flags & ~(uint32_t)(SWEET_MSM_SUBMIT_BO_READ | SWEET_MSM_SUBMIT_BO_WRITE |
+		    SWEET_MSM_SUBMIT_BO_DUMP | SWEET_MSM_SUBMIT_BO_NO_IMPLICIT)) != 0 || (objs[i] = gem(bos[i].handle)) == NULL) {
+			ret = kIOReturnBadArgument;
+			goto unlock;
+		}
+	}
+	{
+		uint32_t at = 0;
+		for (uint32_t i = 0; i < r->nr_cmds; i++) {
+			struct sweet_msm_gem_submit_cmd *c = &cmds[i];
+			if ((c->type != SWEET_MSM_SUBMIT_CMD_BUF && c->type != SWEET_MSM_SUBMIT_CMD_CTX_RESTORE_BUF) ||
+			    c->submit_idx >= r->nr_bos || (c->submit_offset & 3) || (c->size & 3) || c->size == 0 ||
+			    (uint64_t)c->submit_offset + c->size > objs[c->submit_idx]->size) {
+				ret = c->type == SWEET_MSM_SUBMIT_CMD_PRIMARY ? kIOReturnUnsupported : kIOReturnBadArgument;
+				goto unlock;
+			}
+			struct sweet_gem *cb = objs[c->submit_idx];
+			for (uint32_t k = 0; k < c->nr_relocs; k++) {
+				struct sweet_msm_gem_submit_reloc *rl = &relocs[at + k];
+				if (cb->surface != NULL || cb->kva == NULL || (rl->submit_offset & 3) || (uint64_t)rl->submit_offset + 4 > cb->size ||
+				    rl->reloc_idx >= r->nr_bos || rl->reloc_offset >= objs[rl->reloc_idx]->size ||
+				    rl->shift > 63 || rl->shift < -63) {
+					ret = kIOReturnBadArgument;
+					goto unlock;
+				}
+			}
+			at += c->nr_relocs;
+		}
+		/* validated: patch, then submit */
+		at = 0;
+		for (uint32_t i = 0; i < r->nr_cmds; i++) {
+			struct sweet_msm_gem_submit_cmd *c = &cmds[i];
+			struct sweet_gem *cb = objs[c->submit_idx];
+			for (uint32_t k = 0; k < c->nr_relocs; k++) {
+				struct sweet_msm_gem_submit_reloc *rl = &relocs[at + k];
+				uint64_t v = objs[rl->reloc_idx]->iova + rl->reloc_offset;
+				v = rl->shift < 0 ? v >> -rl->shift : v << rl->shift;
+				v |= rl->or_;
+				*(volatile uint32_t *)(cb->kva + rl->submit_offset) = (uint32_t)v;
+			}
+			at += c->nr_relocs;
+			ib[i] = cb->iova + c->submit_offset;
+			ibn[i] = c->size / 4;
+		}
+	}
+	/*
+	 * fajita (ib2trunc=N): shorten the nested command buffers that CP_INDIRECT_BUFFER starts, by rewriting
+	 * the size field of the packet itself. Truncating the outer buffer at 11 dwords retires and at 15 does
+	 * not - the difference is one CP_INDIRECT_BUFFER that runs the window server's 196-dword binning pass -
+	 * so cutting *inside* that buffer is what names the packet in it that wedges the pipe.
+	 */
+	{
+		int n2 = 0;
+
+		if (PE_parse_boot_argn("ib2trunc", &n2, sizeof(n2)) && n2 > 0) {
+			for (uint32_t i = 0; i < r->nr_cmds; i++) {
+				struct sweet_gem *cb = objs[cmds[i].submit_idx];
+				volatile uint32_t *q = (volatile uint32_t *)(void *)(cb->kva + cmds[i].submit_offset);
+				uint32_t words = ibn[i];
+
+				for (uint32_t at = 0; at + 1 < words;) {
+					uint32_t h = q[at];
+					uint32_t cnt;
+
+					if ((h & 0xf0000000u) == 0x40000000u) {
+						/* type 4 is a plain register write and sits between the packets of interest */
+						at += 1 + (h & 0x7fu);
+						continue;
+					}
+					if ((h & 0xf0000000u) != 0x70000000u) {
+						break;
+					}
+					cnt = h & 0x3fffu;
+					/* header, then addr lo, addr hi, size: the size is the third payload dword */
+					if (((h >> 16) & 0x7fu) == 0x3fu && cnt >= 3 && at + 3 < words) {
+						uint32_t size = q[at + 3];
+						if (size > (uint32_t)n2) {
+							IOLog("SWEET ADRENO: ib %u indirect at %u truncated %u -> %d dwords\n",
+							    i, at, size, n2);
+							q[at + 3] = (uint32_t)n2;
+						}
+					}
+					at += 1 + cnt;
+				}
+			}
+		}
+	}
+	/*
+	 * The client writes through a cacheable mapping (the map options it passes override whatever
+	 * clientMemoryForType() asks for), so its stores may still be dirty in the CPU cache when the
+	 * CP reads. Clean every buffer in this submission through the linear map - flush_dcache64()
+	 * does that by physical address, which is why it works for a mapping we do not own.
+	 */
+	for (uint32_t i = 0; i < r->nr_bos; i++) {
+		struct sweet_gem *g = objs[i];
+		/*
+		 * fajita: flush_dcache64(pa, len, TRUE) reaches the memory through phystokv(), and this kernel
+		 * manages physical memory from 4 GiB up (mkadt --highmem), so a buffer that happens to sit below
+		 * that base takes PhysToKV: illegal PA and panics the machine (0x8f714000 in console148). Those
+		 * buffers are Device memory (nGnRE) - an unaligned 8-byte read from them already took an
+		 * unaligned-abort panic - and device memory is uncached, so it never needs a clean. Only buffers
+		 * in the linear-mapped range are cleaned.
+		 */
+		if (g->pa >= 0x100000000ull && g->size != 0) {
+			flush_dcache64((addr64_t)g->pa, (unsigned)g->size, TRUE);
+		}
+	}
+	/*
+	 * What the CP is about to read, through the uncached alias. The first two client command buffers are
+	 * dumped in full (a few hundred dwords): the eight dwords above say the stream is real, this says what
+	 * it actually asks the GPU to do - the packets that follow are either a sane draw state sequence or
+	 * the first place the 3D pipe can be wedged.
+	 */
+	{
+		struct sweet_gem *cb = objs[cmds[0].submit_idx];
+		/* the command buffer, not the start of the BO: submit_offset is where the client put it */
+		volatile uint32_t *q = (volatile uint32_t *)(void *)(cb->kva + cmds[0].submit_offset);
+		uint32_t n = ibn[0];
+		static unsigned full_dumps;
+
+		IOLog("SWEET ADRENO: ib %#llx: %#x %#x %#x %#x %#x %#x %#x %#x\n", cb->iova,
+		    q[0], q[1], q[2], q[3], q[4], q[5], q[6], q[7]);
+		if (full_dumps < 2) {
+			full_dumps++;
+			if (n > 384) {
+				n = 384;
+			}
+			IOLog("SWEET ADRENO: ib %#llx full, %u dwords\n", cb->iova, n);
+			for (uint32_t i = 0; i + 8 <= n; i += 8) {
+				IOLog("SWEET ADRENO: %03u: %#010x %#010x %#010x %#010x %#010x %#010x %#010x %#010x\n",
+				    i, q[i], q[i + 1], q[i + 2], q[i + 3], q[i + 4], q[i + 5], q[i + 6],
+				    q[i + 7]);
+			}
+		}
+	}
+	/*
+	 * fajita (ibounce=1): submit a copy of the command buffer from memory the driver owns. The same
+	 * dwords retire their fence when submitted that way from the bring-up test, so this separates
+	 * "the stream wedges the pipe" from "the CP does not read the client's memory as the CPU does".
+	 */
+	{
+		int bounce = 0;
+
+		if (PE_parse_boot_argn("ibounce", &bounce, sizeof(bounce)) && bounce != 0) {
+			for (uint32_t i = 0; i < r->nr_cmds; i++) {
+				struct sweet_gem *cb = objs[cmds[i].submit_idx];
+				uint64_t bva = sweet_gpu_bounce_ib(cb->kva + cmds[i].submit_offset, ibn[i]);
+
+				if (bva != 0) {
+					IOLog("SWEET ADRENO: ib %u bounced: %#llx -> %#llx, %u dwords\n",
+					    i, (unsigned long long)ib[i], (unsigned long long)bva, ibn[i]);
+					ib[i] = bva;
+					break;          /* one page: only the first command buffer */
+				}
+			}
+		}
+	}
+	/*
+	 * fajita (ibtrunc=N): submit only the first N dwords of every command buffer. The fence is appended by
+	 * sweet_gpu_submit() to the *ring*, not to the client's buffer, so a truncated stream still gets a fence -
+	 * which makes this a bisection: the shortest prefix that wedges the CP names the packet that does it, and
+	 * a prefix that ends just before a CP_INDIRECT_BUFFER separates "the packets before it" from "whatever
+	 * that nested buffer contains" (the window server's binning pass, at offset 11 of its first buffer).
+	 */
+	{
+		int trunc = 0;
+
+		if (PE_parse_boot_argn("ibtrunc", &trunc, sizeof(trunc)) && trunc > 0) {
+			for (uint32_t i = 0; i < r->nr_cmds; i++) {
+				if (ibn[i] > (uint32_t)trunc) {
+					IOLog("SWEET ADRENO: ib %u truncated %u -> %d dwords\n", i, ibn[i], trunc);
+					ibn[i] = (uint32_t)trunc;
+				}
+			}
+		}
+	}
+	{
+		uint32_t fence = sweet_gpu_submit(ib, ibn, r->nr_cmds);
+		if (fence == 0) {
+			ret = kIOReturnNoResources;
+			goto unlock;
+		}
+		for (uint32_t i = 0; i < r->nr_bos; i++) {
+			objs[i]->lastFence = fence;
+			objs[i]->submitted = true;
+			if (bos[i].flags & SWEET_MSM_SUBMIT_BO_WRITE) {
+				objs[i]->lastWrite = fence;
+			}
+		}
+		fLastFence = fence;
+		r->fence = fence;
+		r->fence_fd = -1;
+		ret = kIOReturnSuccess;
+		IOLog("SWEET ADRENO: submit %u bos %u cmds, ib %#llx %u dwords, fence %u\n",
+		    r->nr_bos, r->nr_cmds, ib[0], ibn[0], fence);
+	}
+unlock:
+	IOLockUnlock(gAdrenoLock);
+out:
+	if (bos != NULL) {
+		IOFreeData(bos, bosSize);
+	}
+	if (cmds != NULL) {
+		IOFreeData(cmds, cmdsSize);
+	}
+	if (relocs != NULL) {
+		IOFreeData(relocs, sizeof(*relocs) * totalRelocs);
+	}
+	if (objs != NULL) {
+		IOFreeData(objs, sizeof(*objs) * r->nr_bos);
+	}
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::waitFenceCall(struct sweet_msm_wait_fence *r)
+{
+	IOLockLock(gAdrenoLock);
+	IOReturn ret;
+
+	if (r->queueid >= QUEUE_IDS || (r->queueid != 0 && !(fQueues & (1ull << r->queueid)))) {
+		ret = kIOReturnBadArgument;
+	} else if (r->fence == 0 || (int32_t)(r->fence - sweet_gpu_fence_last()) > 0) {
+		ret = kIOReturnBadArgument;             /* not a submitted sequence number */
+	} else {
+		uint64_t ns = (r->timeout.tv_sec < 0 || r->timeout.tv_nsec < 0) ? 0 :
+		    (uint64_t)r->timeout.tv_sec * NSEC_PER_SEC + (uint64_t)r->timeout.tv_nsec;
+		ret = waitFence(r->fence, ns) ? kIOReturnSuccess : (sweet_gpu_ready() ? kIOReturnTimeout : kIOReturnNotReady);
+		IOLog("SWEET ADRENO: wait fence %u (%llu ns) -> %#x, last %u\n", r->fence,
+		    (unsigned long long)ns, ret, sweet_gpu_fence_last());
+		if (ret == kIOReturnTimeout) {
+			/* one dump per boot: the first hang is the interesting one, the rest repeat it */
+			static bool dumped;
+
+			if (!dumped) {
+				dumped = true;
+				sweet_gpu_dump_cp_state("client fence timeout");
+			}
+		}
+		/*
+		 * The client's own output does not reach the console (launchd gives it a stdout nobody
+		 * reads), so the kernel reports what the GPU produced - on timeout too, which is exactly
+		 * when the contents matter. The tester writes 0x600d0001/0x600d0002 at +0x10/+0x20 of the
+		 * target, so seeing them means the command buffer ran and the fence is honest.
+		 */
+		for (uint32_t i = 0; i < GEM_MAX; i++) {
+			struct sweet_gem *g = &fGems[i];
+			if (g->md == NULL || g->pa == 0 || g->kva == NULL) {
+				continue;
+			}
+			volatile uint32_t *p = (volatile uint32_t *)(void *)g->kva;
+			IOLog("SWEET ADRENO: bo %u iova %#llx: %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x\n",
+			    i + 1, g->iova, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7],
+			    p[8], p[9], p[10], p[11]);
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::surfaceBo(struct sweet_gpu_surface_bo *r)
+{
+	SweetSurface *s = sweet_surface_copy(r->surface_id);
+	IOReturn ret;
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (s->memory == NULL) {   /* no wrapped surfaces on this port */
+		s->release();
+		return kIOReturnUnsupported;       /* wrapped client memory is pageable: never entered into the GPU */
+	}
+	uint64_t size = round_page_64(s->memory->getLength());
+	r->size = size;
+	r->offset = s->offset;
+	r->bytes_per_row = s->bytesPerRow;
+	r->width = s->width;
+	r->height = s->height;
+	r->pixel_format = s->pixelFormat;
+	r->planes = s->planeCount;
+	r->iova = 0;
+	if (r->handle == SWEET_GPU_DESCRIBE_ONLY) {
+		r->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+	if (size == 0 || size > GEM_SIZE_MAX) {
+		s->release();
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gAdrenoLock);
+	ret = kIOReturnNoResources;
+	if (!sweet_gpu_ready()) {
+		ret = kIOReturnNotReady;
+	} else {
+		for (uint32_t n = 0; n < GEM_MAX; n++) {
+			uint32_t i = (fNextGem + n) % GEM_MAX;
+			if (fGems[i].md == NULL) {
+				struct sweet_gem *g = &fGems[i];
+				bzero(g, sizeof(*g));
+				s->memory->retain();
+				g->md = s->memory;
+				g->surface = s;         /* our reference moves into the slot on success */
+				g->kva = (uint8_t *)s->kernelAddress();
+				g->size = size;
+				ret = mapGem(g, 0, &r->handle, 0);
+				if (ret != kIOReturnSuccess) {
+					g->md->release();
+					bzero(g, sizeof(*g));
+				} else {
+					fNextGem = i + 1;
+					r->iova = g->iova;
+					s = NULL;
+				}
+				break;
+			}
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	if (s != NULL) {
+		s->release();
+	}
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::boSync(struct sweet_gpu_bo_sync *r)
+{
+	IOLockLock(gAdrenoLock);
+	struct sweet_gem *g = gem(r->handle);
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (g != NULL) {
+		if (g->kva == NULL) {
+			ret = kIOReturnUnsupported;
+		} else if (r->offset > g->size || r->size > g->size - r->offset) {
+			ret = kIOReturnBadArgument;
+		} else {
+			uint64_t len = r->size ? r->size : g->size - r->offset;
+			sweet_gpu_cache_sync(g->kva + r->offset, (size_t)len);
+			ret = kIOReturnSuccess;
+		}
+	}
+	IOLockUnlock(gAdrenoLock);
+	return ret;
+}
+
+IOReturn
+SweetAdrenoUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gAdrenoLock);
+	struct sweet_gem *g = gem(type);
+	if (g != NULL) {
+		g->md->retain();
+		*memory = g->md;
+		*options = 0;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gAdrenoLock);
+	return ret;
+}
+
+static IOReturn
+adreno_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutput == NULL) {
+		return kIOReturnSuccess;        /* the caller does not want the result */
+	}
+	if (len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAdrenoUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	union {
+		struct sweet_gem_close close;
+		struct sweet_msm_param param;
+		struct sweet_msm_gem_new gemNew;
+		struct sweet_msm_gem_info gemInfo;
+		struct sweet_msm_gem_cpu_prep cpuPrep;
+		struct sweet_msm_gem_cpu_fini cpuFini;
+		struct sweet_msm_gem_submit submit;
+		struct sweet_msm_wait_fence waitFence;
+		struct sweet_msm_gem_madvise madvise;
+		struct sweet_msm_submitqueue queue;
+		struct sweet_gpu_info info;
+		struct sweet_gpu_surface_bo surface;
+		struct sweet_gpu_bo_sync sync;
+		uint32_t queueId;
+	} r;
+	size_t in = args->structureInputSize;
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t outLen = 0;
+
+	if (args->structureInputDescriptor != NULL || args->structureOutputDescriptor != NULL ||
+	    (in != 0 && args->structureInput == NULL) || in > sizeof(r)) {
+		return kIOReturnBadArgument;
+	}
+	bzero(&r, sizeof(r));
+	if (in != 0) {
+		memcpy(&r, args->structureInput, in);
+	}
+	if (!sweet_gpu_ready() && selector != SWEET_GPU_SEL_INFO) {
+		return kIOReturnNotReady;
+	}
+
+#define NEED(T) do { if (in < sizeof(T)) { return kIOReturnBadArgument; } } while (0)
+	/* Which selector the client asked for, before anything can panic on it. */
+	IOLog("SWEET ADRENO: selector %#x in %u bytes\n", selector, (unsigned)in);
+
+	switch (selector) {
+	case SWEET_GPU_SEL_GET_PARAM:
+		NEED(struct sweet_msm_param);
+		IOLockLock(gAdrenoLock);
+		ret = sweet_gpu_param(r.param.param, &r.param.value) ? kIOReturnSuccess : kIOReturnUnsupported;
+		IOLockUnlock(gAdrenoLock);
+		outLen = sizeof(r.param);
+		break;
+	case SWEET_GPU_SEL_GEM_NEW:
+		NEED(struct sweet_msm_gem_new);
+		ret = gemNew(&r.gemNew);
+		outLen = sizeof(r.gemNew);
+		break;
+	case SWEET_GPU_SEL_GEM_INFO:
+		NEED(struct sweet_msm_gem_info);
+		ret = gemInfo(&r.gemInfo);
+		outLen = sizeof(r.gemInfo);
+		break;
+	case SWEET_GPU_SEL_GEM_CPU_PREP:
+		NEED(struct sweet_msm_gem_cpu_prep);
+		ret = cpuPrep(&r.cpuPrep);
+		break;
+	case SWEET_GPU_SEL_GEM_CPU_FINI:
+		NEED(struct sweet_msm_gem_cpu_fini);
+		IOLockLock(gAdrenoLock);
+		ret = gem(r.cpuFini.handle) != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+		IOLockUnlock(gAdrenoLock);
+		__asm__ volatile ("dsb sy" ::: "memory");       /* CPU stores through the WC mapping reach memory */
+		break;
+	case SWEET_GPU_SEL_GEM_SUBMIT:
+		NEED(struct sweet_msm_gem_submit);
+		ret = submit(&r.submit);
+		outLen = sizeof(r.submit);
+		break;
+	case SWEET_GPU_SEL_WAIT_FENCE:
+		NEED(struct sweet_msm_wait_fence);
+		ret = waitFenceCall(&r.waitFence);
+		break;
+	case SWEET_GPU_SEL_GEM_MADVISE:
+		NEED(struct sweet_msm_gem_madvise);
+		IOLockLock(gAdrenoLock);
+		ret = gem(r.madvise.handle) != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+		IOLockUnlock(gAdrenoLock);
+		r.madvise.retained = 1;
+		outLen = sizeof(r.madvise);
+		break;
+	case SWEET_GPU_SEL_GEM_CLOSE:
+		NEED(struct sweet_gem_close);
+		IOLockLock(gAdrenoLock);
+		{
+			struct sweet_gem *g = gem(r.close.handle);
+			if (g == NULL) {
+				ret = kIOReturnBadArgument;
+			} else {
+				releaseGem(g);
+			}
+		}
+		IOLockUnlock(gAdrenoLock);
+		break;
+	case SWEET_GPU_SEL_SUBMITQUEUE_NEW:
+		NEED(struct sweet_msm_submitqueue);
+		IOLockLock(gAdrenoLock);
+		ret = kIOReturnNoResources;
+		/*
+		 * One ring, so there are no priority levels: freedreno asks for prio 1 unconditionally
+		 * (fd_pipe_new -> fd_pipe_new2(dev, id, 1)) and its own comment calls that the default.
+		 * Keep the preempt hint bit allowed too, refuse anything else.
+		 */
+		IOLog("SWEET ADRENO: submitqueue_new flags %#x prio %u\n", r.queue.flags, r.queue.prio);
+		if ((r.queue.flags & ~1u) != 0) {
+			ret = kIOReturnBadArgument;
+		} else {
+			for (uint32_t id = 1; id < QUEUE_IDS; id++) {
+				if (!(fQueues & (1ull << id))) {
+					fQueues |= 1ull << id;
+					r.queue.id = id;
+					ret = kIOReturnSuccess;
+					break;
+				}
+			}
+		}
+		IOLockUnlock(gAdrenoLock);
+		outLen = sizeof(r.queue);
+		break;
+	case SWEET_GPU_SEL_SUBMITQUEUE_CLOSE:
+		NEED(uint32_t);
+		IOLockLock(gAdrenoLock);
+		if (r.queueId == 0 || r.queueId >= QUEUE_IDS || !(fQueues & (1ull << r.queueId))) {
+			ret = kIOReturnBadArgument;
+		} else {
+			fQueues &= ~(1ull << r.queueId);
+		}
+		IOLockUnlock(gAdrenoLock);
+		break;
+	case SWEET_GPU_SEL_INFO: {
+		uint64_t v = 0;
+		IOLockLock(gAdrenoLock);
+		r.info.abi_version = SWEET_GPU_ABI_VERSION;
+		r.info.flags = sweet_gpu_ready() ? 1u : 2u;
+		r.info.gpu_id = 630;
+		r.info.chip_id = 0x06030001;
+		r.info.va_start = sweet_gpu_param(SWEET_MSM_PARAM_VA_START, &v) ? v : 0;
+		r.info.va_size = sweet_gpu_param(SWEET_MSM_PARAM_VA_SIZE, &v) ? v : 0;
+		r.info.last_fence = sweet_gpu_ready() ? sweet_gpu_fence_last() : 0;
+		IOLockUnlock(gAdrenoLock);
+		outLen = sizeof(r.info);
+		break;
+	}
+	case SWEET_GPU_SEL_SURFACE_BO:
+		NEED(struct sweet_gpu_surface_bo);
+		ret = surfaceBo(&r.surface);
+		outLen = sizeof(r.surface);
+		break;
+	case SWEET_GPU_SEL_BO_SYNC:
+		NEED(struct sweet_gpu_bo_sync);
+		ret = boSync(&r.sync);
+		break;
+	default:
+		ret = kIOReturnUnsupported;     /* SET_PARAM, SUBMITQUEUE_QUERY and anything else */
+		break;
+	}
+#undef NEED
+	if (ret == kIOReturnSuccess && outLen != 0) {
+		ret = adreno_out(args, &r, outLen);
+	}
+	return ret;
+}
+
+#endif /* SWEET */
diff --git a/iokit/Kernel/arm/SweetAdrenoABI.h b/iokit/Kernel/arm/SweetAdrenoABI.h
new file mode 100644
index 0000000..60c8367
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAdrenoABI.h
@@ -0,0 +1,235 @@
+/*
+ * SweetAdreno630: IOKit ABI of the Heartwood Adreno 630 kernel driver (Poco F1).
+ *
+ * This file is the contract between the kernel (iokit/Kernel/arm/SweetAdreno.cpp,
+ * the same bytes are installed there as SweetAdrenoABI.h by xnu/patches-11215/0182)
+ * and the userland winsys (Mesa freedreno/msm backend, EAGL bridge). Human-readable
+ * description, call sequences and error codes: docs/GPU_KERNEL.md. Keep both in sync.
+ *
+ * The requests are those of the Linux msm DRM driver (include/uapi/drm/msm_drm.h:
+ * request numbers = DRM_COMMAND_BASE (0x40) + DRM_MSM_*, structure layouts), so that a
+ * libdrm stand-in can forward drmIoctl(fd, DRM_IOCTL_MSM_X, &arg) unchanged:
+ *
+ *     kern_return_t kr = IOConnectCallStructMethod(conn, SWEET_GPU_SEL_X,
+ *                            &arg, sizeof(arg), &arg, &(size_t){ sizeof(arg) });
+ *
+ * Struct layouts below are the Linux uapi ones (they are an ABI of Mesa, not code).
+ * Differences from Linux are listed in docs/GPU_KERNEL.md ("Differences from msm").
+ */
+#ifndef SWEET_ADRENO_ABI_H
+#define SWEET_ADRENO_ABI_H
+
+#include <stdint.h>
+
+/* IOServiceMatching() name of the service; IOServiceOpen(type 0) gives the connection. */
+#define SWEET_GPU_SERVICE_NAME          "SweetAdreno630"
+#define SWEET_GPU_ABI_VERSION           1
+
+/* Selectors of IOConnectCallStructMethod. */
+enum sweet_gpu_selector {
+	SWEET_GPU_SEL_GEM_CLOSE         = 0x09, /* DRM_IOCTL_GEM_CLOSE:        struct sweet_gem_close */
+	SWEET_GPU_SEL_GET_PARAM         = 0x40, /* DRM_MSM_GET_PARAM:          struct sweet_msm_param (in/out) */
+	SWEET_GPU_SEL_SET_PARAM         = 0x41, /* DRM_MSM_SET_PARAM:          unsupported (kIOReturnUnsupported) */
+	SWEET_GPU_SEL_GEM_NEW           = 0x42, /* DRM_MSM_GEM_NEW:            struct sweet_msm_gem_new (in/out) */
+	SWEET_GPU_SEL_GEM_INFO          = 0x43, /* DRM_MSM_GEM_INFO:           struct sweet_msm_gem_info (in/out) */
+	SWEET_GPU_SEL_GEM_CPU_PREP      = 0x44, /* DRM_MSM_GEM_CPU_PREP:       struct sweet_msm_gem_cpu_prep */
+	SWEET_GPU_SEL_GEM_CPU_FINI      = 0x45, /* DRM_MSM_GEM_CPU_FINI:       struct sweet_msm_gem_cpu_fini */
+	SWEET_GPU_SEL_GEM_SUBMIT        = 0x46, /* DRM_MSM_GEM_SUBMIT:         struct sweet_msm_gem_submit (in/out) */
+	SWEET_GPU_SEL_WAIT_FENCE        = 0x47, /* DRM_MSM_WAIT_FENCE:         struct sweet_msm_wait_fence */
+	SWEET_GPU_SEL_GEM_MADVISE       = 0x48, /* DRM_MSM_GEM_MADVISE:        struct sweet_msm_gem_madvise (in/out) */
+	SWEET_GPU_SEL_SUBMITQUEUE_NEW   = 0x4a, /* DRM_MSM_SUBMITQUEUE_NEW:    struct sweet_msm_submitqueue (in/out) */
+	SWEET_GPU_SEL_SUBMITQUEUE_CLOSE = 0x4b, /* DRM_MSM_SUBMITQUEUE_CLOSE:  uint32_t id */
+	SWEET_GPU_SEL_SUBMITQUEUE_QUERY = 0x4c, /* DRM_MSM_SUBMITQUEUE_QUERY:  unsupported */
+	/* Heartwood additions (not in msm) */
+	SWEET_GPU_SEL_INFO              = 0x70, /* struct sweet_gpu_info (out) */
+	SWEET_GPU_SEL_SURFACE_BO        = 0x71, /* struct sweet_gpu_surface_bo (in/out): IOSurface memory as a BO */
+	SWEET_GPU_SEL_BO_SYNC           = 0x72, /* struct sweet_gpu_bo_sync: clean+invalidate the CPU alias of a BO */
+};
+
+/* Memory mapping: IOConnectMapMemory64(conn, memoryType = BO handle, task, &addr, &size,
+ * kIOMapAnywhere | kIOMapWriteCombineCache). The "mmap offset" of GEM_INFO(GET_OFFSET) is the handle. */
+
+/* ---- structures (Linux uapi layouts, fixed width, natural alignment) ---- */
+
+struct sweet_msm_timespec {
+	int64_t tv_sec;
+	int64_t tv_nsec;
+};
+
+/* NOTE: timeouts in this ABI are RELATIVE durations ({0,0} = poll), not absolute CLOCK_MONOTONIC. */
+
+struct sweet_msm_param {
+	uint32_t pipe;          /* MSM_PIPE_3D0 (0x10) */
+	uint32_t param;         /* MSM_PARAM_* */
+	uint64_t value;         /* out */
+	uint32_t len;
+	uint32_t pad;
+};
+
+struct sweet_msm_gem_new {
+	uint64_t size;          /* in, rounded up to 4 KiB */
+	uint32_t flags;         /* in, MSM_BO_*; the cache flags are ignored: every BO is write-combined */
+	uint32_t handle;        /* out, > 0 */
+};
+
+struct sweet_msm_gem_info {
+	uint32_t handle;
+	uint32_t info;          /* MSM_INFO_* */
+	uint64_t value;         /* out (GET_*) or in (SET_IOVA) */
+	uint32_t len;           /* SET_NAME: ignored */
+	uint32_t pad;
+};
+
+struct sweet_msm_gem_cpu_prep {
+	uint32_t handle;
+	uint32_t op;            /* MSM_PREP_READ 1 | WRITE 2 | NOSYNC 4 */
+	struct sweet_msm_timespec timeout;      /* relative */
+};
+
+struct sweet_msm_gem_cpu_fini {
+	uint32_t handle;
+};
+
+struct sweet_msm_gem_submit_reloc {
+	uint32_t submit_offset; /* byte offset of the dword to patch, from the start of the cmd's BO */
+	uint32_t or_;           /* OR'd into the result */
+	int32_t  shift;         /* left shift; negative = right shift */
+	uint32_t reloc_idx;     /* index into the submit's bos[] */
+	uint64_t reloc_offset;  /* byte offset from the start of that BO */
+};
+
+struct sweet_msm_gem_submit_cmd {
+	uint32_t type;          /* MSM_SUBMIT_CMD_BUF 1, CTX_RESTORE_BUF 2 (run like BUF); PRIMARY (3) unsupported */
+	uint32_t submit_idx;    /* index into bos[] of the command stream BO */
+	uint32_t submit_offset; /* byte offset into that BO, multiple of 4 */
+	uint32_t size;          /* bytes, multiple of 4 */
+	uint32_t pad;
+	uint32_t nr_relocs;
+	uint64_t relocs;        /* user pointer to sweet_msm_gem_submit_reloc[nr_relocs] */
+};
+
+struct sweet_msm_gem_submit_bo {
+	uint32_t flags;         /* MSM_SUBMIT_BO_READ 1 | WRITE 2 | DUMP 4 | NO_IMPLICIT 8 */
+	uint32_t handle;
+	uint64_t presumed;      /* ignored (the kernel address is the one from GEM_INFO(GET_IOVA)) */
+};
+
+struct sweet_msm_gem_submit {
+	uint32_t flags;         /* in: 0 only (no fence fds, syncobjs, SUDO); NO_IMPLICIT (0x80000000) tolerated */
+	uint32_t fence;         /* out: sequence number, > 0 */
+	uint32_t nr_bos;        /* 1..4096 */
+	uint32_t nr_cmds;       /* 1..128 */
+	uint64_t bos;           /* user pointers */
+	uint64_t cmds;
+	int32_t  fence_fd;      /* out: always -1 */
+	uint32_t queueid;       /* 0 or a SUBMITQUEUE_NEW id */
+	uint64_t in_syncobjs;   /* must be 0 */
+	uint64_t out_syncobjs;  /* must be 0 */
+	uint32_t nr_in_syncobjs;
+	uint32_t nr_out_syncobjs;
+	uint32_t syncobj_stride;
+	uint32_t pad;
+};
+
+struct sweet_msm_wait_fence {
+	uint32_t fence;
+	uint32_t pad;
+	struct sweet_msm_timespec timeout;      /* relative */
+	uint32_t queueid;
+};
+
+struct sweet_msm_gem_madvise {
+	uint32_t handle;
+	uint32_t madv;
+	uint32_t retained;      /* out: always 1 */
+};
+
+struct sweet_msm_submitqueue {
+	uint32_t flags;         /* 0 */
+	uint32_t prio;          /* 0 (one ring) */
+	uint32_t id;            /* out */
+};
+
+struct sweet_gem_close {
+	uint32_t handle;
+	uint32_t pad;
+};
+
+/* ---- Heartwood additions ---- */
+
+struct sweet_gpu_info {
+	uint32_t abi_version;   /* SWEET_GPU_ABI_VERSION */
+	uint32_t flags;         /* bit0 ready, bit1 lost (a submission never completed: reboot needed) */
+	uint32_t gpu_id;        /* 630 */
+	uint32_t chip_id;       /* 0x06030001 */
+	uint64_t va_start;      /* GPU address range the kernel places BOs in */
+	uint64_t va_size;
+	uint32_t last_fence;    /* last submitted sequence number */
+	uint32_t reserved;
+};
+
+/* IOSurface memory as a BO: the pages of the surface (pixels from byte 0 of its memory) are entered into the
+ * GPU address space. On input handle = SWEET_GPU_DESCRIBE_ONLY asks only for the geometry (no BO is made). */
+#define SWEET_GPU_DESCRIBE_ONLY         0xffffffffu
+struct sweet_gpu_surface_bo {
+	uint32_t surface_id;    /* in: IOSurfaceGetID() */
+	uint32_t handle;        /* in: DESCRIBE_ONLY or 0; out: BO handle (0 when describing) */
+	uint64_t size;          /* out: bytes mapped (whole pages) */
+	uint64_t iova;          /* out: GPU address of byte 0 of the surface memory (0 when describing) */
+	uint32_t offset;        /* out: byte offset of pixel (0,0) in the BO */
+	uint32_t bytes_per_row;
+	uint32_t width;
+	uint32_t height;
+	uint32_t pixel_format;
+	uint32_t planes;
+};
+
+struct sweet_gpu_bo_sync {
+	uint32_t handle;
+	uint32_t flags;         /* 0 */
+	uint64_t offset;        /* byte range inside the BO; size 0 = to the end */
+	uint64_t size;
+};
+
+/* ---- msm constants used above (values of msm_drm.h) ---- */
+
+#define SWEET_MSM_PIPE_3D0              0x10
+
+#define SWEET_MSM_PARAM_GPU_ID          0x01    /* 630 */
+#define SWEET_MSM_PARAM_GMEM_SIZE       0x02    /* 0x100000 */
+#define SWEET_MSM_PARAM_CHIP_ID         0x03    /* 0x06030001 */
+#define SWEET_MSM_PARAM_MAX_FREQ        0x04    /* 710000000 (the GPU runs at 257 MHz until DCVS is implemented) */
+#define SWEET_MSM_PARAM_TIMESTAMP       0x05    /* CP_ALWAYS_ON_COUNTER, 19.2 MHz */
+#define SWEET_MSM_PARAM_GMEM_BASE       0x06    /* 0x100000 */
+#define SWEET_MSM_PARAM_PRIORITIES      0x07    /* 1 */
+#define SWEET_MSM_PARAM_PP_PGTABLE      0x08    /* 0: one address space for everybody */
+#define SWEET_MSM_PARAM_FAULTS          0x09    /* 0 */
+#define SWEET_MSM_PARAM_SUSPENDS        0x0a    /* 0 */
+#define SWEET_MSM_PARAM_VA_START        0x0e    /* 0x80000000 */
+#define SWEET_MSM_PARAM_VA_SIZE         0x0f    /* 0x80000000 */
+
+#define SWEET_MSM_BO_SCANOUT            0x00000001
+#define SWEET_MSM_BO_GPU_READONLY       0x00000002
+
+#define SWEET_MSM_INFO_GET_OFFSET       0       /* value = handle: the memoryType for IOConnectMapMemory64 */
+#define SWEET_MSM_INFO_GET_IOVA         1
+#define SWEET_MSM_INFO_SET_NAME         2       /* accepted, ignored */
+#define SWEET_MSM_INFO_SET_IOVA         4       /* only before the BO was ever submitted; range must be free, 4 KiB aligned */
+#define SWEET_MSM_INFO_GET_FLAGS        5
+
+#define SWEET_MSM_PREP_READ             0x01
+#define SWEET_MSM_PREP_WRITE            0x02
+#define SWEET_MSM_PREP_NOSYNC           0x04
+
+#define SWEET_MSM_SUBMIT_CMD_BUF        1
+#define SWEET_MSM_SUBMIT_CMD_CTX_RESTORE_BUF 2
+#define SWEET_MSM_SUBMIT_CMD_PRIMARY    3
+
+#define SWEET_MSM_SUBMIT_BO_READ        0x0001
+#define SWEET_MSM_SUBMIT_BO_WRITE       0x0002
+#define SWEET_MSM_SUBMIT_BO_DUMP        0x0004
+#define SWEET_MSM_SUBMIT_BO_NO_IMPLICIT 0x0008
+
+#define SWEET_MSM_SUBMIT_NO_IMPLICIT    0x80000000u
+
+#endif /* SWEET_ADRENO_ABI_H */
