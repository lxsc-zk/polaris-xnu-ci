+/*
+ * Read-only GPU probe for the OnePlus 6T (SDM845 / Adreno 630).
+ *
+ * Stage 1 of the ladder used by oosexgang/hackios-xnu-kernel
+ * (bsd/dev/redwood_adreno.c): nothing here writes a register, so the only
+ * risk is reading a block whose clock is off. Every block is announced before
+ * it is touched, so a hang names the block. Boot-arg adreno=1.
+ *
+ * Addresses come from the vendor device tree (dtb/fajita2.dts):
+ *   qcom,kgsl-3d0@5000000  reg = <0x5000000 0x40000 0x5061000 0x800 0x509e000 0x1000>
+ *                          qcom,chipid = <0x6030001>
+ *   qcom,kgsl-smmu-v2      reg = <0x5040000 0x10000>
+ *   qcom,gpu-gmu           reg = <0x506a000 0x30000 0xb200000 0x300000>
+ *   qcom,gpucc@5090000     reg = <0x5090000 0x9000>
+ *   gpu_region@0x8c415000  zap memory, 0x2000
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
