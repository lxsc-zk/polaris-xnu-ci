+struct sweet_gpu_gem_new {
+	uint32_t size;
+	uint32_t flags;
+	uint32_t handle;                /* out */
+	uint32_t iova;                  /* out */
+};
+
+struct sweet_gpu_gem_info {
+	uint32_t handle;
+	uint32_t op;
+	uint32_t value;                 /* out */
+	uint32_t pad;
+};
+
+struct sweet_gpu_gem_submit {
+	uint32_t handle;                /* the command buffer BO */
+	uint32_t offset;
+	uint32_t dwords;
+	uint32_t fence;                 /* out */
+};
+
+struct sweet_gpu_wait {
+	uint32_t fence;
+	uint32_t timeout_ms;
+	uint32_t pad[2];
+};
+
+struct sweet_gpu_select {
+	uint32_t handle;
+	uint32_t pad;
+};
+
+struct sweet_gpu_close {
+	uint32_t handle;
+	uint32_t pad;
+};
+
+/*
+ * The command word carries the struct size, otherwise sys_ioctl copies nothing and a
+ * handler would read the caller's pointer value as a struct.
+ */
+#define SWEET_GPU_IOCTL_INFO       _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_INFO_N, struct sweet_gpu_info)
+#define SWEET_GPU_IOCTL_GEM_NEW    _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_GEM_NEW_N, struct sweet_gpu_gem_new)
+#define SWEET_GPU_IOCTL_GEM_INFO   _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_GEM_INFO_N, struct sweet_gpu_gem_info)
+#define SWEET_GPU_IOCTL_SELECT     _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_SELECT_N, struct sweet_gpu_select)
+#define SWEET_GPU_IOCTL_GEM_SUBMIT _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_SUBMIT_N, struct sweet_gpu_gem_submit)
+#define SWEET_GPU_IOCTL_WAIT_FENCE _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_WAIT_N, struct sweet_gpu_wait)
+#define SWEET_GPU_IOCTL_GEM_CLOSE  _IOWR(SWEET_GPU_IOC_GROUP, SWEET_GPU_IOC_CLOSE_N, struct sweet_gpu_close)
+
+struct gpu_bo {
+	vm_offset_t kva;        /* the kernel alias, write-combined */
+	uint64_t pa;
+	vm_size_t size;
+	uint32_t va;            /* the GPU address */
+	uint32_t handle;        /* what the ABI returns to the client */
+	bool used;
+};
+
+static struct gpu_bo gpu_bos[GPU_BO_MAX];
+static uint32_t gpu_va_next;         /* bump allocator, one guard page, no reuse */
+static uint32_t next_handle = 1;
+
+/*
+ * The buffer arena (a payload blob), mapped in windows. ml_io_map() maps the whole size with one
+ * kmem_alloc(), and this port's kernel_map has no hole anywhere near the arena's size (the largest
+ * mapping that ever worked here is 1 MiB), so the arena is a list of windows and every buffer stays
+ * inside one of them - that keeps its kernel alias contiguous.
+ */
+#define GPU_ARENA_WINDOWS      128u
+static vm_offset_t gpu_arena_windows[GPU_ARENA_WINDOWS];
+static uint32_t gpu_arena_window_bytes;     /* one window: 1 MiB, the mapping known to work */
+static uint32_t gpu_arena_mapped_bytes;     /* how much of the arena has a kernel alias at all */
+static uint64_t gpu_arena_pa;
+static uint32_t gpu_arena_size;
+static uint32_t gpu_arena_used;
+
+/* GPU address space (stage 8f): all of L1[2], first fit, a guard page between buffers. */
+#define GPU_VA_BYTES       0x40000000ull        /* 1 GiB */
+#define GPU_VA_EXTENTS     32u
+#define GPU_PTE_TABLES     512u                 /* 2 MiB each: the whole 1 GiB client range */
+
+struct gpu_va_extent {
+	uint64_t off;                                   /* from GPU_VA_BASE */
+	uint64_t size;
+};
+
+static struct gpu_va_extent gpu_va_free[GPU_VA_EXTENTS];
+
+/* Pool of L3 tables from the sweetfw3 blob, and which L2 slot each one serves. */
+static vm_offset_t gpu_pte_pool;
+static uint64_t gpu_pte_pool_pa;
+static uint32_t gpu_pte_tables;
+static uint32_t gpu_pte_l2i[GPU_PTE_TABLES];
+static uint32_t gpu_pte_off[GPU_PTE_TABLES];
+static uint32_t gpu_pte_used;
+static vm_offset_t gpu_smmu;    /* SMMU base, for TLB invalidation after PTE changes */
+
+static void gpu_tlb_invalidate(void);
+
+
+/* State the driver needs after the bring-up function returns. */
+static vm_offset_t gpu_blob;
+static vm_offset_t gpu_core;
+static bool gpu_live;
+static uint32_t gpu_last_fence;
+static vm_offset_t gpu_pt_blob;      /* where the page tables live */
+
+/*
+ * Arena blocks. bgmtl-adddev runs several times per boot (launchd restarts it after each crash) and
+ * every run used to leak its buffers, which filled the 40 MiB arena in five goes; a freed block is
+ * now handed out again. First fit, no splitting, no coalescing - the workloads are few and chunky.
+ */
+#define GPU_ARENA_BLOCKS       512u
+static struct gpu_arena_block {
+	uint32_t off;
+	uint32_t size;
+	bool used;
+} gpu_arena_blocks[GPU_ARENA_BLOCKS];
+
+static void
+gpu_arena_give_back(uint32_t off, uint32_t size)
+{
+	for (unsigned i = 0; i < GPU_ARENA_BLOCKS; i++) {
+		if (gpu_arena_blocks[i].used && gpu_arena_blocks[i].off == off &&
+		    gpu_arena_blocks[i].size == size) {
+			gpu_arena_blocks[i].used = false;
+			return;
+		}
+	}
+}
+
+/* Reserve SZ bytes: a freed block of that size or larger, else the bump pointer. */
+static bool
+gpu_arena_take(uint32_t sz, uint32_t *off)
+{
+	for (unsigned i = 0; i < GPU_ARENA_BLOCKS; i++) {
+		if (gpu_arena_blocks[i].size == 0) {
+			continue;
+		}
+		if (!gpu_arena_blocks[i].used && gpu_arena_blocks[i].size >= sz) {
+			gpu_arena_blocks[i].used = true;
+			*off = gpu_arena_blocks[i].off;
+			return true;
+		}
+	}
+	uint32_t o = (gpu_arena_used + 0xfffu) & ~0xfffu;
+	if ((uint64_t)o + sz > gpu_arena_size) {
+		return false;
+	}
+	for (unsigned i = 0; i < GPU_ARENA_BLOCKS; i++) {
+		if (gpu_arena_blocks[i].size == 0) {
+			gpu_arena_blocks[i].off = o;
+			gpu_arena_blocks[i].size = sz;
+			gpu_arena_blocks[i].used = true;
+			gpu_arena_used = o + sz;
+			*off = o;
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The kernel alias of an offset in the arena; every buffer lives inside one window. */
+static vm_offset_t
+gpu_arena_kva(uint32_t off)
+{
+	uint32_t w = off / gpu_arena_window_bytes;
+
+	if (gpu_arena_window_bytes == 0 || w >= GPU_ARENA_WINDOWS || off >= gpu_arena_mapped_bytes) {
+		return 0;
+	}
+	return gpu_arena_windows[w] + (off % gpu_arena_window_bytes);
+}
+
+static bool
+gpu_bo_init(vm_offset_t blob)
+{
+	char arg[64];
+	uint64_t pa = 0, size = 0;
+
+	gpu_pt_blob = blob;
+	gpu_va_next = GPU_VA_BASE;
+	gpu_arena_used = 0;
+	for (unsigned i = 0; i < GPU_BO_MAX; i++) {
+		gpu_bos[i].used = false;
+	}
+	if (!PE_parse_boot_argn("sweetfw2", arg, sizeof(arg)) ||
+	    !gpu_parse_range(arg, &pa, &size) || size < GPU_ARENA_BYTES || size > GPU_ARENA_MAX_BYTES) {
+		printf("SWEET GPU: no sweetfw2 arena of %u KiB..%u MiB (got %llu); buffers unavailable\n",
+		    GPU_ARENA_BYTES / 1024, GPU_ARENA_MAX_BYTES >> 20, (unsigned long long)size);
+		return false;
+	}
+	/*
+	 * The blob's size is the arena's size: Metal asks freedreno for buffers, textures and shader
+	 * storage of many MiB, and this is the only memory here the pmap does not have to touch (the
+	 * port's free lists hold pages below gPhysBase and pmap panics on those).
+	 */
+	gpu_arena_pa = pa;
+	gpu_arena_size = (uint32_t)size;
+	{
+		/*
+		 * 1 MiB is the largest mapping that has ever succeeded in this port, and sizes must not be
+		 * probed: kmem_alloc() panics on failure here (__kmem_failed_panic), so asking for 16 MiB to
+		 * see whether it works kills the boot. Buffers larger than a window get no kernel alias at
+		 * all (see sweet_gpu_alloc_pages) - the client maps them itself and the GPU reaches them by
+		 * physical address.
+		 */
+		/*
+		 * One mapping for the whole arena: with IO_MAP_SIZE raised (osfmk/arm/io_map.c) the IOKit
+		 * submap holds it, so every buffer gets a contiguous kernel alias and relocation patching
+		 * works for command buffers of any size.
+		 */
+		gpu_arena_window_bytes = gpu_arena_size;
+		gpu_arena_windows[0] = ml_io_map((vm_offset_t)pa, (vm_size_t)gpu_arena_size);
+		if (gpu_arena_windows[0] == 0) {
+			printf("SWEET GPU: cannot map the %u KiB arena\n", gpu_arena_size / 1024);
+			gpu_arena_window_bytes = 0;
+			return false;
+		}
+		gpu_arena_mapped_bytes = gpu_arena_size;
+		printf("SWEET GPU: buffer arena %u KiB at %#llx, mapped whole\n",
+		    gpu_arena_size / 1024, (unsigned long long)pa);
+	}
+
+	/*
+	 * How much contiguous VA kernel_map can give, asked without panicking: kmem_alloc() panics on
+	 * failure in this port, vm_allocate() does not. Logged, freed immediately, boot continues.
+	 */
+	{
+		extern kern_return_t vm_allocate(vm_map_t, vm_offset_t *, vm_size_t, int);
+		extern kern_return_t vm_deallocate(vm_map_t, vm_offset_t, vm_size_t);
+		static const uint32_t sizes[] = { 1u << 20, 2u << 20, 4u << 20, 8u << 20,
+			16u << 20, 32u << 20, 64u << 20 };
+		for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) {
+			vm_offset_t addr = 0;
+			kern_return_t kr = vm_allocate(kernel_map, &addr, sizes[i], VM_FLAGS_ANYWHERE);
+			printf("SWEET VM: vm_allocate %u MiB -> %d (%s)\n", sizes[i] >> 20, kr,
+			    kr == KERN_SUCCESS ? "ok" : "no");
+			if (kr == KERN_SUCCESS) {
+				vm_deallocate(kernel_map, addr, sizes[i]);
+			}
+		}
+	}
+
+	/* The page-table pool and the client address space. */
+	if (!PE_parse_boot_argn("sweetfw3", arg, sizeof(arg)) ||
+	    !gpu_parse_range(arg, &pa, &size) || size < (uint64_t)GPU_PTE_TABLES * 0x1000) {
+		printf("SWEET GPU: no sweetfw3 page-table pool; vm_map will refuse\n");
+		gpu_pte_pool = 0;
+		gpu_pte_tables = 0;
+	} else {
+		gpu_pte_pool = ml_io_map((vm_offset_t)pa, GPU_PTE_TABLES * 0x1000);
+		gpu_pte_pool_pa = pa;
+		gpu_pte_tables = GPU_PTE_TABLES;
+		printf("SWEET GPU: %u page tables (%u MiB mappable) at %#llx\n",
+		    gpu_pte_tables, gpu_pte_tables * 2, (unsigned long long)pa);
+	}
+	gpu_va_free[0].off = 0;
+	gpu_va_free[0].size = GPU_VA_BYTES;
+	for (unsigned i = 1; i < GPU_VA_EXTENTS; i++) {
+		gpu_va_free[i].size = 0;
+	}
+	return true;
+}
+
+/*
+ * Map [va, va+size) to [pa, pa+size) in the client range. Only the first 2 MiB are
+ * covered: that is the single L3 the payload provides (0149), and a pool comes
+ * with the ABI patch.
+ */
+static bool
+gpu_pt_map(uint32_t va, uint64_t pa, vm_size_t size)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)(gpu_pt_blob + GPU_GMEM_L1);
+	volatile uint64_t *l2 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L2);
+	volatile uint64_t *l3 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L3);
+	uint32_t l1i = (va >> 30) & 0x1ff;
+	uint32_t l2i = (va >> 21) & 0x1ff;
+
+	if (l2i != 0) {
+		printf("SWEET GPU: bo va %#x is past the first 2 MiB of the client range\n", va);
+		return false;
+	}
+	if ((l1[l1i] & 3) != GPU_PTE_TABLE) {
+		printf("SWEET GPU: bo va %#x: L1[%u] is not a table\n", va, l1i);
+		return false;
+	}
+	if ((l2[l2i] & 3) != GPU_PTE_TABLE) {
+		printf("SWEET GPU: bo va %#x: L2[%u] is not a table\n", va, l2i);
+		return false;
+	}
+	for (vm_size_t o = 0; o < size; o += 0x1000) {
+		l3[((va + o) >> 12) & 0x1ff] = (pa + o) | GPU_PTE_PAGE;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_tlb_invalidate();
+	return true;
+}
+
+/*
+ * Buffers live in a blob from the payload: contiguous, never touched by the pmap,
+ * reached uncached through ml_io_map - the same memory the GMU firmware, the ring,
+ * the SQE and the page tables come from, all of which the CP reads and writes
+ * through the SMMU.
+ */
+static struct gpu_bo *
+gpu_bo_alloc(vm_size_t size)
+{
+	struct gpu_bo *bo = NULL;
+
+	size = round_page(size);
+	if (size == 0 || size > GPU_BO_MAX_BYTES || gpu_arena_window_bytes == 0) {
+		return NULL;
+	}
+	for (unsigned i = 0; i < GPU_BO_MAX; i++) {
+		if (!gpu_bos[i].used) {
+			bo = &gpu_bos[i];
+			break;
+		}
+	}
+	if (bo == NULL) {
+		printf("SWEET GPU: bo: out of descriptors\n");
+		return NULL;
+	}
+	if (gpu_arena_used + size > gpu_arena_size) {
+		printf("SWEET GPU: bo: %lu bytes do not fit the %u KiB arena (%u used)\n",
+		    (unsigned long)size, gpu_arena_size / 1024, gpu_arena_used);
+		return NULL;
+	}
+
+	/*
+	 * Keep the buffer inside one window: its kernel alias must be contiguous. A buffer larger than
+	 * a window has to start at a window boundary and is refused if it does not fit.
+	 */
+	uint32_t off = gpu_arena_used;
+	if ((off % gpu_arena_window_bytes) + size > gpu_arena_window_bytes) {
+		off = ((off + gpu_arena_window_bytes - 1) / gpu_arena_window_bytes) * gpu_arena_window_bytes;
+	}
+	if ((uint64_t)off + size > gpu_arena_mapped_bytes || off + size > gpu_arena_size) {
+		printf("SWEET GPU: bo: %lu bytes do not fit a %u KiB window (%u used of %u)\n",
+		    (unsigned long)size, gpu_arena_window_bytes / 1024, off, gpu_arena_size);
+		return NULL;
+	}
+	gpu_arena_used = off + size;
+	volatile uint32_t *zero = (volatile uint32_t *)gpu_arena_kva(off);
+	for (uint32_t i = 0; i < size / 4; i++) {
+		zero[i] = 0;
+	}
+
+	bo->kva = gpu_arena_kva(off);
+	bo->pa = gpu_arena_pa + off;
+	bo->size = size;
+	bo->va = gpu_va_next;
+	bo->handle = next_handle++;
+	bo->used = true;
+	gpu_va_next += size + 0x1000;   /* one unmapped guard page between buffers */
+
+	if (!gpu_pt_map(bo->va, bo->pa, size)) {
+		bo->used = false;
+		return NULL;
+	}
+	printf("SWEET GPU: bo: %lu bytes arena+%#x pa %#llx va %#x handle %u\n",
+	    (unsigned long)size, off, (unsigned long long)bo->pa, bo->va, bo->handle);
+	return bo;
+}
+
+static void
+gpu_bo_free(struct gpu_bo *bo)
+{
+	if (bo == NULL || !bo->used) {
+		return;
+	}
+	volatile uint64_t *l3 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L3);
+
+	for (vm_size_t o = 0; o < bo->size; o += 0x1000) {
+		l3[((bo->va + o) >> 12) & 0x1ff] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_tlb_invalidate();
+	printf("SWEET GPU: bo: freed va %#x handle %u (%lu bytes)\n", bo->va, bo->handle,
+	    (unsigned long)bo->size);
+	bo->used = false;
+}
+
+/* stage 7c: the zap shader through SCM (PAS id 13) */
+#define GPU_ZAP_BASE           0x25000u   /* offset inside the blob */
+#define GPU_ZAP_BYTES          0x3000u    /* .mdt 0x25000, b02 segment 0x27000 */
+#define GPU_ZAP_MDT            (GPU_ZAP_BASE + 0x0000u)
+#define GPU_ZAP_SEG            (GPU_ZAP_BASE + 0x2000u)
+#define GPU_ZAP_MDT_MAX        0x2000u
+#define ZAP_REGION_PA          0x8c415000ull   /* fajita DT gpu_region, no-map, 0x2000 */
+#define ZAP_REGION_SIZE        0x2000u
+
+#define SCM_SIP                0x02000000u
+#define SCM_64                 0x40000000u
+#define SCM_FAST               0x80000000u
+#define SCM_INFO_AVAIL         (SCM_SIP | 0x0601u)
+#define SCM_PAS_GPU            13u
+#define SCM_INTERRUPTED        1
+#define SCM_BUSY               (-12)
+#define SCM_RESUME_LIMIT       64u
+#define SCM_BUSY_LIMIT         3u
+#define MDT_MAX_PHDRS          16u
+#define MDT_PT_LOAD            1u
+#define MDT_TYPE_MASK          (7u << 24)
+#define MDT_TYPE_HASH          (2u << 24)
+#define MDT_RELOCATABLE        (1u << 27)
+#define GPU_GMU_SPTPRAC_STATUS 0x14340u  /* 0x50d0 */
+#define GPU_GMU_BOOT_SLUMBER  0x8fe0u   /* 0x23f8 */
+#define GPU_GMU_GX_VOTE_IDX   0x8fe4u   /* 0x23f9 */
+#define GPU_GMU_MX_VOTE_IDX   0x8fe8u   /* 0x23fa */
+#define GPU_OOB_BOOT_SLUMBER  6u        /* set bit 22, ack bit 30 */
+#define GPU_RSCC(off)         (0x23000u + 4u * (off))
+#define GPU_PDCR(off)         (4u * (off))
+
+#define GPU_SMMU_MICRO_MMU_CTRL 0x6000u
+#define GPU_SMMU_MICRO_HALT     (1u << 2)
+#define GPU_SMMU_MICRO_IDLE     (1u << 3)
+#define GPU_GMU_HFI_SFR       0x14608u      /* 0x5182: which GPU this is */
+#define GPU_GMU_HFI_QTBL_INFO 0x14610u      /* 0x5184 */
+#define GPU_GMU_HFI_QTBL_ADDR 0x14614u      /* 0x5185: the HFI table, 32 bits */
+#define GPU_GMU_PWR_COL_CP_MSG 0x14400u     /* 0x5100: where the log is, and its pages - 1 */
+#define GPU_GMU_PWR_COL_CP_RESP 0x14404u    /* 0x5101 */
+#define GPU_GMU_AHB_FENCE_RANGE 0x24c44u    /* 0x9311 */
+#define GPU_GMU_SYS_BUS_CONFIG 0x1303cu     /* 0x4c0f */
+#define GPU_GMU_ICACHE_CONFIG  0x13000u     /* 0x4c00 */
+#define GPU_GMU_DCACHE_CONFIG  0x13004u     /* 0x4c01 */
+#define GPU_GMU_RPMH_CTRL      0x143a0u     /* 0x50e8 */
+#define GPU_GMU_FW_RUNNING     0xbabefaceu  /* FW_INIT_RESULT once a630's firmware runs */
+#define GPU_GMU_CHIPID         0x06030100u  /* 0x06030001 massaged the way the GMU wants it */
+
+/* The low bank: DRAM the ADT does not declare (it starts at 0x100000000) and
+ * whose reserved-memory carve-outs all end below 0xac800000. */
+#define GPU_SCRATCH_PA         0x0b000000u
+#define GPU_SCRATCH_HFI        0x0000u      /* table and two queues, 12 KB */
+#define GPU_SCRATCH_LOG        0x3000u      /* one page of firmware log, inside the same 16 KB */
+
+static void
+gpu_probe_wr(const char *what, vm_offset_t base, uint32_t off, uint32_t val)
+{
+	printf("SWEET GPU: write %s +%#x = %#x\n", what, off, val);
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+gpu_wait_ms(unsigned ms)
+{
+	/* short, bounded waits: busy delay, no scheduler involvement */
+	delay(ms * 1000u);
+}
+
+/*
+ * A rewritten (or cleared) PTE is invisible to the CP until its TLB forgets the old entry, and
+ * the GPU caches the walk. Every place that touches a PTE calls this: the chardev map/free and
+ * the IOKit map/unmap. Same sequence the boot uses: both contexts, status polled, then the
+ * global non-secure invalidate.
+ */
+static void
+gpu_tlb_invalidate(void)
+{
+	if (gpu_smmu == 0) {
+		gpu_smmu = ml_io_map(GPU_SMMU, 0x10000);
+		if (gpu_smmu == 0) {
+			return;
+		}
+	}
+	for (unsigned c = 0; c < 2; c++) {
+		vm_offset_t b = gpu_smmu + GPU_SMMU_CB(c);
+		gpu_wr_quiet(b, GPU_SMMU_CB_TLBIALL, 0);
+		for (int i = 0; i < 100; i++) {
+			if (!(gpu_rd_quiet(b, GPU_SMMU_CB_TLBSTATUS) & 1u)) {
+				break;
+			}
+			gpu_wait_ms(1);
+		}
+	}
+	gpu_wr_quiet(gpu_smmu, GPU_SMMU_TLBIALLNSNH, 0);
+	for (int i = 0; i < 100; i++) {
+		if (!(gpu_rd_quiet(gpu_smmu, GPU_SMMU_sTLBGSTATUS) & 1u)) {
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* ---- the GMU's own memory ------------------------------------------------- */
+
+/*
+ * The HFI table and the log the firmware uses. HFI_QTBL_ADDR is a 32-bit
+ * register and all of the kernel's memory is above 4 GB (the ADT starts at
+ * 0x100000000), so they go into the low bank: Linux reports
+ * 0x97d00000-0x27c89ffff as one System RAM range across the 4 GB boundary, and
+ * console50 read 0xb0000000 from XNU without trouble.
+ *
+ * It is all prepared here, before the GPU is powered: console49 read the same
+ * address after the power-on, the clock writes and the firmware load, and died
+ * on it.
+ */
+struct hfi_queue_header {
+	uint32_t status, iova, type, size, msg_size, dropped;
+	uint32_t rx_watermark, tx_watermark, rx_request, tx_request, read_index, write_index;
+};
+struct hfi_table_header {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
+};
+
+static vm_offset_t gpu_log_va;
+static uint32_t gpu_hfi_pa, gpu_log_pa;
+static bool gpu_scratch_ready;
+static bool gpu_kept_up;        /* stage 8: leave the GPU powered and the ring live */
+
+static void
+gpu_scratch_prepare(void)
+{
+	vm_offset_t hfi = ml_io_map(GPU_SCRATCH_PA + GPU_SCRATCH_HFI, 0x4000);
+	vm_offset_t log = hfi == 0 ? 0 : hfi + GPU_SCRATCH_LOG;   /* inside the same mapping */
+
+	printf("SWEET GPU: scratch: hfi at %#x -> %#llx, log at %#x -> %#llx\n",
+	    GPU_SCRATCH_PA + GPU_SCRATCH_HFI, (uint64_t)hfi,
+	    GPU_SCRATCH_PA + GPU_SCRATCH_LOG, (uint64_t)log);
+	if (hfi == 0 || log == 0) {
+		printf("SWEET GPU: cannot map the GMU's scratch memory\n");
+		return;
+	}
+	printf("SWEET GPU: hfi scratch reads %#x\n", *(volatile uint32_t *)hfi);
+	printf("SWEET GPU: log scratch reads %#x\n", *(volatile uint32_t *)log);
+
+	for (uint32_t off = 0; off < 0x4000; off += 4) {
+		*(volatile uint32_t *)(hfi + off) = 0;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+
+	volatile struct hfi_table_header *const table = (volatile struct hfi_table_header *)hfi;
+	volatile struct hfi_queue_header *const queue =
+	    (volatile struct hfi_queue_header *)(hfi + sizeof(*table));
+
+	table->version = 0;
+	table->size = sizeof(*table) + 2 * sizeof(*queue);
+	table->qhdr0_offset = sizeof(*table) / 4;
+	table->qhdr_size = sizeof(*queue) / 4;
+	table->num_queues = 2;
+	table->active_queues = 2;
+	for (uint32_t i = 0; i < 2; i++) {
+		queue[i].status = 1;
+		queue[i].iova = GPU_SCRATCH_PA + GPU_SCRATCH_HFI + 0x1000 * (i + 1);
+		queue[i].type = (10u << 8) | (i == 0 ? 0u : 4u);   /* 4: a630's legacy response queue */
+		queue[i].size = 0x1000 / 4;
+		queue[i].rx_watermark = 1;
+		queue[i].tx_watermark = 1;
+		queue[i].rx_request = 1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	printf("SWEET GPU: hfi table at %#x: %#x %#x %#x %#x %#x %#x, queue0 %#x %#x %#x\n",
+	    GPU_SCRATCH_PA + GPU_SCRATCH_HFI, table->version, table->size, table->qhdr0_offset,
+	    table->qhdr_size, table->num_queues, table->active_queues, queue[0].status,
+	    queue[0].iova, queue[0].type);
+
+	gpu_log_va = log;
+	gpu_hfi_pa = GPU_SCRATCH_PA + GPU_SCRATCH_HFI;
+	gpu_log_pa = GPU_SCRATCH_PA + GPU_SCRATCH_LOG;
+	gpu_scratch_ready = true;
+}
+
+/* ---- stage 5 prep: the command DB, the PDC and the RSC ---------------- */
+
+static vm_offset_t gpu_cmddb;
+
+static uint32_t
+gpu_db32(uint32_t off)
+{
+	return gpu_rd_quiet(gpu_cmddb, off & ~3u);
+}
+
+static uint16_t
+gpu_db16(uint32_t off)
+{
+	return (uint16_t)(gpu_db32(off) >> (8u * (off & 3u)));
+}
+
+static bool
+gpu_db_range(uint32_t off, uint32_t size)
+{
+	return off <= GPU_CMDDB_BYTES && size <= GPU_CMDDB_BYTES - off;
+}
+
+/*
+ * Find a resource in the command DB. Returns its slave type (3 ARC) or -1 and
+ * writes the ARC address plus its u16 level table.
+ */
+static int
+gpu_cmddb_lookup(const char *res, uint32_t *address, uint16_t *vals, unsigned max)
+{
+	uint32_t key[2] = { 0, 0 };
+	unsigned matches = 0, kind = 0;
+
+	if (gpu_cmddb == 0) {
+		gpu_cmddb = ml_io_map(GPU_CMDDB_PA, GPU_CMDDB_BYTES);
+		if (gpu_cmddb == 0) {
+			printf("SWEET GPU: cannot map the command DB\n");
+			return -1;
+		}
+		if (gpu_db32(4) != GPU_CMDDB_MAGIC || gpu_db32(0) != 1) {
+			printf("SWEET GPU: command DB at %#x: version %#x magic %#x not usable\n",
+			    GPU_CMDDB_PA, gpu_db32(0), gpu_db32(4));
+			return -1;
+		}
+	}
+	for (unsigned i = 0; i < 8 && res[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = gpu_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = GPU_CMDDB_HEADER + gpu_db16(h + 2);
+		uint32_t aux = GPU_CMDDB_HEADER + gpu_db16(h + 4);
+		unsigned count = gpu_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !gpu_db_range(entries, count * GPU_CMDDB_ENTRY)) {
+			printf("SWEET GPU: command DB: malformed slave header %u\n", i);
+			return -1;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + GPU_CMDDB_ENTRY * j;
+			if (gpu_db32(e) != key[0] || gpu_db32(e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = gpu_db32(e + 16), off = aux + gpu_db16(e + 22);
+			uint32_t len = gpu_db16(e + 20);
+			if (!gpu_db_range(off, len)) {
+				return -1;
+			}
+			if (slave == GPU_CMDDB_SLAVE_ARC && vals) {
+				for (unsigned k = 0; k < max; k++) {
+					vals[k] = k < len / 2 ? gpu_db16(off + 2 * k) : 0;
+				}
+			}
+			*address = addr;
+			kind = slave;
+			matches++;
+		}
+	}
+	return matches == 1 ? (int)kind : -1;
+}
+
+/* a PDC TCS command: message id 0x10108, the ARC address, the trigger. */
+static void
+gpu_pdc_tcs_cmd(vm_offset_t cfg, uint32_t msgid0, unsigned n, uint32_t addr, uint32_t data)
+{
+	uint32_t r = msgid0 + n * GPU_PDC_CMD_OFFSET;
+	gpu_wr_quiet(cfg, GPU_PDCR(r), 0x10108u);
+	gpu_wr_quiet(cfg, GPU_PDCR(r + 1), addr);
+	gpu_wr_quiet(cfg, GPU_PDCR(r + 2), data);
+}
+
+/* a6xx_gmu_rpmh_init for a630: RSC handshake and sequencer, PDC and its TCSes. */
+static bool
+gpu_rpmh_ucode(vm_offset_t gmu)
+{
+	static const uint32_t rsc_seq[5] = { 0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u };
+	static const uint32_t pdc_seq[5] = { 0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu };
+	uint32_t mx = 0x30010u, cx = 0x30000u, gfx = 0x30080u, a = 0;
+	uint16_t lv[16];
+	vm_offset_t cfg = ml_io_map(GPU_PDC_CFG_PA, GPU_PDC_BYTES);
+	vm_offset_t seq = ml_io_map(GPU_PDC_SEQ_PA, GPU_PDC_BYTES);
+
+	if (cfg == 0 || seq == 0) {
+		printf("SWEET GPU: cannot map the PDC\n");
+		return false;
+	}
+	/* Not static: these entries hold the addresses of three locals. */
+	const struct { const char *name; uint32_t *addr; uint32_t linux; } arcs[] = {
+		{ "mx.lvl", &mx, 0x30010u }, { "cx.lvl", &cx, 0x30000u }, { "gfx.lvl", &gfx, 0x30080u },
+	};
+	for (unsigned i = 0; i < 3; i++) {
+		if (gpu_cmddb_lookup(arcs[i].name, &a, lv, 16) == (int)GPU_CMDDB_SLAVE_ARC && a) {
+			*arcs[i].addr = a;
+		}
+		printf("SWEET GPU: pdc %s address %#x%s\n", arcs[i].name, *arcs[i].addr,
+		    *arcs[i].addr == arcs[i].linux ? " (as Linux a630)" : " (cmd-db)");
+	}
+
+	gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_RSC_STATUS0), 1u << 24);   /* no SDE clock gating */
+	gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_PDC_SLAVE_ID), 1);
+	for (unsigned i = 0; i < 3; i++) {
+		gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_HIDDEN_DATA + i * GPU_RSC_CMD_OFFSET),
+		    i == 2 ? 0x80000000u : 0u);
+		gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_HIDDEN_ADDR + i * GPU_RSC_CMD_OFFSET), 0);
+	}
+	gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_OVERRIDE), 0);
+	gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_PDC_SEQ_START), 0x4520u);
+	gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_MATCH_LO), 0x4510u);
+	gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_MATCH_HI), 0x4514u);
+	for (unsigned i = 0; i < 5; i++) {
+		gpu_wr_quiet(gmu, GPU_RSCC(GPU_RSCC_SEQ_MEM + i), rsc_seq[i]);
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		gpu_wr_quiet(seq, GPU_PDCR(i), pdc_seq[i]);
+	}
+	gpu_wr_quiet(cfg, GPU_PDCR(0x1573u), 7);            /* TCS1 enable bank */
+	gpu_wr_quiet(cfg, GPU_PDCR(0x1574u), 0);
+	gpu_wr_quiet(cfg, GPU_PDCR(0x1572u), 0);
+	gpu_pdc_tcs_cmd(cfg, 0x1575u, 0, mx, 1);
+	gpu_pdc_tcs_cmd(cfg, 0x1575u, 1, cx, 0);
+	gpu_pdc_tcs_cmd(cfg, 0x1575u, 2, gfx, 0);
+	gpu_wr_quiet(cfg, GPU_PDCR(0x15d7u), 7);            /* TCS3 enable bank */
+	gpu_wr_quiet(cfg, GPU_PDCR(0x15d8u), 0);
+	gpu_wr_quiet(cfg, GPU_PDCR(0x15d6u), 0);
+	gpu_pdc_tcs_cmd(cfg, 0x15d9u, 0, mx, 2);
+	gpu_pdc_tcs_cmd(cfg, 0x15d9u, 1, cx, 3);
+	gpu_pdc_tcs_cmd(cfg, 0x15d9u, 2, gfx, 3);
+	gpu_wr_quiet(cfg, GPU_PDCR(0x1148u), 0);
+	gpu_wr_quiet(cfg, GPU_PDCR(0x1140u), 0x80000001u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET GPU: pdc and rsc microcode written (mx %#x, cx %#x, gfx %#x)\n", mx, cx, gfx);
+	return true;
+}
+
+/* a6xx_rpmh_start: wake the GPU's RSC; a failure is logged, not fatal. */
+static void
+gpu_rpmh_start(vm_offset_t gmu)
+{
+	gpu_wr_quiet(gmu, GPU_GMU_RSCC_REQ, 1u << 1);
+	bool ack = false, idle = false;
+	for (int i = 0; i < 100; i++) {
+		if (gpu_rd_quiet(gmu, GPU_GMU_RSCC_ACK) & (1u << 1)) {
+			ack = true;
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	for (int i = 0; i < 100; i++) {
+		if ((gpu_rd_quiet(gmu, GPU_RSCC(GPU_RSCC_SEQ_BUSY)) & 0xffffffffu) == 0) {
+			idle = true;
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	gpu_wr_quiet(gmu, GPU_GMU_RSCC_REQ, 0);
+	printf("SWEET GPU: rsc wake: ack=%d sequencer idle=%d (ack %#x busy %#x)\n", ack, idle,
+	    gpu_rd_quiet(gmu, GPU_GMU_RSCC_ACK), gpu_rd_quiet(gmu, GPU_RSCC(GPU_RSCC_SEQ_BUSY)));
+}
+
+/* ---- stage 7: the CP's hardware initialisation ------------------------- */
+
+static uint32_t
+gpu_cp_rd(vm_offset_t core, uint32_t dword)
+{
+	return gpu_rd_quiet(core, 4u * dword);
+}
+
+static void
+gpu_cp_wr(vm_offset_t core, uint32_t dword, uint32_t val)
+{
+	gpu_wr_quiet(core, 4u * dword, val);
+}
+
+static void
+gpu_cp_wr64(vm_offset_t core, uint32_t dword, uint64_t val)
+{
+	gpu_cp_wr(core, dword, (uint32_t)val);
+	gpu_cp_wr(core, dword + 1, (uint32_t)(val >> 32));
+}
+
+/* The subset of Linux's a6xx hw_init a NOP test needs (Bergamota's version). */
+static bool
+gpu_cp_hw_init(vm_offset_t core)
+{
+	static const uint32_t addr_mode[] = {
+		A6XX_CP_ADDR_MODE_CNTL, A6XX_VSC_ADDR_MODE_CNTL, A6XX_GRAS_ADDR_MODE_CNTL,
+		A6XX_RB_ADDR_MODE_CNTL, A6XX_PC_ADDR_MODE_CNTL, A6XX_HLSQ_ADDR_MODE_CNTL,
+		A6XX_VFD_ADDR_MODE_CNTL, A6XX_VPC_ADDR_MODE_CNTL, A6XX_UCHE_ADDR_MODE_CNTL,
+		A6XX_SP_ADDR_MODE_CNTL, A6XX_TPL1_ADDR_MODE_CNTL,
+	};
+
+	printf("SWEET GPU: cp: before configuration: sqe_cntl %#x hw_fault %#x irq %#x rptr %#x wptr %#x\n",
+	    gpu_cp_rd(core, A6XX_CP_SQE_CNTL), gpu_cp_rd(core, A6XX_CP_HW_FAULT),
+	    gpu_cp_rd(core, A6XX_CP_INTERRUPT_STATUS), gpu_cp_rd(core, A6XX_CP_RB_RPTR),
+	    gpu_cp_rd(core, A6XX_CP_RB_WPTR));
+
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+		gpu_cp_wr(core, addr_mode[i], 1);            /* 64-bit addressing */
+	}
+	gpu_cp_wr(core, A6XX_RBBM_VBIF_CLIENT_QOS_CNTL, 3);
+	gpu_cp_wr(core, A6XX_VBIF_GATE_OFF_WRREQ_EN, 9);          /* a630 only */
+	gpu_cp_wr(core, A6XX_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffffu);
+	gpu_cp_wr64(core, A6XX_UCHE_WRITE_RANGE_MAX, 0x0001ffffffffffc0ull);
+	gpu_cp_wr64(core, A6XX_UCHE_TRAP_BASE, 0x0001fffffffff000ull);
+	gpu_cp_wr64(core, A6XX_UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	gpu_cp_wr64(core, A6XX_UCHE_GMEM_RANGE_MIN, 0x100000u);
+	gpu_cp_wr64(core, A6XX_UCHE_GMEM_RANGE_MAX, 0x100000u + 0x100000u - 1u);
+	gpu_cp_wr(core, A6XX_UCHE_FILTER_CNTL, 0x804);
+	gpu_cp_wr(core, A6XX_UCHE_CACHE_WAYS, 0x4);
+	gpu_cp_wr(core, A6XX_CP_ROQ_THRESHOLDS_2, 0x010000c0);
+	gpu_cp_wr(core, A6XX_CP_ROQ_THRESHOLDS_1, 0x8040362c);
+	gpu_cp_wr(core, A6XX_CP_MEM_POOL_SIZE, 128);
+	gpu_cp_wr(core, A6XX_PC_DBG_ECO_CNTL, 0x00180000);
+	gpu_cp_wr(core, A6XX_CP_AHB_CNTL, 1);
+	/*
+	 * Linux a6xx_set_ubwc_config(): the a630 values (lower_bit 2, no AMSBC, no RGB565 predictor).
+	 * The render and texture blocks and the UCHE have to agree on how many address bits the UBWC
+	 * tags take, or a compressed surface is read in a layout it was never written in - which is
+	 * exactly what CoreAnimation allocates for its 10-bit swap chain.
+	 */
+	gpu_cp_wr(core, A6XX_RB_NC_MODE_CNTL, 2u << 1);
+	gpu_cp_wr(core, A6XX_TPL1_NC_MODE_CNTL, 2u << 1);
+	gpu_cp_wr(core, A6XX_SP_NC_MODE_CNTL, 2u << 1);
+	gpu_cp_wr(core, A6XX_UCHE_MODE_CNTL, 2u << 21);
+	gpu_cp_wr(core, A6XX_RBBM_INTERFACE_HANG_INT_CNTL, (1u << 30) | 0x1fffffu);
+	gpu_cp_wr(core, A6XX_UCHE_CLIENT_PF, (1u << 7) | 1u);
+	/* The ring and the SQE through context CB1; completion is polled (INT mask 0). */
+	gpu_cp_wr64(core, A6XX_CP_SQE_INSTR_BASE, GPU_VA_CP_SQE);
+	gpu_cp_wr64(core, A6XX_CP_RB_BASE, GPU_VA_CP_RING);
+	gpu_cp_wr(core, A6XX_CP_RB_CNTL, CP_RB_CNTL_VALUE);
+	gpu_cp_wr64(core, A6XX_CP_RB_RPTR_ADDR, GPU_VA_CP_SCRATCH);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	uint32_t cntl = gpu_cp_rd(core, A6XX_CP_RB_CNTL);
+	uint32_t sqe = gpu_cp_rd(core, A6XX_CP_SQE_INSTR_BASE);
+	uint32_t rb = gpu_cp_rd(core, A6XX_CP_RB_BASE);
+	uint32_t roq = gpu_cp_rd(core, A6XX_CP_ROQ_THRESHOLDS_2);
+	uint32_t amode = gpu_cp_rd(core, A6XX_CP_ADDR_MODE_CNTL);
+	printf("SWEET GPU: cp configured: rb_cntl %#x sqe_base %#x rb_base %#x roq2 %#x addr_mode %#x\n",
+	    cntl, sqe, rb, roq, amode);
+	printf("SWEET GPU: ubwc: rb_nc %#x sp_nc %#x tpl1_nc %#x uche_mode %#x\n",
+	    gpu_cp_rd(core, A6XX_RB_NC_MODE_CNTL), gpu_cp_rd(core, A6XX_SP_NC_MODE_CNTL),
+	    gpu_cp_rd(core, A6XX_TPL1_NC_MODE_CNTL), gpu_cp_rd(core, A6XX_UCHE_MODE_CNTL));
+	if (cntl != CP_RB_CNTL_VALUE || sqe != (uint32_t)GPU_VA_CP_SQE ||
+	    rb != (uint32_t)GPU_VA_CP_RING || roq != 0x010000c0) {
+		printf("SWEET GPU: CP configuration readback mismatch\n");
+		return false;
+	}
+	return true;
+}
+
+/* PM4 type 4: a plain register write, the form every client command buffer uses. */
+static uint32_t
+gpu_parity(uint32_t v)
+{
+	v ^= v >> 16;
+	v ^= v >> 8;
+	v ^= v >> 4;
+	return (~0x6996u >> (v & 0xfu)) & 1u;
+}
+
+static uint32_t
+gpu_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | (cnt & 0x7fu) | (gpu_parity(cnt) << 7) |
+	    ((reg & 0x3ffffu) << 8) | (gpu_parity(reg) << 27);
+}
+
+/* stage 7b: the ring, CP_ME_INIT and the first PM4 packets ---------- */
+
+static unsigned gpu_cp_wptr;            /* dwords written into the ring */
+
+/* PM4 type 7 carries a parity bit for the count and one for the opcode, so the
+ * CP can reject a packet that was mangled on its way through the ring. */
+static uint32_t
+gpu_pm4_parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^
+	    (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static uint32_t
+gpu_pkt7(unsigned opcode, unsigned cnt)
+{
+	return 0x70000000u | cnt | (gpu_pm4_parity(cnt) << 15) |
+	    ((opcode & 0x7fu) << 16) | (gpu_pm4_parity(opcode) << 23);
+}
+
+static void
+gpu_ring_emit(vm_offset_t ring, uint32_t v)
+{
+	*(volatile uint32_t *)(ring + 4u * gpu_cp_wptr) = v;
+	gpu_cp_wptr = (gpu_cp_wptr + 1) % (GPU_CP_RING_BYTES / 4);
+}
+
+/* a6xx_flush: make the packets visible to the GPU, then move WPTR. */
+static void
+gpu_ring_flush(vm_offset_t core, unsigned wptr)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_cp_wr(core, A6XX_CP_RB_WPTR, wptr);
+}
+
+static bool
+gpu_ring_wait_idle(vm_offset_t core, const char *what)
+{
+	for (unsigned i = 0; i < 100000; i++) {
+		if (gpu_cp_rd(core, A6XX_CP_RB_RPTR) == gpu_cp_wptr) {
+			printf("SWEET GPU: cp %s: ring idle (RPTR=WPTR=%u) rbbm_status %#x\n",
+			    what, gpu_cp_wptr, gpu_cp_rd(core, A6XX_RBBM_STATUS));
+			return true;
+		}
+		gpu_wait_ms(1);
+	}
+	printf("SWEET GPU: cp %s: ring did NOT drain: rptr %u wptr %u rbbm_status %#x "
+	    "cp_status1 %#x hw_fault %#x irq %#x protect %#x rbbm_irq %#x\n",
+	    what, gpu_cp_rd(core, A6XX_CP_RB_RPTR), gpu_cp_wptr,
+	    gpu_cp_rd(core, A6XX_RBBM_STATUS), gpu_cp_rd(core, A6XX_CP_STATUS_1),
+	    gpu_cp_rd(core, A6XX_CP_HW_FAULT), gpu_cp_rd(core, A6XX_CP_INTERRUPT_STATUS),
+	    gpu_cp_rd(core, A6XX_CP_PROTECT_STATUS), gpu_cp_rd(core, A6XX_RBBM_INT_0_STATUS));
+	return false;
+}
+
+/*
+ * fajita: a client fence that never came back. If RPTR is still behind WPTR the CP stopped inside a command
+ * buffer; if RPTR caught up, the CP read everything and only the fence write is missing - which would be our
+ * scratch mapping, not the GPU. The fault registers say which packet or access it died on.
+ */
+void
+sweet_gpu_dump_cp_state(const char *why)
+{
+	vm_offset_t core = gpu_core;
+
+	if (core == 0) {
+		printf("SWEET GPU: %s: no core mapping\n", why);
+		return;
+	}
+	printf("SWEET GPU: %s: rptr %u wptr %u rbbm_status %#x cp_status1 %#x hw_fault %#x "
+	    "irq %#x protect %#x rbbm_irq %#x sqe_cntl %#x\n", why,
+	    gpu_cp_rd(core, A6XX_CP_RB_RPTR), gpu_cp_wptr,
+	    gpu_cp_rd(core, A6XX_RBBM_STATUS), gpu_cp_rd(core, A6XX_CP_STATUS_1),
+	    gpu_cp_rd(core, A6XX_CP_HW_FAULT), gpu_cp_rd(core, A6XX_CP_INTERRUPT_STATUS),
+	    gpu_cp_rd(core, A6XX_CP_PROTECT_STATUS), gpu_cp_rd(core, A6XX_RBBM_INT_0_STATUS),
+	    gpu_cp_rd(core, A6XX_CP_SQE_CNTL));
+}
+
+/* a6xx_cp_init: enable the SQE (this starts the engine) and let it configure the
+ * ME. Completion is polled because RBBM_INT_0_MASK stays 0 - no interrupts. */
+static bool
+gpu_cp_start(vm_offset_t core, vm_offset_t ring)
+{
+	gpu_cp_wptr = 0;
+	gpu_cp_wr(core, A6XX_CP_SQE_CNTL, 1);
+	printf("SWEET GPU: cp: SQE enabled, cp_status1 %#x\n", gpu_cp_rd(core, A6XX_CP_STATUS_1));
+
+	gpu_ring_emit(ring, gpu_pkt7(GPU_CP_ME_INIT, 8));
+	gpu_ring_emit(ring, 0x0000002fu);
+	gpu_ring_emit(ring, 0x00000003u);     /* multiple hardware contexts */
+	gpu_ring_emit(ring, 0x20000000u);     /* error detection */
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, 0);
+	gpu_ring_flush(core, gpu_cp_wptr);
+
+	return gpu_ring_wait_idle(core, "CP_ME_INIT");
+}
+
+/* The first packets this kernel would ever submit: a NOP, a write into the
+ * scratch page and the timestamp the CP stores when the write retires. */
+static bool
+gpu_cp_nop_test(vm_offset_t core, vm_offset_t blob)
+{
+	vm_offset_t ring = blob + GPU_CP_RING;
+	volatile uint32_t *memwr = (volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_MEMWR);
+	volatile uint32_t *ts = (volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_TS);
+	const uint32_t memval = 0x5ee70001u, seq = 0x600d0001u;
+
+	*memwr = 0;
+	*ts = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	gpu_ring_emit(ring, gpu_pkt7(GPU_CP_NOP, 1));
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, gpu_pkt7(GPU_CP_MEM_WRITE, 3));
+	gpu_ring_emit(ring, (uint32_t)(GPU_VA_CP_SCRATCH + GPU_CP_SCRATCH_MEMWR));
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, memval);
+	gpu_ring_emit(ring, gpu_pkt7(GPU_CP_EVENT_WRITE, 4));
+	gpu_ring_emit(ring, GPU_CP_EVENT_WRITE_IRQ | GPU_CP_CACHE_FLUSH_TS);
+	gpu_ring_emit(ring, (uint32_t)(GPU_VA_CP_SCRATCH + GPU_CP_SCRATCH_TS));
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, seq);
+	gpu_ring_flush(core, gpu_cp_wptr);
+
+	bool idle = gpu_ring_wait_idle(core, "NOP submission");
+	for (unsigned i = 0; i < 5000 && (*memwr != memval || *ts != seq); i++) {
+		gpu_wait_ms(1);
+	}
+	uint32_t irq = gpu_cp_rd(core, A6XX_RBBM_INT_0_STATUS);
+	printf("SWEET GPU: cp NOP test: mem_write %#x (want %#x), cache_flush_ts %#x "
+	    "(want %#x), rbbm_int_0_status %#x\n", *memwr, memval, *ts, seq, irq);
+	if (irq) {
+		gpu_cp_wr(core, A6XX_RBBM_INT_CLEAR_CMD, irq & 0x00ffffffu);
+	}
+	printf("SWEET GPU: cp after NOP: cp_status1 %#x hw_fault %#x irq %#x rptr %u\n",
+	    gpu_cp_rd(core, A6XX_CP_STATUS_1), gpu_cp_rd(core, A6XX_CP_HW_FAULT),
+	    gpu_cp_rd(core, A6XX_CP_INTERRUPT_STATUS), gpu_cp_rd(core, A6XX_CP_RB_RPTR));
+
+	if (idle && *memwr == memval && *ts == seq) {
+		printf("SWEET GPU: CP NOP TEST PASSED: the CP fetched, executed and wrote back "
+		    "through the GPU SMMU\n");
+		return true;
+	}
+	printf("SWEET GPU: CP NOP TEST FAILED (%s)\n",
+	    !idle ? "the ring did not drain" : "the ring drained but the memory was not updated");
+	return false;
+}
+
+/* A 256-byte fill through the CP: 64 CP_MEM_WRITEs, the primitive a real buffer
+ * write needs, and the check that every word arrived. */
+static bool
+gpu_cp_fill_test(vm_offset_t core, vm_offset_t blob)
+{
+	vm_offset_t ring = blob + GPU_CP_RING;
+	volatile uint32_t *dst = (volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FILL);
+	const uint32_t val = 0x5a5a5a5au;
+	const unsigned words = GPU_CP_FILL_BYTES / 4;
+
+	for (unsigned i = 0; i < words; i++) {
+		dst[i] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	for (unsigned i = 0; i < words; i++) {
+		gpu_ring_emit(ring, gpu_pkt7(GPU_CP_MEM_WRITE, 3));
+		gpu_ring_emit(ring, (uint32_t)(GPU_VA_CP_SCRATCH + GPU_CP_SCRATCH_FILL + 4u * i));
+		gpu_ring_emit(ring, 0);
+		gpu_ring_emit(ring, val);
+	}
+	gpu_ring_flush(core, gpu_cp_wptr);
+	if (!gpu_ring_wait_idle(core, "fill submission")) {
+		return false;
+	}
+
+	unsigned differ = 0;
+	for (unsigned i = 0; i < words; i++) {
+		if (dst[i] != val) {
+			differ++;
+		}
+	}
+	printf("SWEET GPU: cp fill test: %u of %u words differ (%s)\n", differ, words,
+	    differ ? "FAILED" : "ok");
+	return differ == 0;
+}
+
+/* ---- stage 8b: a client-address mapping the CP has never seen ---------- */
+
+/*
+ * Build L1[2] -> a fresh L2 -> a fresh L3 -> a fresh data page for
+ * GPU_VA_CLIENT_TEST, then have the CP write through it. The value is read back
+ * through the blob's own mapping of the same physical page, so a match means the
+ * CP resolved the new VA through the new tables.
+ */
+static bool
+gpu_client_va_test(vm_offset_t core, vm_offset_t blob, uint64_t blob_pa)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)(blob + GPU_GMEM_L1);
+	volatile uint64_t *l2 = (volatile uint64_t *)(blob + GPU_ARENA_L2);
+	volatile uint64_t *l3 = (volatile uint64_t *)(blob + GPU_ARENA_L3);
+	volatile uint32_t *page = (volatile uint32_t *)(blob + GPU_ARENA_DATA);
+	vm_offset_t ring = blob + GPU_CP_RING;
+	const uint32_t magic = 0xfeed0001u;
+	const uint32_t l1i = (GPU_VA_CLIENT_TEST >> 30) & 0x1ff;
+	const uint32_t l2i = (GPU_VA_CLIENT_TEST >> 21) & 0x1ff;
+	const uint32_t l3i = (GPU_VA_CLIENT_TEST >> 12) & 0x1ff;
+
+	for (unsigned i = 0; i < GPU_ARENA_PAGES * 1024; i++) {
+		page[i] = 0;
+	}
+	l1[l1i] = (uint64_t)(blob_pa + GPU_ARENA_L2) | GPU_PTE_TABLE;
+	l2[l2i] = (uint64_t)(blob_pa + GPU_ARENA_L3) | GPU_PTE_TABLE;
+	l3[l3i] = (uint64_t)(blob_pa + GPU_ARENA_DATA) | GPU_PTE_PAGE;
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET GPU: client va %#x: l1[%u]=%#llx l2[%u]=%#llx l3[%u]=%#llx (data pa %#llx)\n",
+	    GPU_VA_CLIENT_TEST, l1i, (unsigned long long)l1[l1i],
+	    l2i, (unsigned long long)l2[l2i], l3i, (unsigned long long)l3[l3i],
+	    (unsigned long long)(blob_pa + GPU_ARENA_DATA));
+
+	gpu_ring_emit(ring, gpu_pkt7(GPU_CP_MEM_WRITE, 3));
+	gpu_ring_emit(ring, GPU_VA_CLIENT_TEST);
+	gpu_ring_emit(ring, 0);
+	gpu_ring_emit(ring, magic);
+	gpu_ring_flush(core, gpu_cp_wptr);
+	if (!gpu_ring_wait_idle(core, "client va submission")) {
+		return false;
+	}
+
+	bool ok = page[0] == magic;
+	printf("SWEET GPU: client va write: %#x (want %#x) %s\n", page[0], magic,
+	    ok ? "- the CP resolved a new L1 slot" : "- MISMATCH");
+	return ok;
+}
+
+/* ---- stage 8c: a submission as a command buffer plus a fence ----------- */
+
+static uint32_t gpu_cp_seq;    /* the fence sequence, as Linux's ring->seqno */
+
+/*
+ * The Linux a6xx_submit tail: one indirect buffer in the ring, then a
+ * CACHE_FLUSH_TS carrying the sequence number as the fence.
+ */
+static bool
+gpu_cp_submit(vm_offset_t core, vm_offset_t blob, uint32_t ib_va, uint32_t ib_dwords)
+{
+	gpu_ring_emit(blob + GPU_CP_RING, gpu_pkt7(GPU_CP_INDIRECT_BUFFER_PFE, 3));
+	gpu_ring_emit(blob + GPU_CP_RING, ib_va);
+	gpu_ring_emit(blob + GPU_CP_RING, 0);
+	gpu_ring_emit(blob + GPU_CP_RING, ib_dwords);
+	gpu_ring_emit(blob + GPU_CP_RING, gpu_pkt7(GPU_CP_EVENT_WRITE, 4));
+	gpu_ring_emit(blob + GPU_CP_RING, GPU_CP_CACHE_FLUSH_TS);
+	gpu_ring_emit(blob + GPU_CP_RING, (uint32_t)(GPU_VA_CP_SCRATCH + GPU_CP_SCRATCH_FENCE));
+	gpu_ring_emit(blob + GPU_CP_RING, 0);
+	gpu_ring_emit(blob + GPU_CP_RING, ++gpu_cp_seq);
+	gpu_ring_flush(core, gpu_cp_wptr);
+	return gpu_ring_wait_idle(core, "indirect submission");
+}
+
+/* Wait for the fence the CP stores: the sequence number in the timestamp slot. */
+static bool
+gpu_cp_wait_fence(vm_offset_t blob, uint32_t seq, unsigned ms)
+{
+	volatile uint32_t *ts = (volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE);
+
+	for (unsigned i = 0; i < ms; i++) {
+		if (*ts == seq) {
+			return true;
+		}
+		gpu_wait_ms(1);
+	}
+	return false;
+}
+
+/* The first submission shaped like a userspace one: commands in a buffer, a
+ * fence at the end, both verified. */
+static bool
+gpu_cp_ib_test(vm_offset_t core, vm_offset_t blob, uint64_t blob_pa)
+{
+	volatile uint32_t *ib = (volatile uint32_t *)(blob + GPU_ARENA_DATA + 0x1000);
+	volatile uint32_t *out1 = (volatile uint32_t *)(blob + GPU_ARENA_DATA + 0x40);
+	volatile uint32_t *out2 = (volatile uint32_t *)(blob + GPU_ARENA_DATA + 0x80);
+	volatile uint64_t *l3 = (volatile uint64_t *)(blob + GPU_ARENA_L3);
+	const uint32_t v1 = 0x1b000001u, v2 = 0x1b000002u;
+	unsigned n = 0;
+
+	*out1 = 0;
+	*out2 = 0;
+	*(volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) = 0;
+	/* The command buffer lives one page above the mapped client page. */
+	l3[(GPU_VA_CLIENT_IB >> 12) & 0x1ff] =
+	    (uint64_t)(blob_pa + GPU_ARENA_DATA + 0x1000) | GPU_PTE_PAGE;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* The command buffer: NOP, two writes, NOP. */
+	ib[n++] = gpu_pkt7(GPU_CP_NOP, 1);
+	ib[n++] = 0;
+	ib[n++] = gpu_pkt7(GPU_CP_MEM_WRITE, 3);
+	ib[n++] = GPU_VA_CLIENT_TEST + 0x40;
+	ib[n++] = 0;
+	ib[n++] = v1;
+	ib[n++] = gpu_pkt7(GPU_CP_MEM_WRITE, 3);
+	ib[n++] = GPU_VA_CLIENT_TEST + 0x80;
+	ib[n++] = 0;
+	ib[n++] = v2;
+	ib[n++] = gpu_pkt7(GPU_CP_NOP, 1);
+	ib[n++] = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool idle = gpu_cp_submit(core, blob, GPU_VA_CLIENT_IB, n);
+	uint32_t seq = gpu_cp_seq;
+	bool fenced = gpu_cp_wait_fence(blob, seq, 5000);
+	printf("SWEET GPU: cp ib test: %u dwords at %#x, ring %s, fence %u %s, writes %#x %#x (want %#x %#x)\n",
+	    n, GPU_VA_CLIENT_IB, idle ? "drained" : "STUCK", seq,
+	    fenced ? "retired" : "TIMED OUT", *out1, *out2, v1, v2);
+
+	bool ok = idle && fenced && *out1 == v1 && *out2 == v2;
+	printf("SWEET GPU: cp ib test: %s\n", ok ? "PASSED - a command buffer plus a fence, "
+	    "the shape userspace will use" : "FAILED");
+	return ok;
+}
+
+/*
+ * fajita: the clients' command buffers are made of PM4 *type 4* register writes - every one of the 143
+ * dwords in the window server's first buffer decodes as one, and none of the kernel's own tests used that
+ * form. Three single-write buffers, each with its own fence, say whether the CP executes type 4 at all and
+ * whether the writes the client makes are the ones that wedge it:
+ *   0x8864 RB_ALPHA_CONTROL   - a real, readable a6xx register (the driver writes it from hw_init)
+ *   0x8880 RB_STENCIL_CONTROL - with the client's own value, 0x49705
+ *   0x8115                    - a hole in the a6xx register map, present in the client's stream
+ * A buffer that does not retire leaves the CP wedged, so the suspicious register goes last.
+ */
+static bool
+gpu_pkt4_test(vm_offset_t core, vm_offset_t blob, uint64_t blob_pa)
+{
+	static const struct {
+		uint32_t    reg;
+		uint32_t    val;
+		const char *what;
+	} cases[] = {
+		{ 0x8864u, 0x0u,      "RB_ALPHA_CONTROL" },
+		{ 0x8880u, 0x49705u,  "RB_STENCIL_CONTROL" },
+		{ 0x8115u, 0x0u,      "unnamed 0x8115" },
+	};
+	volatile uint32_t *ib = (volatile uint32_t *)(blob + GPU_ARENA_DATA + 0x1000);
+	bool all = true;
+
+	*(volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	for (unsigned c = 0; c < sizeof(cases) / sizeof(cases[0]); c++) {
+		unsigned n = 0;
+
+		ib[n++] = gpu_pkt4(cases[c].reg, 1);
+		ib[n++] = cases[c].val;
+		__asm__ volatile("dsb sy" ::: "memory");
+
+		bool idle = gpu_cp_submit(core, blob, GPU_VA_CLIENT_IB, n);
+		uint32_t seq = gpu_cp_seq;
+		bool fenced = idle && gpu_cp_wait_fence(blob, seq, 5000);
+
+		printf("SWEET GPU: pkt4 test: write %#x to %s (%s): ring %s, fence %u %s\n",
+		    cases[c].val, cases[c].what, c == 2 ? "a hole in a6xx.xml" : "a real register",
+		    idle ? "drained" : "NOT drained", seq, fenced ? "retired" : "TIMED OUT");
+		if (!fenced) {
+			all = false;
+			break;                  /* the CP is wedged: nothing after this can run */
+		}
+	}
+	printf("SWEET GPU: pkt4 test: %s\n",
+	    all ? "PASSED - type 4 register writes execute" : "a type 4 write wedged the CP");
+	return all;
+}
+
+/*
+ * fajita: the window server's own first command buffer, captured from the ring (0185) and replayed from
+ * the kernel. Every packet in it is a type-4 register write, and a single such write retires fine (0186),
+ * so the wedge is in this particular sequence of 136 dwords or in the values it carries. `replay=N`
+ * submits only the first N dwords, which turns the search into a bisection that needs no new kernel:
+ * a truncation that retires and a longer one that hangs bracket the offending packet.
+ */
+/* 136 dwords captured from the window server's first command buffer */
+static const uint32_t client_replay[] = {
+    0x40886401, 0x00000000, 0x40888001, 0x00000000, 0x40811501, 0x00000000,
+    0x48887101, 0x00000000, 0x48811401, 0x00000000, 0x48888802, 0x00000000,
+    0x00000000, 0x48887802, 0x00000000, 0x00000000, 0x40886401, 0x00000000,
+    0x40888001, 0x00000000, 0x40811501, 0x00000000, 0x48887101, 0x00000000,
+    0x48811401, 0x00000000, 0x48888802, 0x00000000, 0x00000000, 0x48887802,
+    0x00000000, 0x00000000, 0x40886401, 0x00000000, 0x40888001, 0x00000000,
+    0x40811501, 0x00000000, 0x48887101, 0x00000020, 0x48811401, 0x00000000,
+    0x48888802, 0x00000000, 0x00000000, 0x48887802, 0x00000000, 0x00000000,
+    0x40886401, 0x00000000, 0x40888001, 0x00000000, 0x40811501, 0x00000000,
+    0x48887101, 0x00000020, 0x48811401, 0x00000000, 0x48888802, 0x00000000,
+    0x00000000, 0x48887802, 0x00000000, 0x00000000, 0x40886401, 0x00000000,
+    0x40888001, 0x00000000, 0x40811501, 0x00000000, 0x48887101, 0x0000005f,
+    0x48811401, 0x00000001, 0x48888802, 0x00000000, 0x00000000, 0x48887802,
+    0x00000000, 0x00000000, 0x40886401, 0x00000000, 0x40888001, 0x00000000,
+    0x40811501, 0x00000000, 0x48887101, 0x0000005f, 0x48811401, 0x00000001,
+    0x48888802, 0x00000000, 0x00000000, 0x48887802, 0x00000000, 0x00000000,
+    0x40886401, 0x00000000, 0x40888001, 0x00000000, 0x40811501, 0x00000000,
+    0x48887101, 0x0000007f, 0x48811401, 0x00000001, 0x48888802, 0x00000000,
+    0x00000000, 0x48887802, 0x00000000, 0x00000000, 0x40886401, 0x00000000,
+    0x40888001, 0x00000000, 0x40811501, 0x00000000, 0x48887101, 0x0000007f,
+    0x48811401, 0x00000001, 0x48888802, 0x00000000, 0x00000000, 0x48887802,
+    0x00000000, 0x00000000, 0x40886401, 0x00000000, 0x40888001, 0x00049705,
+    0x40811501, 0x00000001, 0x48887101, 0x0000005f,
+};
+
+static bool
+gpu_replay_test(vm_offset_t core, vm_offset_t blob, uint64_t blob_pa)
+{
+	volatile uint32_t *ib = (volatile uint32_t *)(blob + GPU_ARENA_DATA + 0x1000);
+	uint32_t total = (uint32_t)(sizeof(client_replay) / sizeof(client_replay[0]));
+	uint32_t want = total;
+	int arg = 0;
+
+	if (!PE_parse_boot_argn("replay", &arg, sizeof(arg)) || arg < 0) {
+		return true;                    /* the test is opt-in */
+	}
+	if (arg == 0) {
+		printf("SWEET GPU: replay test: skipped (replay=0)\n");
+		return true;
+	}
+	if ((uint32_t)arg < total) {
+		want = (uint32_t)arg;
+	}
+
+	for (uint32_t i = 0; i < want; i++) {
+		ib[i] = client_replay[i];
+	}
+	*(volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool idle = gpu_cp_submit(core, blob, GPU_VA_CLIENT_IB, want);
+	uint32_t seq = gpu_cp_seq;
+	bool fenced = idle && gpu_cp_wait_fence(blob, seq, 5000);
+
+	printf("SWEET GPU: replay test: %u of %u dwords: ring %s, fence %u %s\n",
+	    want, total, idle ? "drained" : "NOT drained", seq, fenced ? "retired" : "TIMED OUT");
+	printf("SWEET GPU: replay test: %s\n",
+	    fenced ? "PASSED - the client stream executes" : "the client stream wedged the CP here");
+	return fenced;
+}
+
+/*
+ * fajita: copy a client command buffer into the kernel's own blob and return the GPU address it is
+ * submitted through. The client's buffers live in pages this driver allocated for it, and the same 136
+ * dwords executed correctly when submitted from the blob (0187) but never retire when submitted from the
+ * client's memory - so the question is whether the CP sees what the CPU sees. A copy through memory the
+ * driver owns answers it without touching the client's mapping.
+ */
+uint64_t
+sweet_gpu_bounce_ib(const void *kva, uint32_t dwords)
+{
+	if (gpu_blob == 0 || kva == NULL || dwords > (PAGE_SIZE / 4)) {
+		return 0;
+	}
+	volatile uint8_t *dst = (volatile uint8_t *)(gpu_blob + GPU_ARENA_DATA + 0x1000);
+	const volatile uint8_t *src = (const volatile uint8_t *)kva;
+	uint32_t bytes = dwords * 4;
+
+	/*
+	 * A byte at a time: the client's buffer is mapped as Device memory (nGnRE), where an unaligned
+	 * 8-byte access is a fault - memcpy's word loop took an unaligned data abort here (console144).
+	 */
+	for (uint32_t i = 0; i < bytes; i++) {
+		dst[i] = src[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET GPU: bounced %u dwords, first %#x last %#x\n", dwords,
+	    ((const volatile uint32_t *)kva)[0], ((const volatile uint32_t *)kva)[dwords - 1]);
+	return GPU_VA_CLIENT_IB;
+}
+
+/*
+ * fajita: the window server's first command buffer begins with CP_SET_MODE (type 7, opcode 0x63) - a packet
+ * the port has never executed, because every kernel test is NOP/MEM_WRITE/INDIRECT/EVENT_WRITE/type-4. It
+ * changes the CP's own mode, and a mode it cannot work in would explain a ring that drains with no fault and
+ * a fence that never comes back. `setmode=<value>` submits exactly that packet with that payload.
+ */
+static bool
+gpu_setmode_test(vm_offset_t core, vm_offset_t blob, uint64_t blob_pa)
+{
+	volatile uint32_t *ib = (volatile uint32_t *)(blob + GPU_ARENA_DATA + 0x1000);
+	int value = 0;
+	unsigned n = 0;
+
+	if (!PE_parse_boot_argn("setmode", &value, sizeof(value))) {
+		return true;                    /* opt-in */
+	}
+	ib[n++] = gpu_pkt7(GPU_CP_SET_MODE, 1);
+	ib[n++] = (uint32_t)value;
+	*(volatile uint32_t *)(blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool idle = gpu_cp_submit(core, blob, GPU_VA_CLIENT_IB, n);
+	uint32_t seq = gpu_cp_seq;
+	bool fenced = idle && gpu_cp_wait_fence(blob, seq, 5000);
+
+	printf("SWEET GPU: setmode test: CP_SET_MODE %d: ring %s, fence %u %s\n",
+	    value, idle ? "drained" : "NOT drained", seq, fenced ? "retired" : "TIMED OUT");
+	printf("SWEET GPU: setmode test: %s\n",
+	    fenced ? "PASSED - the CP accepts CP_SET_MODE" : "CP_SET_MODE wedged the CP");
+	return fenced;
+}
+
+/* Allocate, map, submit into, fence, verify, free - the whole buffer path. */
+static bool
+gpu_bo_test(vm_offset_t core, vm_offset_t blob)
+{
+	static const uint32_t v[3] = { 0xb0010001u, 0xb0010002u, 0xb0010003u };
+	unsigned n = 0;
+
+	if (!gpu_bo_init(blob)) {
+		printf("SWEET GPU: bo test: no arena, skipping\n");
+		return false;
+	}
+	struct gpu_bo *cmd = gpu_bo_alloc(0x4000);
+	struct gpu_bo *dst = gpu_bo_alloc(0x1000);
+	if (cmd == NULL || dst == NULL) {
+		printf("SWEET GPU: bo test: allocation failed\n");
+		gpu_bo_free(dst);
+		gpu_bo_free(cmd);
+		return false;
+	}
+
+	volatile uint32_t *ib = (volatile uint32_t *)cmd->kva;
+	volatile uint32_t *out = (volatile uint32_t *)dst->kva;
+	for (unsigned i = 0; i < 3; i++) {
+		ib[n++] = gpu_pkt7(GPU_CP_MEM_WRITE, 3);
+		ib[n++] = dst->va + 0x10u * (i + 1);
+		ib[n++] = 0;
+		ib[n++] = v[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool idle = gpu_cp_submit(core, blob, cmd->va, n);
+	uint32_t seq = gpu_cp_seq;
+	bool fenced = gpu_cp_wait_fence(blob, seq, 5000);
+	bool match = out[4] == v[0] && out[8] == v[1] && out[12] == v[2];
+
+	printf("SWEET GPU: bo test: %u dwords from va %#x, ring %s, fence %u %s, got %#x/%#x/%#x "
+	    "(want %#x/%#x/%#x)\n", n, cmd->va, idle ? "drained" : "STUCK", seq,
+	    fenced ? "retired" : "TIMED OUT", out[4], out[8], out[12], v[0], v[1], v[2]);
+
+	bool ok = idle && fenced && match;
+	printf("SWEET GPU: bo test: %s\n", ok ?
+	    "PASSED - allocate, map, submit, fence, verify, free" : "FAILED");
+
+	gpu_bo_free(dst);
+	gpu_bo_free(cmd);
+	return ok;
+}
+
+/* ---- stage 8f: the surface the IOKit user client calls ----------------- */
+
+/* Prototypes exactly as their SweetAdreno.cpp declares them. */
+static bool gpu_lost;
+
+bool
+sweet_gpu_ready(void)
+{
+	return gpu_live && !gpu_lost;
+}
+
+uint32_t
+sweet_gpu_selector(void)
+{
+	return gpu_live ? 1u : 0u;
+}
+
+bool
+sweet_gpu_param(uint32_t which, uint64_t *value)
+{
+	if (!gpu_live) {
+		return false;
+	}
+	switch (which) {
+	case GPU_PARAM_GPU_ID:
+		*value = 630;
+		break;
+	case GPU_PARAM_CHIP_ID:
+		*value = 0x06030001u;
+		break;
+	case GPU_PARAM_GMEM_SIZE:
+		*value = 0x100000u;
+		break;
+	case GPU_PARAM_MAX_FREQ:
+		*value = 710000000u;
+		break;
+	case GPU_PARAM_TIMESTAMP:
+		*value = *(volatile uint32_t *)(gpu_blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE);
+		break;
+	case GPU_PARAM_GMEM_BASE:
+		*value = 0x100000u;
+		break;
+	case GPU_PARAM_PRIORITIES:
+		*value = 1;             /* one ring, no priority levels */
+		break;
+	case GPU_PARAM_PP_PGTABLE:
+		*value = 0;             /* one address space for everybody */
+		break;
+	case GPU_PARAM_VA_START:
+		*value = GPU_VA_BASE;
+		break;
+	case GPU_PARAM_VA_SIZE:
+		*value = GPU_VA_BYTES;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
+static bool
+gpu_va_to_local(uint64_t iova, uint64_t size, uint64_t *off)
+{
+	if (iova < GPU_VA_BASE) {
+		return false;
+	}
+	uint64_t o = iova - GPU_VA_BASE;
+
+	if (o + size > GPU_VA_BYTES) {
+		return false;
+	}
+	if (off != NULL) {
+		*off = o;
+	}
+	return true;
+}
+
+/* Best fit: the smallest extent that fits, so a freed hole is reused before the
+ * untouched tail and fragmentation stays down. The guard page goes with it. */
+static bool
+gpu_va_take(uint64_t size, uint64_t *off)
+{
+	unsigned best = GPU_VA_EXTENTS;
+	uint64_t best_size = 0;
+
+	for (unsigned i = 0; i < GPU_VA_EXTENTS; i++) {
+		if (gpu_va_free[i].size < size + 0x1000) {
+			continue;
+		}
+		if (best == GPU_VA_EXTENTS || gpu_va_free[i].size < best_size) {
+			best = i;
+			best_size = gpu_va_free[i].size;
+		}
+	}
+	if (best == GPU_VA_EXTENTS) {
+		return false;
+	}
+	*off = gpu_va_free[best].off;
+	gpu_va_free[best].off += size + 0x1000;
+	gpu_va_free[best].size -= size + 0x1000;
+	return true;
+}
+
+static void
+gpu_va_give(uint64_t off, uint64_t size)
+{
+	size += 0x1000;                 /* the guard page goes with it */
+	for (unsigned i = 0; i < GPU_VA_EXTENTS; i++) {
+		if (gpu_va_free[i].size == 0) {
+			gpu_va_free[i].off = off;
+			gpu_va_free[i].size = size;
+			return;
+		}
+	}
+	printf("SWEET GPU: va free table full, %#llx (%llu bytes) left unused\n",
+	    (unsigned long long)(GPU_VA_BASE + off), (unsigned long long)size);
+}
+
+/* The L3 serving a 2 MiB chunk, taken from the pool on first touch. */
+static volatile uint64_t *
+gpu_l3_for(uint64_t iova)
+{
+	volatile uint64_t *l2 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L2);
+	uint32_t l2i = (uint32_t)((iova >> 21) & 0x1ff);
+
+	/*
+	 * The first 2 MiB has a fixed L3 in the payload that the boot linked into L2, and the
+	 * chardev path maps through it. Allocating a pool table here and rewriting L2[0] moves the
+	 * mapping to a table the GPU does not walk: it keeps the old L3, where gpu_bo_free() has
+	 * already cleared the PTE for this iova, and faults on the command buffer.
+	 */
+	if (l2i == 0) {
+		return (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L3);
+	}
+
+	for (unsigned i = 0; i < gpu_pte_used; i++) {
+		if (gpu_pte_l2i[i] == l2i) {
+			return (volatile uint64_t *)(gpu_pte_pool + gpu_pte_off[i]);
+		}
+	}
+	if (gpu_pte_pool == 0 || gpu_pte_used >= gpu_pte_tables) {
+		printf("SWEET GPU: no page table for %#llx\n", (unsigned long long)iova);
+		return NULL;
+	}
+	uint32_t off = 0x1000u * gpu_pte_used;
+	for (uint32_t i = 0; i < 0x1000; i += 4) {
+		*(volatile uint32_t *)(gpu_pte_pool + off + i) = 0;
+	}
+	gpu_pte_l2i[gpu_pte_used] = l2i;
+	gpu_pte_off[gpu_pte_used] = off;
+	gpu_pte_used++;
+	l2[l2i] = (gpu_pte_pool_pa + off) | GPU_PTE_TABLE;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return (volatile uint64_t *)(gpu_pte_pool + off);
+}
+
+bool
+sweet_gpu_iova_alloc(uint64_t size, uint64_t *iova, uint64_t *taken)
+{
+	uint64_t sz, off;
+
+	if (!gpu_live || size == 0 || size > GPU_VA_BYTES) {
+		return false;
+	}
+	sz = (size + 0xfff) & ~0xfffull;
+	if (!gpu_va_take(sz, &off)) {
+		printf("SWEET GPU: no room for %llu bytes in the client range\n",
+		    (unsigned long long)sz);
+		return false;
+	}
+	*iova = GPU_VA_BASE + off;
+	if (taken != NULL) {
+		*taken = sz;
+	}
+	return true;
+}
+
+/* msm SET_IOVA: the client picked an address; carve it out of the free space. */
+bool
+sweet_gpu_iova_reserve(uint64_t iova, uint64_t size)
+{
+	uint64_t off, sz;
+
+	if (!gpu_live || size == 0) {
+		return false;
+	}
+	sz = (size + 0xfff) & ~0xfffull;
+	if (!gpu_va_to_local(iova, sz, &off)) {
+		return false;
+	}
+	for (unsigned i = 0; i < GPU_VA_EXTENTS; i++) {
+		uint64_t e_off = gpu_va_free[i].off, e_size = gpu_va_free[i].size;
+
+		if (e_size == 0 || off < e_off || off + sz > e_off + e_size) {
+			continue;
+		}
+		uint64_t tail_off = off + sz + 0x1000;
+		uint64_t tail_size = e_off + e_size - tail_off;
+
+		gpu_va_free[i].size = off - e_off;
+		if (tail_size > 0) {
+			for (unsigned j = 0; j < GPU_VA_EXTENTS; j++) {
+				if (j != i && gpu_va_free[j].size == 0) {
+					gpu_va_free[j].off = tail_off;
+					gpu_va_free[j].size = tail_size;
+					break;
+				}
+			}
+		}
+		return true;
+	}
+	return false;
+}
+
+void
+sweet_gpu_iova_free(uint64_t iova, uint64_t size)
+{
+	uint64_t off, sz;
+
+	if (size == 0) {
+		return;
+	}
+	sz = (size + 0xfff) & ~0xfffull;
+	if (gpu_va_to_local(iova, sz, &off)) {
+		gpu_va_give(off, sz);
+	}
+}
+
+bool
+sweet_gpu_vm_map(uint64_t iova, uint64_t pa, bool readonly)
+{
+	if (!gpu_live || !gpu_va_to_local(iova, 0x1000, NULL)) {
+		return false;
+	}
+	volatile uint64_t *l3 = gpu_l3_for(iova);
+	if (l3 == NULL) {
+		return false;
+	}
+	l3[(iova >> 12) & 0x1ff] = (pa & ~0xfffull) | GPU_PTE_PAGE |
+	    (readonly ? (1ull << 7) : 0ull);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_tlb_invalidate();
+	return true;
+}
+
+void
+sweet_gpu_vm_unmap(uint64_t iova, uint64_t size)
+{
+	if (!gpu_live || !gpu_va_to_local(iova, size, NULL)) {
+		return;
+	}
+	for (uint64_t o = 0; o < size; o += 0x1000) {
+		volatile uint64_t *l3 = gpu_l3_for(iova + o);
+		if (l3 != NULL) {
+			l3[((iova + o) >> 12) & 0x1ff] = 0;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_tlb_invalidate();
+}
+
+/* Their buffers are cacheable IOBufferMemoryDescriptors and this is dc civac over the
+ * kernel alias; ours are uncached, so the barrier is the whole story - but keep the
+ * prototype they call. */
+void
+sweet_gpu_cache_sync(void *va, size_t len)
+{
+	(void)va;
+	(void)len;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* One CP_INDIRECT_BUFFER per command buffer, then the CACHE_FLUSH_TS fence - Linux's
+ * a6xx_submit tail, which is what their submit path hands us. */
+uint32_t
+sweet_gpu_submit(const uint64_t *ib_iova, const uint32_t *ib_dwords, unsigned count)
+{
+	if (!gpu_live || ib_iova == NULL || ib_dwords == NULL || count == 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < count; i++) {
+		gpu_ring_emit(gpu_blob + GPU_CP_RING, gpu_pkt7(GPU_CP_INDIRECT_BUFFER_PFE, 3));
+		gpu_ring_emit(gpu_blob + GPU_CP_RING, (uint32_t)ib_iova[i]);
+		gpu_ring_emit(gpu_blob + GPU_CP_RING, (uint32_t)(ib_iova[i] >> 32));
+		gpu_ring_emit(gpu_blob + GPU_CP_RING, ib_dwords[i]);
+	}
+	gpu_ring_emit(gpu_blob + GPU_CP_RING, gpu_pkt7(GPU_CP_EVENT_WRITE, 4));
+	gpu_ring_emit(gpu_blob + GPU_CP_RING, GPU_CP_CACHE_FLUSH_TS);
+	gpu_ring_emit(gpu_blob + GPU_CP_RING,
+	    (uint32_t)(GPU_VA_CP_SCRATCH + GPU_CP_SCRATCH_FENCE));
+	gpu_ring_emit(gpu_blob + GPU_CP_RING, 0);
+	gpu_ring_emit(gpu_blob + GPU_CP_RING, ++gpu_cp_seq);
+	gpu_ring_flush(gpu_core, gpu_cp_wptr);
+
+	if (!gpu_ring_wait_idle(gpu_core, "submit")) {
+		return 0;
+	}
+	return gpu_cp_seq;
+}
+
+bool
+sweet_gpu_fence_done(uint32_t fence)
+{
+	if (!gpu_live || fence == 0) {
+		return false;
+	}
+	return *(volatile uint32_t *)(gpu_blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) >= fence;
+}
+
+uint32_t
+sweet_gpu_fence_last(void)
+{
+	return gpu_cp_seq;
+}
+
+void
+sweet_gpu_mark_lost(void)
+{
+	gpu_lost = true;
+}
+
+void
+sweet_gpu_report(const char *why)
+{
+	printf("SWEET GPU: report%s%s: live %d lost %d ring wptr %u fence %u tables %u\n",
+	    why ? " " : "", why ? why : "", gpu_live ? 1 : 0, gpu_lost ? 1 : 0,
+	    gpu_cp_wptr, gpu_cp_seq, gpu_pte_used);
+}
+
+/* ---- stage 8g: memory for the IOKit client ------------------------------------------ */
+
+/*
+ * The client's buffers come from the arena, not from the VM: this port keeps pages below
+ * gPhysBase on its free lists and pmap panics on them (phys_to_kv_range, console80 and the
+ * 2026-10-26 panel photo). The arena is contiguous, above the base, and the CP already
+ * writes through it. gpu_arena_used is shared with gpu_bo_alloc() so the two never overlap;
+ * like the chardev BOs these pages are never returned (bump allocator).
+ */
+bool
+sweet_gpu_alloc_pages(uint64_t size, uint64_t *pa, void **kva)
+{
+	uint64_t sz = (size + 0xfffull) & ~0xfffull;
+	uint32_t off;
+
+	if (!gpu_live || gpu_arena_window_bytes == 0 || sz == 0 || sz > gpu_arena_size) {
+		return false;
+	}
+	if (!gpu_arena_take((uint32_t)sz, &off)) {
+		printf("SWEET GPU: arena: %llu bytes do not fit (%u of %u used)\n",
+		    (unsigned long long)sz, gpu_arena_used, gpu_arena_size);
+		return false;
+	}
+	vm_offset_t alias = gpu_arena_kva(off);
+	if (alias != 0) {
+		for (uint64_t i = 0; i < sz; i += 4) {
+			*(volatile uint32_t *)(alias + (uint32_t)i) = 0;
+		}
+	} else {
+		/* No alias for this one: the payload blob is built zeroed and the client writes it. */
+		printf("SWEET GPU: arena: %llu bytes at arena+%#x without a kernel alias\n",
+		    (unsigned long long)sz, off);
+	}
+	*pa = gpu_arena_pa + off;
+	*kva = (void *)alias;
+	printf("SWEET GPU: arena: %llu bytes at arena+%#x pa %#llx\n",
+	    (unsigned long long)sz, off, (unsigned long long)*pa);
+	return true;
+}
+
+void
+sweet_gpu_free_pages(uint64_t pa, uint64_t size)
+{
+	if (!gpu_live || gpu_arena_window_bytes == 0 || pa < gpu_arena_pa || size == 0) {
+		return;
+	}
+	gpu_arena_give_back((uint32_t)(pa - gpu_arena_pa), (uint32_t)((size + 0xfff) & ~0xfffull));
+}
+
+/* ---- stage 8e: the ABI the device node exposes ------------------------- */
+
+/* the driver state the ladder and the 8f surface share */
+
+static struct gpu_bo *
+gpu_bo_by_handle(uint32_t handle)
+{
+	for (unsigned i = 0; i < GPU_BO_MAX; i++) {
+		if (gpu_bos[i].used && gpu_bos[i].handle == handle) {
+			return &gpu_bos[i];
+		}
+	}
+	return NULL;
+}
+
+static int
+gpu_client_info(struct sweet_gpu_info *out)
+{
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	out->abi_version = 1;
+	out->flags = 1;                 /* live */
+	out->chip_id = 0x06030001u;
+	out->va_start = GPU_VA_BASE;
+	out->va_size = 0x00200000u;     /* the mapped window, one L3 */
+	out->last_fence = gpu_last_fence;
+	return 0;
+}
+
+static int
+gpu_client_gem_new(struct sweet_gpu_gem_new *arg)
+{
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	if (arg->size == 0 || arg->size > GPU_BO_MAX_BYTES) {
+		return EINVAL;
+	}
+	struct gpu_bo *bo = gpu_bo_alloc(arg->size);
+	if (bo == NULL) {
+		return ENOMEM;
+	}
+	arg->handle = bo->handle;
+	arg->iova = bo->va;
+	return 0;
+}
+
+static int
+gpu_client_gem_info(struct sweet_gpu_gem_info *arg)
+{
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	struct gpu_bo *bo = gpu_bo_by_handle(arg->handle);
+	if (bo == NULL) {
+		return EINVAL;
+	}
+	switch (arg->op) {
+	case SWEET_GPU_INFO_GET_IOVA:
+		arg->value = bo->va;
+		break;
+	case SWEET_GPU_INFO_GET_SIZE:
+		arg->value = (uint32_t)bo->size;
+		break;
+	case SWEET_GPU_INFO_GET_OFFSET:
+		arg->value = arg->handle;       /* the mmap offset in this port */
+		break;
+	default:
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+gpu_client_gem_submit(struct sweet_gpu_gem_submit *arg)
+{
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	struct gpu_bo *bo = gpu_bo_by_handle(arg->handle);
+	if (bo == NULL) {
+		return EINVAL;
+	}
+	if ((arg->offset & 3u) || arg->dwords == 0) {
+		return EINVAL;
+	}
+	if (arg->offset >= bo->size || arg->dwords * 4u > bo->size - arg->offset) {
+		return EINVAL;
+	}
+	if (!gpu_cp_submit(gpu_core, gpu_blob, bo->va + arg->offset, arg->dwords)) {
+		return EIO;
+	}
+	gpu_last_fence = gpu_cp_seq;
+	arg->fence = gpu_last_fence;
+	return 0;
+}
+
+static int
+gpu_client_wait(struct sweet_gpu_wait *arg)
+{
+	volatile uint32_t *ts;
+	unsigned ms;
+
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	if (arg->fence == 0 || arg->fence > gpu_last_fence) {
+		return EINVAL;
+	}
+	/* The CP keeps only the latest timestamp, so "done" means "reached at
+	 * least this fence". */
+	ts = (volatile uint32_t *)(gpu_blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE);
+	ms = arg->timeout_ms ? arg->timeout_ms : 1000;
+	for (unsigned i = 0; i < ms; i++) {
+		if (*ts >= arg->fence) {
+			return 0;
+		}
+		gpu_wait_ms(1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+gpu_client_gem_close(struct sweet_gpu_close *arg)
+{
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	struct gpu_bo *bo = gpu_bo_by_handle(arg->handle);
+	if (bo == NULL) {
+		return EINVAL;
+	}
+	gpu_bo_free(bo);
+	return 0;
+}
+
+/* ---- the selected buffer: read/write, because a device node cannot be mapped ---- */
+
+static uint32_t gpu_selected;
+
+static int
+gpu_client_select(struct sweet_gpu_select *arg)
+{
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	if (gpu_bo_by_handle(arg->handle) == NULL) {
+		return EINVAL;
+	}
+	gpu_selected = arg->handle;
+	return 0;
+}
+
+/* Copy n bytes of the selected buffer at off to/from the caller. */
+static int
+gpu_dev_io(dev_t dev, struct uio *uio, bool write)
+{
+	struct gpu_bo *bo;
+	off_t off = uio->uio_offset;
+
+	if (!gpu_live) {
+		return ENXIO;
+	}
+	bo = gpu_bo_by_handle(gpu_selected);
+	if (bo == NULL) {
+		return ENXIO;
+	}
+	if (off < 0 || (vm_size_t)off >= bo->size || uio_resid(uio) == 0) {
+		return EINVAL;
+	}
+	vm_size_t n = MIN((vm_size_t)uio_resid(uio), bo->size - (vm_size_t)off);
+	int err = uiomove((caddr_t)(bo->kva + off), (int)n, uio);
+
+	if (!write) {
+		return err;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return err;
+}
+
+static int
+sweet_gpu_dev_read(dev_t dev, struct uio *uio, int flags)
+{
+	return gpu_dev_io(dev, uio, false);
+}
+
+static int
+sweet_gpu_dev_write(dev_t dev, struct uio *uio, int flags)
+{
+	int rc = gpu_dev_io(dev, uio, true);
+
+	printf("SWEET GPU: write %d bytes at %lld -> %d\n", uio_resid(uio),
+	    (long long)uio->uio_offset, rc);
+	return rc;
+}
+
+/* devfs: one node, no per-open state, the GPU is a single system resource. */
+static int
+sweet_gpu_dev_open(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	int rc = gpu_live ? 0 : ENXIO;
+
+	/* The tool's console output can scroll away or go to a serial port we do not
+	 * have; the ring always sees this, so a client is visible as far as it got. */
+	(void)p;
+	printf("SWEET GPU: /dev/sweetgpu opened -> %d\n", rc);
+	return rc;
+}
+
+static int
+sweet_gpu_dev_close(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	return 0;
+}
+
+static int gpu_dev_ioctl(dev_t dev, u_long cmd, caddr_t data, int flags,
+    struct proc *p);
+
+static int
+sweet_gpu_dev_ioctl(dev_t dev, u_long cmd, caddr_t data, int flags, struct proc *p)
+{
+	int rc = gpu_dev_ioctl(dev, cmd, data, flags, p);
+
+	printf("SWEET GPU: ioctl %#lx -> %d\n", cmd, rc);
+	return rc;
+}
+
+static int
+gpu_dev_ioctl(dev_t dev, u_long cmd, caddr_t data, int flags, struct proc *p)
+{
+	switch (cmd) {
+	case SWEET_GPU_IOCTL_INFO:
+		return gpu_client_info((struct sweet_gpu_info *)data);
+	case SWEET_GPU_IOCTL_GEM_NEW:
+		return gpu_client_gem_new((struct sweet_gpu_gem_new *)data);
+	case SWEET_GPU_IOCTL_GEM_INFO:
+		return gpu_client_gem_info((struct sweet_gpu_gem_info *)data);
+	case SWEET_GPU_IOCTL_GEM_SUBMIT:
+		return gpu_client_gem_submit((struct sweet_gpu_gem_submit *)data);
+	case SWEET_GPU_IOCTL_WAIT_FENCE:
+		return gpu_client_wait((struct sweet_gpu_wait *)data);
+	case SWEET_GPU_IOCTL_GEM_CLOSE:
+		return gpu_client_gem_close((struct sweet_gpu_close *)data);
+	case SWEET_GPU_IOCTL_SELECT:
+		return gpu_client_select((struct sweet_gpu_select *)data);
+	default:
+		return ENOTTY;
+	}
+}
+
+static const struct cdevsw sweet_gpu_cdevsw = {
+	.d_open   = sweet_gpu_dev_open,
+	.d_close  = sweet_gpu_dev_close,
+	.d_read   = sweet_gpu_dev_read,
+	.d_write  = sweet_gpu_dev_write,
+	.d_ioctl  = sweet_gpu_dev_ioctl,
+	.d_stop   = eno_stop,
+	.d_reset  = eno_reset,
+	.d_select = eno_select,
+	.d_mmap   = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type   = 0,
+};
+
+static void
+gpu_dev_register(void)
+{
+	int major = cdevsw_add(-1, &sweet_gpu_cdevsw);
+
+	if (major < 0) {
+		printf("SWEET GPU: cannot add the device node (%d)\n", major);
+		return;
+	}
+	void *node = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_WHEEL, 0666, "sweetgpu");
+	printf("SWEET GPU: /dev/sweetgpu major %d %s\n", major,
+	    node ? "ready" : "NOT created");
+}
+
+/* The same calls the ioctl makes, driven from the kernel so the ABI is exercised
+ * before any userspace tool exists. */
+static bool
+gpu_abi_test(void)
+{
+	struct sweet_gpu_info info = { 0 };
+	struct sweet_gpu_gem_new newcmd;
+	struct sweet_gpu_gem_info geminfo;
+	struct sweet_gpu_gem_submit submit;
+	struct sweet_gpu_wait wait;
+	struct sweet_gpu_close closecmd;
+	static const uint32_t v[2] = { 0xc0de0001u, 0xc0de0002u };
+
+	if (gpu_client_info(&info) != 0) {
+		printf("SWEET GPU: abi test: INFO failed\n");
+		return false;
+	}
+
+	newcmd = (struct sweet_gpu_gem_new) { .size = 0x2000, .flags = 0 };
+	if (gpu_client_gem_new(&newcmd) != 0) {
+		printf("SWEET GPU: abi test: GEM_NEW failed\n");
+		return false;
+	}
+	struct sweet_gpu_gem_new dst = { .size = 0x1000, .flags = 0 };
+	if (gpu_client_gem_new(&dst) != 0) {
+		printf("SWEET GPU: abi test: GEM_NEW failed\n");
+		return false;
+	}
+	struct gpu_bo *cmd_bo = gpu_bo_by_handle(newcmd.handle);
+	struct gpu_bo *dst_bo = gpu_bo_by_handle(dst.handle);
+	if (cmd_bo == NULL || dst_bo == NULL) {
+		printf("SWEET GPU: abi test: handles do not resolve\n");
+		return false;
+	}
+
+	/* The client writes its packets through the mapped buffer. */
+	volatile uint32_t *ib = (volatile uint32_t *)cmd_bo->kva;
+	unsigned n = 0;
+	ib[n++] = gpu_pkt7(GPU_CP_NOP, 1);
+	ib[n++] = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		ib[n++] = gpu_pkt7(GPU_CP_MEM_WRITE, 3);
+		ib[n++] = dst_bo->va + 0x10u * (i + 1);
+		ib[n++] = 0;
+		ib[n++] = v[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	submit = (struct sweet_gpu_gem_submit) { .handle = newcmd.handle, .offset = 0, .dwords = n };
+	if (gpu_client_gem_submit(&submit) != 0) {
+		printf("SWEET GPU: abi test: GEM_SUBMIT failed\n");
+		return false;
+	}
+	wait = (struct sweet_gpu_wait) { .fence = submit.fence, .timeout_ms = 2000 };
+	int w = gpu_client_wait(&wait);
+
+	geminfo = (struct sweet_gpu_gem_info) { .handle = dst.handle, .op = SWEET_GPU_INFO_GET_IOVA };
+	int g = gpu_client_gem_info(&geminfo);
+
+	volatile uint32_t *out = (volatile uint32_t *)dst_bo->kva;
+	bool ok = w == 0 && g == 0 && geminfo.value == dst_bo->va &&
+	    out[4] == v[0] && out[8] == v[1];
+	printf("SWEET GPU: abi test: INFO abi %u chip %#x va %#x+%#x; GEM_NEW 0x%x/0x%x 0x%x/0x%x; "
+	    "SUBMIT %u dwords fence %u wait %d; GET_IOVA %#x; got %#x/%#x (want %#x/%#x)\n",
+	    info.abi_version, info.chip_id, info.va_start, info.va_size,
+	    newcmd.handle, newcmd.iova, dst.handle, dst.iova, submit.dwords, submit.fence, w,
+	    geminfo.value, out[4], out[8], v[0], v[1]);
+
+	closecmd = (struct sweet_gpu_close) { .handle = dst.handle };
+	int c1 = gpu_client_gem_close(&closecmd);
+	closecmd = (struct sweet_gpu_close) { .handle = newcmd.handle };
+	int c2 = gpu_client_gem_close(&closecmd);
+
+	/* A closed handle must be refused, not trusted. */
+	geminfo = (struct sweet_gpu_gem_info) { .handle = dst.handle, .op = SWEET_GPU_INFO_GET_IOVA };
+	int refusals = gpu_client_gem_info(&geminfo) == EINVAL;
+	bool bad = gpu_client_gem_submit(&(struct sweet_gpu_gem_submit){ .handle = 9999,
+		.dwords = 1 }) == EINVAL;
+
+	printf("SWEET GPU: abi test: close %d/%d, closed handle refused %s, bad handle refused %s\n",
+	    c1, c2, refusals ? "yes" : "NO", bad ? "yes" : "NO");
+	ok = ok && c1 == 0 && c2 == 0 && refusals && bad;
+	/* SELECT is testable here; the read/write that follows it needs a user
+	 * context (uiomove), so it is only reported as armed. */
+	struct sweet_gpu_gem_new io_bo = { .size = 0x1000, .flags = 0 };
+	bool sel_ok = false;
+	if (gpu_client_gem_new(&io_bo) == 0) {
+		struct sweet_gpu_select sel = { .handle = io_bo.handle };
+		sel_ok = gpu_client_select(&sel) == 0 &&
+		    gpu_client_select(&(struct sweet_gpu_select){ .handle = 9999 }) == EINVAL;
+		closecmd = (struct sweet_gpu_close) { .handle = io_bo.handle };
+		(void)gpu_client_gem_close(&closecmd);
+	}
+	printf("SWEET GPU: abi test: SELECT ok %s, unknown handle refused, read/write armed\n",
+	    sel_ok ? "yes" : "NO");
+
+	/* the address space a real client uses: full range, page tables on demand */
+	uint64_t capv = 0;
+	bool param_ok = sweet_gpu_param(GPU_PARAM_GPU_ID, &capv) && capv == 630;
+	param_ok = param_ok && sweet_gpu_param(GPU_PARAM_VA_SIZE, &capv) && capv == GPU_VA_BYTES;
+	param_ok = param_ok && !sweet_gpu_param(999, &capv);
+
+	uint64_t a = 0, b = 0, c = 0, taken = 0;
+	bool reuse = false, map_ok = false, taken_ok = false;
+	if (sweet_gpu_iova_alloc(0x300000, &a, &taken) &&          /* 3 MiB: two L3 chunks */
+	    sweet_gpu_iova_alloc(0x1000, &b, &taken)) {
+		uint64_t far = a + 0x200000;                      /* the next 2 MiB chunk */
+		taken_ok = taken == 0x1000;                       /* the last one asked */
+		if (sweet_gpu_vm_map(a, gpu_arena_pa, false) &&
+		    sweet_gpu_vm_map(far, gpu_arena_pa + 0x1000, true)) {
+			volatile uint64_t *l3a = gpu_l3_for(a);
+			volatile uint64_t *l3b = gpu_l3_for(far);
+
+			map_ok = l3a != NULL && l3b != NULL && l3a != l3b &&
+			    l3a[(a >> 12) & 0x1ff] == (gpu_arena_pa | GPU_PTE_PAGE) &&
+			    l3b[(far >> 12) & 0x1ff] ==
+			    ((gpu_arena_pa + 0x1000) | GPU_PTE_PAGE | (1ull << 7));
+			sweet_gpu_vm_unmap(a, 0x300000);
+			map_ok = map_ok && l3a[(a >> 12) & 0x1ff] == 0;
+		}
+		sweet_gpu_iova_free(a, 0x300000);
+		reuse = sweet_gpu_iova_alloc(0x300000, &c, &taken) && c == a;
+		sweet_gpu_iova_free(b, 0x1000);
+		sweet_gpu_iova_free(c, 0x300000);
+	}
+
+	sweet_gpu_report("after the capi test");
+	printf("SWEET GPU: capi test: ready %d; va %#x..%#llx; param %s; taken %s; "
+	    "two-l3 map/unmap %s; reuse %s; tables %u of %u\n",
+	    sweet_gpu_ready(), GPU_VA_BASE,
+	    (unsigned long long)(GPU_VA_BASE + GPU_VA_BYTES - 1),
+	    param_ok ? "yes" : "NO", taken_ok ? "yes" : "NO", map_ok ? "yes" : "NO",
+	    reuse ? "yes" : "NO", gpu_pte_used, gpu_pte_tables);
+
+	ok = ok && param_ok && taken_ok && map_ok && reuse;
+	printf("SWEET GPU: abi test: %s\n", ok ?
+	    "PASSED - INFO, GEM_NEW, SUBMIT, WAIT_FENCE, GEM_INFO, GEM_CLOSE, the C surface" : "FAILED");
+	return ok;
+}
+
+/* ---- stage 7c: the zap shader through SCM/PAS -------------------------- */
+
+static bool gpu_zap_started;    /* AUTH_AND_RESET returned 0: SHUTDOWN is owed */
+
+struct gpu_scm_regs {
+	uint64_t a[7];
+};
+
+/* SMCCC64: x0 carries the function id, x1 the arginfo, then the arguments. */
+static void
+gpu_scm_smccc(struct gpu_scm_regs *r)
+{
+	register uint64_t x0 __asm__("x0") = r->a[0];
+	register uint64_t x1 __asm__("x1") = r->a[1];
+	register uint64_t x2 __asm__("x2") = r->a[2];
+	register uint64_t x3 __asm__("x3") = r->a[3];
+	register uint64_t x4 __asm__("x4") = r->a[4];
+	register uint64_t x5 __asm__("x5") = r->a[5];
+	register uint64_t x6 __asm__("x6") = r->a[6];
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6)
+	    : : "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+	        "x17", "cc", "memory");
+	*r = (struct gpu_scm_regs) { { x0, x1, x2, x3, x4, x5, x6 } };
+}
+
+/* Reissue interrupted calls (x0 == 1, x6 holds the continuation token); retry busy. */
+static bool
+gpu_scm_invoke(const struct gpu_scm_regs *initial, struct gpu_scm_regs *out)
+{
+	for (unsigned busy = 0; busy <= SCM_BUSY_LIMIT; busy++) {
+		*out = *initial;
+		for (unsigned resume = 0;; resume++) {
+			gpu_scm_smccc(out);
+			if ((int32_t)out->a[0] != SCM_INTERRUPTED) {
+				break;
+			}
+			if (resume == SCM_RESUME_LIMIT) {
+				printf("SWEET GPU: SCM call interrupted without completing\n");
+				return false;
+			}
+		}
+		if ((int32_t)out->a[0] != SCM_BUSY) {
+			return true;
+		}
+		if (busy == SCM_BUSY_LIMIT) {
+			printf("SWEET GPU: SCM busy; giving up\n");
+			return false;
+		}
+		gpu_wait_ms(30);
+	}
+	return false;
+}
+
+static int
+gpu_scm_pas(const char *name, uint32_t cmd, uint32_t arginfo, uint64_t arg1, uint64_t arg2)
+{
+	struct gpu_scm_regs r;
+	const struct gpu_scm_regs initial = {
+		{ SCM_64 | SCM_SIP | 0x0200u | cmd, arginfo, SCM_PAS_GPU, arg1, arg2, 0, 0 }
+	};
+	printf("SWEET GPU: scm pas %s fn=%#llx arginfo=%#x args=%#llx/%#llx\n",
+	    name, (unsigned long long)initial.a[0], arginfo,
+	    (unsigned long long)arg1, (unsigned long long)arg2);
+	__asm__ volatile("dsb sy" ::: "memory");
+	bool done = gpu_scm_invoke(&initial, &r);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (!done) {
+		return -1;
+	}
+	printf("SWEET GPU: scm pas %s: status %d result %d\n",
+	    name, (int32_t)r.a[0], (int32_t)r.a[1]);
+	return (int32_t)r.a[0] == 0 && (int32_t)r.a[1] == 0 ? 0 : -1;
+}
+
+/* SCM_INFO IS_CALL_AVAILABLE for the four PAS calls: logged, never fatal. */
+static void
+gpu_scm_availability(void)
+{
+	static const struct { const char *name; uint32_t cmd; } q[] = {
+		{ "INIT_IMAGE", 1 }, { "MEM_SETUP", 2 }, { "AUTH_AND_RESET", 5 }, { "SHUTDOWN", 6 },
+	};
+	for (unsigned i = 0; i < sizeof(q) / sizeof(q[0]); i++) {
+		struct gpu_scm_regs r;
+		const struct gpu_scm_regs init = {
+			{ SCM_64 | SCM_INFO_AVAIL, 1, SCM_SIP | 0x0200u | q[i].cmd, 0, 0, 0, 0 }
+		};
+		if (gpu_scm_invoke(&init, &r)) {
+			printf("SWEET GPU: scm pas %s available: status %d result %llu\n",
+			    q[i].name, (int32_t)r.a[0], (unsigned long long)r.a[1]);
+		}
+	}
+}
+
+static uint32_t
+gpu_u32le(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint16_t
+gpu_u16le(const uint8_t *p)
+{
+	return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+}
+
+/*
+ * qcom_mdt_load + qcom_scm_pas_auth_and_reset: hand the metadata to the secure
+ * world, set up the carve-out, copy the loadable segment in and start it.
+ */
+static bool
+gpu_zap_load(vm_offset_t blob, uint64_t blob_pa)
+{
+	const uint8_t *e = (const uint8_t *)(uintptr_t)(blob + GPU_ZAP_MDT);
+	const uint64_t meta_pa = blob_pa + GPU_ZAP_MDT;
+
+	uint32_t phoff = gpu_u32le(e + 28);
+	unsigned phnum = gpu_u16le(e + 44);
+	printf("SWEET GPU: zap metadata at +%#x (PA %#llx): magic %#x class %u bits %u phnum %u phoff %u\n",
+	    GPU_ZAP_MDT, (unsigned long long)meta_pa, gpu_u32le(e), e[4], gpu_u16le(e + 42), phnum, phoff);
+	if (gpu_u32le(e) != 0x464c457fu || e[4] != 1 || e[5] != 1 || gpu_u16le(e + 42) != 32 ||
+	    phnum == 0 || phnum > MDT_MAX_PHDRS || phoff < 52 ||
+	    phoff + 32u * phnum > GPU_ZAP_MDT_MAX) {
+		printf("SWEET GPU: a630_zap.mdt is not a Qualcomm ELF32; zap skipped\n");
+		return false;
+	}
+
+	/* The extent of the loadable, non-hash segments. */
+	uint64_t min_addr = ~0ull, max_addr = 0;
+	bool relocate = false;
+	for (unsigned i = 0; i < phnum; i++) {
+		const uint8_t *p = e + phoff + 32 * i;
+		uint32_t type = gpu_u32le(p), paddr = gpu_u32le(p + 12);
+		uint32_t filesz = gpu_u32le(p + 16), memsz = gpu_u32le(p + 20);
+		uint32_t flags = gpu_u32le(p + 24);
+		printf("SWEET GPU: zap phdr %u: type %u off %#x paddr %#x filesz %u memsz %u flags %#x\n",
+		    i, type, gpu_u32le(p + 4), paddr, filesz, memsz, flags);
+		if (type != MDT_PT_LOAD || (flags & MDT_TYPE_MASK) == MDT_TYPE_HASH || memsz == 0) {
+			continue;
+		}
+		relocate = relocate || !!(flags & MDT_RELOCATABLE);
+		if (paddr < min_addr) {
+			min_addr = paddr;
+		}
+		uint64_t end = ((uint64_t)paddr + memsz + 0xfffull) & ~0xfffull;
+		if (end > max_addr) {
+			max_addr = end;
+		}
+	}
+	if (min_addr == ~0ull || max_addr <= min_addr || max_addr - min_addr > ZAP_REGION_SIZE) {
+		printf("SWEET GPU: zap extent %#llx-%#llx does not fit the %#x byte carve-out; zap skipped\n",
+		    (unsigned long long)min_addr, (unsigned long long)max_addr, ZAP_REGION_SIZE);
+		return false;
+	}
+	uint32_t mem_size = (uint32_t)(max_addr - min_addr);
+	printf("SWEET GPU: zap: %s image, %u bytes -> carve-out %#llx (%u bytes)\n",
+	    relocate ? "relocatable" : "fixed", mem_size, (unsigned long long)ZAP_REGION_PA, ZAP_REGION_SIZE);
+	if (!relocate && min_addr != ZAP_REGION_PA) {
+		printf("SWEET GPU: fixed-address zap outside the carve-out; zap skipped\n");
+		return false;
+	}
+
+	gpu_scm_availability();
+
+	if (gpu_scm_pas("INIT_IMAGE", 1, 0x82, meta_pa, 0) != 0) {
+		printf("SWEET GPU: zap INIT_IMAGE failed\n");
+		return false;
+	}
+	if (gpu_scm_pas("MEM_SETUP", 2, 3, ZAP_REGION_PA, mem_size) != 0) {
+		printf("SWEET GPU: zap MEM_SETUP failed\n");
+		(void)gpu_scm_pas("SHUTDOWN", 6, 1, 0, 0);
+		return false;
+	}
+
+	vm_offset_t region = ml_io_map((vm_offset_t)ZAP_REGION_PA, ZAP_REGION_SIZE);
+	if (region == 0) {
+		printf("SWEET GPU: cannot map the zap carve-out\n");
+		(void)gpu_scm_pas("SHUTDOWN", 6, 1, 0, 0);
+		return false;
+	}
+	for (uint32_t o = 0; o < mem_size; o += 4) {
+		*(volatile uint32_t *)(region + o) = 0;
+	}
+	for (unsigned i = 0; i < phnum; i++) {
+		const uint8_t *p = e + phoff + 32 * i;
+		uint32_t type = gpu_u32le(p), paddr = gpu_u32le(p + 12);
+		uint32_t filesz = gpu_u32le(p + 16), memsz = gpu_u32le(p + 20);
+		uint32_t flags = gpu_u32le(p + 24);
+		if (type != MDT_PT_LOAD || (flags & MDT_TYPE_MASK) == MDT_TYPE_HASH ||
+		    memsz == 0 || filesz == 0) {
+			continue;
+		}
+		/* Only the single loadable segment travels in the blob (b02). */
+		const uint8_t *s = (const uint8_t *)(uintptr_t)(blob + GPU_ZAP_SEG);
+		uint64_t off = relocate ? (uint64_t)paddr - min_addr : (uint64_t)paddr - ZAP_REGION_PA;
+		if (off + filesz > mem_size) {
+			printf("SWEET GPU: zap segment %u outside the image\n", i);
+			(void)gpu_scm_pas("SHUTDOWN", 6, 1, 0, 0);
+			return false;
+		}
+		for (uint32_t o = 0; o < filesz; o += 4) {
+			uint32_t w = 0;
+			for (uint32_t b = 0; b < 4 && o + b < filesz; b++) {
+				w |= (uint32_t)s[o + b] << (8 * b);
+			}
+			*(volatile uint32_t *)(region + off + o) = w;
+		}
+		printf("SWEET GPU: zap segment %u: %u bytes -> carve-out +%#llx\n",
+		    i, filesz, (unsigned long long)off);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	if (gpu_scm_pas("AUTH_AND_RESET", 5, 1, 0, 0) != 0) {
+		printf("SWEET GPU: zap AUTH_AND_RESET failed\n");
+		return false;
+	}
+	printf("SWEET GPU: zap authenticated and started (PAS %u quiesced into reset)\n", SCM_PAS_GPU);
+	gpu_zap_started = true;
+	return true;
+}
+
+/* Released once the test is done: the secure world should not hold the GPU while
+ * the GMU goes back into reset. */
+static void
+gpu_zap_shutdown(void)
+{
+	if (!gpu_zap_started) {
+		return;
+	}
+	gpu_zap_started = false;
+	printf("SWEET GPU: zap shutdown (PAS %u)\n", SCM_PAS_GPU);
+	(void)gpu_scm_pas("SHUTDOWN", 6, 1, 0, 0);
+}
+
+/* ---- stage 5: the GX rail through the GMU's OOB interface ------------- */
+
+/* HOST2GMU_INTR_SET / GMU2HOST_INTR_INFO are the ones stage 4 already uses. */
+
+/* a6xx_gmu_gfx_rail_on: vote the boot level's ARC indices, then the boot OOB. */
+static bool
+gpu_gx_rail_on(vm_offset_t gmu)
+{
+	/* gpu_levels[] for a630: MHz and the VLVL Linux sends for each. */
+	static const struct { uint32_t mhz, vlvl; } levels[] = {
+		{ 0, 0 }, { 257, 64 }, { 342, 128 }, { 414, 192 },
+		{ 520, 256 }, { 596, 320 }, { 675, 384 }, { 710, 416 },
+	};
+	uint16_t gfx[16], mx[16], cx[16];
+	uint32_t a = 0;
+	unsigned ngfx = 0, nmx = 0, ncx = 0;
+	const uint32_t boot_vlvl = 64;            /* 257 MHz, initial-pwrlevel 6 */
+	unsigned gi = 0, mi = 0;
+
+	if (gpu_cmddb_lookup("gfx.lvl", &a, gfx, 16) != (int)GPU_CMDDB_SLAVE_ARC ||
+	    gpu_cmddb_lookup("mx.lvl", &a, mx, 16) != (int)GPU_CMDDB_SLAVE_ARC) {
+		printf("SWEET GPU: no gfx.lvl/mx.lvl in the command DB; GX rail not voted\n");
+		return false;
+	}
+	(void)gpu_cmddb_lookup("cx.lvl", &a, cx, 16);
+	for (ngfx = 1; ngfx < 16 && !(gfx[ngfx - 1] && !gfx[ngfx]); ngfx++) {
+	}
+	for (nmx = 1; nmx < 16 && !(mx[nmx - 1] && !mx[nmx]); nmx++) {
+	}
+	for (ncx = 1; ncx < 16 && !(cx[ncx - 1] && !cx[ncx]); ncx++) {
+	}
+	printf("SWEET GPU: ARC levels: gfx %u (", ngfx);
+	for (unsigned i = 0; i < ngfx; i++) {
+		printf("%u ", gfx[i]);
+	}
+	printf(") mx %u (", nmx);
+	for (unsigned i = 0; i < nmx; i++) {
+		printf("%u ", mx[i]);
+	}
+	printf(") cx %u\n", ncx);
+	while (gi < ngfx && gfx[gi] < boot_vlvl) {
+		gi++;
+	}
+	while (mi < nmx && mx[mi] < boot_vlvl) {
+		mi++;
+	}
+	if (gi >= ngfx || mi >= nmx) {
+		printf("SWEET GPU: no ARC level covers VLVL %u (gfx %u/%u, mx %u/%u)\n",
+		    boot_vlvl, gi, ngfx, mi, nmx);
+		return false;
+	}
+	printf("SWEET GPU: GX rail at 257 MHz (VLVL %u): gfx ARC %u, mx ARC %u\n", boot_vlvl, gi, mi);
+	(void)levels;
+
+	gpu_probe_wr("gmu boot slumber opt", gmu, GPU_GMU_BOOT_SLUMBER, 0);
+	gpu_probe_wr("gmu gx vote idx", gmu, GPU_GMU_GX_VOTE_IDX, gi);
+	gpu_probe_wr("gmu mx vote idx", gmu, GPU_GMU_MX_VOTE_IDX, mi);
+	gpu_probe_wr("gmu oob boot slumber", gmu, GPU_GMU_HOST2GMU_SET, 1u << (GPU_OOB_BOOT_SLUMBER + 16));
+
+	bool ok = false;
+	uint32_t info = 0;
+	for (int i = 0; i < 100; i++) {
+		info = gpu_rd_quiet(gmu, GPU_GMU_GMU2HOST_INFO);
+		if (info & (1u << (GPU_OOB_BOOT_SLUMBER + 24))) {
+			ok = true;
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	printf("SWEET GPU: OOB boot_slumber: %s (INTR_INFO %#x, RPMH_POWER_STATE %#x, SPTPRAC %#x)\n",
+	    ok ? "acknowledged" : "TIMED OUT", info, gpu_rd_quiet(gmu, 0x143b0u),
+	    gpu_rd_quiet(gmu, GPU_GMU_SPTPRAC_STATUS));
+	gpu_wr_quiet(gmu, GPU_GMU_GMU2HOST_CLR, 1u << (GPU_OOB_BOOT_SLUMBER + 24));
+	return ok;
+}
+
+/* a6xx_sptprac_enable: legacy GMUs leave the 3D core's power to the CPU. */
+static bool
+gpu_sptprac_on(vm_offset_t gmu)
+{
+	gpu_probe_wr("gmu sptprac ctrl", gmu, GPU_GMU_GX_SPTPRAC_POWER, 0x778000u);
+	bool ok = false;
+	uint32_t st = 0;
+	for (int i = 0; i < 100; i++) {
+		st = gpu_rd_quiet(gmu, GPU_GMU_SPTPRAC_STATUS);
+		if ((st & 0x38u) == 0x28u) {
+			ok = true;
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	printf("SWEET GPU: SPTPRAC power on: %s (status %#x)\n", ok ? "ok" : "TIMED OUT", st);
+	return ok;
+}
+
+/* ---- the HFI queues, once stage 4 has them running --------------------- */
+
+static vm_offset_t hfi_gmu;
+static volatile uint32_t *hfi_cmd_qh, *hfi_msg_qh, *hfi_cmd_data, *hfi_msg_data;
+
+/*
+ * Send one message and wait for its answer. Returns the reply's id, or -1.
+ * The reply is read at the MSG queue's read index and that index is advanced by
+ * the reply's own dword count, so several messages can follow each other.
+ */
+static int
+gpu_hfi_send(const uint32_t *msg, unsigned n, const char *what)
+{
+	if (hfi_cmd_qh == NULL || hfi_msg_qh == NULL) {
+		return -1;
+	}
+	uint32_t w = hfi_cmd_qh[11] % 1024u;
+	for (unsigned i = 0; i < n; i++) {
+		hfi_cmd_data[(w + i) % 1024u] = msg[i];
+	}
+	hfi_cmd_qh[11] = (w + n) % 1024u;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	gpu_wr_quiet(hfi_gmu, GPU_GMU_HOST2GMU_SET, 1);
+
+	uint32_t info = 0;
+	for (int i = 0; i < 200; i++) {
+		info = gpu_rd_quiet(hfi_gmu, GPU_GMU_GMU2HOST_INFO);
+		if (info & 1u) {
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	if (!(info & 1u)) {
+		printf("SWEET GPU: hfi %s: no answer from the GMU\n", what);
+		return -1;
+	}
+	gpu_wr_quiet(hfi_gmu, GPU_GMU_GMU2HOST_CLR, 1);
+
+	uint32_t r = hfi_msg_qh[10] % 1024u;
+	uint32_t hdr = hfi_msg_data[r];
+	uint32_t dw = (hdr >> 8) & 0xffu;
+	uint32_t ack_hdr = hfi_msg_data[(r + 1) % 1024u];
+	uint32_t error = hfi_msg_data[(r + 2) % 1024u];
+	uint32_t data = hfi_msg_data[(r + 3) % 1024u];
+	hfi_msg_qh[10] = (r + (dw ? dw : 4u)) % 1024u;
+	__asm__ volatile("dmb oshst" ::: "memory");
+
+	printf("SWEET GPU: hfi %s: reply %#x (id %u, %u words, type %u), request %#x, error %#x, data %#x\n",
+	    what, hdr, hdr & 0xffu, dw, (hdr >> 16) & 0xfu, ack_hdr, error, data);
+	if (((hdr >> 16) & 0xfu) != 2u) {                 /* HFI_V1_MSG_ACK */
+		printf("SWEET GPU: hfi %s: that is not an ACK\n", what);
+		return -1;
+	}
+	if (error) {
+		printf("SWEET GPU: hfi %s: the GMU refused it (error %u)\n", what, error);
+		return -1;
+	}
+	/* The ACK's own id is 126; the id it echoes in ack[1] is the request it answers. */
+	return (int)(ack_hdr & 0xffu);
+}
+
+void
+sweet_gpu_probe(void)
+{
+	int level = 0;
+	vm_offset_t gcc, cc, dbgc, misc, gmu, smmu, gpu, qf, db;
+
+	(void)PE_parse_boot_argn("adreno", &level, sizeof(level));
+	if (level < 1) {
+		printf("SWEET GPU: probe off (adreno=1 enables it)\n");
+		return;
+	}
+	/* The PLL vote lives at +0x5200c and the GPU clocks at +0x71004, so the
+	 * block needs 0x80000; smaller maps left the reads outside the mapping and
+	 * froze the bus (0x20000 in 0099, 0x60000 in 0102). */
+	gcc = ml_io_map(GPU_GCC, 0x80000);
+	cc = ml_io_map(GPU_CC, 0x9000);
+	dbgc = ml_io_map(GPU_CX_DBGC, 0x800);
+	misc = ml_io_map(GPU_CX_MISC, 0x1000);
+	gmu = ml_io_map(GPU_GMU, 0x30000);
+	smmu = ml_io_map(GPU_SMMU, 0x10000);
+	gpu = ml_io_map(GPU_PA, 0x40000);
+	qf = ml_io_map(GPU_QFPROM, 0x1000);
+	db = ml_io_map(GPU_CMD_DB, 0x1000);
+	printf("SWEET GPU: level %d, maps gcc=%p cc=%p dbgc=%p misc=%p gmu=%p smmu=%p gpu=%p qf=%p db=%p\n",
+	    level, (void *)gcc, (void *)cc, (void *)dbgc, (void *)misc, (void *)gmu,
+	    (void *)smmu, (void *)gpu, (void *)qf, (void *)db);
+	/*
+	 * Order matters: start with registers this port already touches, end with
+	 * the ones that may need a rail/clock voted first. 0x52000 is HackiOS's
+	 * PLL-vote offset on their SoC and hung the bus here - 0x5200c is the
+	 * register the touch driver already uses.
+	 */
+	(void)gpu_probe_rd("gcc", gcc, 0x5200c);
+	(void)gpu_probe_rd("qfprom", qf, 0x1e8);
+	(void)gpu_probe_rd("cmd-db", db, 0x04);
+	(void)gpu_probe_rd("gpucc", cc, 0x100c);        /* GX_GDSCR */
+	(void)gpu_probe_rd("gpucc", cc, 0x106c);        /* CX_GDSCR */
+	(void)gpu_probe_rd("gpucc", cc, 0x1098);        /* CX_GMU_CBCR */
+	(void)gpu_probe_rd("gpucc", cc, 0x1120);        /* GMU_RCGR */
+	(void)gpu_probe_rd("smmu", smmu, 0x00);         /* IDR0 */
+	(void)gpu_probe_rd("smmu", smmu, 0x04);         /* IDR1 */
+	(void)gpu_probe_rd("smmu", smmu, 0x08);         /* IDR2 */
+	(void)gpu_probe_rd("smmu", smmu, 0x30);         /* SCR0 */
+	(void)gpu_probe_rd("gmu", gmu, 0x501c);         /* FW_INIT_RESULT */
+	(void)gpu_probe_rd("gmu", gmu, 0x5000);         /* CM3_SYSRESET */
+	(void)gpu_probe_rd("gpu", gpu, 0x0000);
+	(void)gpu_probe_rd("dbgc", dbgc, 0x00);
+	(void)gpu_probe_rd("misc", misc, 0x00);
+	printf("SWEET GPU: probe done\n");
+	if (level < 2) {
+		return;
+	}
+
+	/*
+	 * adreno=8 leaves the block's power and clocks alone: every access this
+	 * probe has made to them seems to make the next one less likely to answer,
+	 * so the firmware is tried with the block exactly as the boot loader left
+	 * it.
+	 */
+	if (level == 8) {
+		/* Exactly 8: the diagnostic that leaves the block as the boot loader left
+		 * it. 9 and above need the power-on (0115 wrote >= 8, which quietly kept
+		 * the block off in every adreno=9 boot up to console58). */
+		printf("SWEET GPU: level %d: no power or clock writes, straight to the GMU\n", level);
+		goto gmu_only;
+	}
+
+	/* ---- stage 2a: the first writes ------------------------------------- */
+	printf("SWEET GPU: --- stage 2a: power\n");
+	uint32_t ahb = gpu_probe_rd("gcc", gcc, GPU_GCC_CFG_AHB);
+	if (ahb & CBCR_OFF) {
+		gpu_probe_wr("gcc", gcc, GPU_GCC_CFG_AHB, ahb | 1u);
+		for (int i = 0; i < 50; i++) {
+			if (!(gpu_probe_rd("gcc", gcc, GPU_GCC_CFG_AHB) & CBCR_OFF)) {
+				break;
+			}
+			gpu_wait_ms(1);
+		}
+		printf("SWEET GPU: gpu_cfg_ahb = %#x%s\n",
+		    gpu_probe_rd("gcc", gcc, GPU_GCC_CFG_AHB),
+		    (gpu_probe_rd("gcc", gcc, GPU_GCC_CFG_AHB) & CBCR_OFF) ? " (still halted)" : "");
+	}
+
+	uint32_t cx = gpu_probe_rd("gpucc", cc, GPUCC_CX_GDSCR);
+	uint32_t hw = gpu_probe_rd("gpucc", cc, GPUCC_CX_HW_CTRL);
+	if (((cx | hw) & GDSC_POWER_ON) == 0) {
+		if (cx & GDSC_HW_CONTROL) {
+			printf("SWEET GPU: CX is under hardware control; not operating it\n");
+		} else {
+			gpu_probe_wr("gpucc", cc, GPUCC_CX_GDSCR, cx & ~GDSC_SW_COLLAPSE);
+			for (int i = 0; i < 500; i++) {
+				cx = *(volatile uint32_t *)(cc + GPUCC_CX_GDSCR);
+				hw = *(volatile uint32_t *)(cc + GPUCC_CX_HW_CTRL);
+				if ((cx | hw) & GDSC_POWER_ON) {
+					break;
+				}
+				gpu_wait_ms(1);
+			}
+			printf("SWEET GPU: cx_gdscr = %#x cx_hw_ctrl = %#x -> %s\n", cx, hw,
+			    ((cx | hw) & GDSC_POWER_ON) ? "ON" : "STILL OFF");
+		}
+	} else {
+		printf("SWEET GPU: CX was already on (%#x|%#x)\n", cx, hw);
+	}
+	(void)gpu_probe_rd("gpucc", cc, GPUCC_GX_GDSCR);
+	printf("SWEET GPU: stage 2a done\n");
+	if (level < 3) {
+		return;
+	}
+
+	/* ---- stage 2b: clock branches (no PLL vote, no RCG reprogramming) ----- */
+	printf("SWEET GPU: --- stage 2b: clocks\n");
+	static const struct {
+		const char *what;
+		int gcc;                /* 1 = GCC block, 0 = gpucc */
+		uint32_t off;
+	} branches[] = {
+		{ "gcc gpu_memnoc_gfx",   1, GPU_GCC_MEMNOC_GFX },
+		{ "gcc gpu_snoc_dvm_gfx", 1, GPU_GCC_SNOC_DVM },
+		{ "gcc ddrss_gpu_axi",    1, 0x44038u },
+		/* Only what gpucc-sdm845.c has: cb/hub_aon/hub_cx_int/smmu vote are
+		 * a660 clocks, and their offsets on this chip are something else. */
+		{ "gpucc cxo",            0, 0x109cu },
+		{ "gpucc ahb",            0, 0x1078u },
+		{ "gpucc cx_gmu",         0, 0x1098u },
+	};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); i++) {
+		vm_offset_t base = branches[i].gcc ? gcc : cc;
+		uint32_t off = branches[i].off;
+		uint32_t v = gpu_probe_rd(branches[i].what, base, off);
+		if ((v & CBCR_OFF) || !(v & 1u)) {
+			gpu_probe_wr(branches[i].what, base, off, (v & ~CBCR_OFF) | 1u);
+		}
+		uint32_t now = gpu_probe_rd(branches[i].what, base, off);
+		printf("SWEET GPU: %s = %#x%s\n", branches[i].what, now,
+		    (now & CBCR_OFF) ? " (halted)" : " (running)");
+	}
+	printf("SWEET GPU: stage 2b done\n");
+	if (level < 4) {
+		return;
+	}
+
+	/* ---- stage 2c: the PLL tap and the two clock roots -------------------- */
+	printf("SWEET GPU: --- stage 2c: clock roots\n");
+	uint32_t vote = gpu_probe_rd("gcc pll vote", gcc, GPU_GCC_PLL_VOTE);
+	if (!(vote & GPU_GCC_PLL_VOTE_GPU_DIV)) {
+		gpu_probe_wr("gcc pll vote", gcc, GPU_GCC_PLL_VOTE,
+		    (vote & ~CBCR_OFF) | GPU_GCC_PLL_VOTE_GPU_DIV);
+		(void)gpu_probe_rd("gcc pll vote", gcc, GPU_GCC_PLL_VOTE);
+	}
+	static const struct {
+		const char *what;
+		uint32_t rcgr;
+		uint32_t sel;
+	} roots[] = {
+		{ "gmu_clk_src", GPUCC_GMU_RCGR, GPU_RCG_GPLL0_DIV(3) },   /* 300 MHz / 1.5 */
+		{ "hub_clk_src", GPUCC_HUB_RCGR, GPU_RCG_GPLL0_DIV(4) },   /* 300 MHz / 2 */
+	};
+	for (unsigned i = 0; i < sizeof(roots) / sizeof(roots[0]); i++) {
+		uint32_t was = gpu_probe_rd(roots[i].what, cc, roots[i].rcgr + 4);
+		if ((was & GPU_RCG_SOURCE_MASK) != roots[i].sel) {
+			gpu_probe_wr(roots[i].what, cc, roots[i].rcgr + 4,
+			    (was & ~GPU_RCG_SOURCE_MASK) | roots[i].sel);
+			gpu_probe_wr(roots[i].what, cc, roots[i].rcgr,
+			    gpu_probe_rd(roots[i].what, cc, roots[i].rcgr) | GPU_RCG_UPDATE);
+		}
+		(void)gpu_probe_rd(roots[i].what, cc, roots[i].rcgr + 4);
+	}
+
+	/* No "hub" branches here: cb/hub_aon/hub_cx_int are a660 clocks. */
+	printf("SWEET GPU: stage 2c done\n");
+	if (level < 5) {
+		return;
+	}
+
+gmu_only:
+	/* ---- stage 3a: the GMU's memory and the firmware --------------------- */
+	printf("SWEET GPU: --- stage 3a: gmu memory and firmware\n");
+	(void)gpu_probe_rd("gmu sysreset", gmu, GPU_GMU_SYSRESET);
+	(void)gpu_probe_rd("gmu fw_init", gmu, GPU_GMU_FW_INIT);
+	/*
+	 * The processor must be held in reset while its memory is written, and a
+	 * previous boot of this kernel may have left it running (console55: SYSRESET
+	 * read 0 and the firmware went into a running core, so it never started).
+	 */
+	if (gpu_rd_quiet(gmu, GPU_GMU_SYSRESET) != 1) {
+		gpu_probe_wr("gmu sysreset hold", gmu, GPU_GMU_SYSRESET, 1);
+		uint32_t held = 0;
+		for (int i = 0; i < 100; i++) {
+			held = gpu_rd_quiet(gmu, GPU_GMU_SYSRESET);
+			if (held == 1) {
+				break;
+			}
+			gpu_wait_ms(1);
+		}
+		printf("SWEET GPU: gmu sysreset now %#x\n", held);
+		if (held != 1) {
+			/*
+			 * The ABL runs the GPU for its boot splash and can leave the GMU
+			 * running, where SYSRESET is a status and will not be set. A GDSC
+			 * collapse and release resets the whole GPU block, which the hardware
+			 * has to honour.
+			 */
+			printf("SWEET GPU: the core will not hold in reset; resetting the block through the CX GDSC\n");
+			uint32_t gdscr = gpu_probe_rd("gpucc cx gdscr", cc, GPUCC_CX_GDSCR);
+			gpu_probe_wr("gpucc cx gdscr collapse", cc, GPUCC_CX_GDSCR,
+			    (gdscr | GDSC_SW_COLLAPSE) & ~(GDSC_HW_CONTROL));
+			for (int i = 0; i < 100; i++) {
+				if (!(gpu_rd_quiet(cc, GPUCC_CX_GDSCR) & GDSC_POWER_ON)) {
+					break;
+				}
+				gpu_wait_ms(1);
+			}
+			printf("SWEET GPU: cx gdscr collapsed %#x\n", gpu_rd_quiet(cc, GPUCC_CX_GDSCR));
+			gpu_probe_wr("gpucc cx gdscr release", cc, GPUCC_CX_GDSCR,
+			    gpu_rd_quiet(cc, GPUCC_CX_GDSCR) & ~(GDSC_SW_COLLAPSE));
+			for (int i = 0; i < 100; i++) {
+				if (gpu_rd_quiet(cc, GPUCC_CX_GDSCR) & GDSC_POWER_ON) {
+					break;
+				}
+				gpu_wait_ms(1);
+			}
+			printf("SWEET GPU: cx gdscr back on %#x\n", gpu_rd_quiet(cc, GPUCC_CX_GDSCR));
+			gpu_probe_wr("gmu sysreset hold", gmu, GPU_GMU_SYSRESET, 1);
+			for (int i = 0; i < 100; i++) {
+				held = gpu_rd_quiet(gmu, GPU_GMU_SYSRESET);
+				if (held == 1) {
+					break;
+				}
+				gpu_wait_ms(1);
+			}
+			printf("SWEET GPU: gmu sysreset after the block reset %#x\n", held);
+			if (held != 1) {
+				printf("SWEET GPU: still not held; loading anyway (a load into a running core is harmless)\n");
+			}
+		}
+	}
+	char arg[64];
+	if (!PE_parse_boot_argn("sweetfw0", arg, sizeof(arg))) {
+		printf("SWEET GPU: no sweetfw0 boot argument: this boot image carries no GMU firmware\n");
+		return;
+	}
+	uint64_t fw_pa = 0, fw_size = 0;
+	if (!gpu_parse_range(arg, &fw_pa, &fw_size) || fw_size < GPU_GMU_FW_BYTES) {
+		printf("SWEET GPU: sweetfw0 \"%s\" is not a firmware blob of %#x bytes\n", arg, GPU_GMU_FW_BYTES);
+		return;
+	}
+	printf("SWEET GPU: firmware blob %#llx bytes at %#llx\n", fw_size, fw_pa);
+	vm_offset_t fw = ml_io_map((vm_offset_t)fw_pa, GPU_GMU_FW_BYTES);
+	if (fw == 0) {
+		printf("SWEET GPU: cannot map the firmware blob\n");
+		return;
+	}
+	uint32_t sum = 0, first[4];
+	for (uint32_t off = 0; off < GPU_GMU_FW_BYTES; off += 4) {
+		uint32_t w = *(volatile uint32_t *)(fw + off);
+		sum += w;
+		if (off < sizeof(first)) {
+			first[off / 4] = w;
+		}
+	}
+	printf("SWEET GPU: firmware sum %#x, first words %#x %#x %#x %#x\n", sum, first[0], first[1], first[2], first[3]);
+
+	/* The whole image goes through the GMU's code window: 16 KB of code and the
+	 * 16 KB of data that follows it (a6xx_gmu_fw_load's legacy path). */
+	for (uint32_t off = 0; off < GPU_GMU_FW_BYTES; off += 4) {
+		*(volatile uint32_t *)(gmu + GPU_GMU_ITCM + off) = *(volatile uint32_t *)(fw + off);
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+
+	/* Seven words across both halves: the window is not read more than it has
+	 * to be (a single read of it has frozen the SoC). */
+	static const uint32_t probe_at[] = { 0x0, 0x4000, 0x7ffc };
+	uint32_t wrong = 0, wrong_at = 0;
+	for (unsigned i = 0; i < sizeof(probe_at) / sizeof(probe_at[0]); i++) {
+		uint32_t off = probe_at[i];
+		if (*(volatile uint32_t *)(gmu + GPU_GMU_ITCM + off) != *(volatile uint32_t *)(fw + off)) {
+			if (wrong++ == 0) {
+				wrong_at = off;
+			}
+		}
+	}
+	printf("SWEET GPU: itcm[0] %#x dtcm[0] %#x (sampled %u of %u words differ%s%#x), versions %#x %#x %#x\n",
+	    *(volatile uint32_t *)(gmu + GPU_GMU_ITCM), *(volatile uint32_t *)(gmu + GPU_GMU_DTCM),
+	    wrong, (uint32_t)(sizeof(probe_at) / sizeof(probe_at[0])), wrong ? " (first at " : "",
+	    wrong ? wrong_at : 0,
+	    *(volatile uint32_t *)(gmu + GPU_GMU_VERSIONS),
+	    *(volatile uint32_t *)(gmu + GPU_GMU_VERSIONS + 8),
