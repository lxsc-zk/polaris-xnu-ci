+/*
+ * A bare IOAcceleratorES. backboardd waits for one before it draws anything;
+ * with a plain IOService published under that class it stops waiting and uses
+ * its software renderer, which is enough to get a picture on the panel.
+ */
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
