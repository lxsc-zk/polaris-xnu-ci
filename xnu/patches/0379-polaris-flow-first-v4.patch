Subject: [PATCH] polaris: the early hand-off, with its declarations up front

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -404,6 +404,13 @@
 	printf("adreno: %u: RPMh has \"%s\" at %#x; levels:%s\n", step, name, address, levels);
 }
 
+/* polaris (0377): declared here because the hand-off runs before the definitions below. */
+static const uint8_t *gmu_firmware;
+static uint64_t gmu_firmware_size;
+static bool mi8flow_took;
+static bool mi8flow_tried;
+static const uint8_t *image_file(const char *directory, const char *name, uint64_t *size);
+
 static bool
 step_outside(void)
 {
@@ -505,6 +512,43 @@
 static bool
 step_gpucc(void)
 {
+	/*
+	 * polaris (0376): hand the entire GPU bring-up to polaris_mi8_flow before this driver
+	 * touches a single GPU register -- the state the diag path runs from, and the only one
+	 * where this flow has been seen to answer all six HFI messages and reach G3D, CP, ZAP.
+	 */
+	if (!mi8flow_tried) {
+		extern int polaris_mi8_flow(vm_offset_t, vm_offset_t, vm_offset_t, vm_offset_t, int);
+		uint64_t sqe_size = 0, md_size = 0, b02_size = 0;
+		const uint8_t *sqe, *md, *b02;
+
+		mi8flow_tried = true;
+		if (gmu_firmware == NULL) {
+			gmu_firmware = image_file("fw", "a660_gmu.bin", &gmu_firmware_size);
+		}
+		sqe = image_file("fw", "a630_sqe.fw", &sqe_size);
+		md = image_file("fw", "a630_zap.mdt", &md_size);
+		b02 = image_file("fw", "a630_zap.b02", &b02_size);
+		if (sqe && md && b02 && gmu_firmware != NULL) {
+			printf("adreno: %u: polaris: handing the whole bring-up to polaris_mi8_flow "
+			    "(sqe %lu, mdt %lu, b02 %lu)\n", step, (unsigned long)sqe_size,
+			    (unsigned long)md_size, (unsigned long)b02_size);
+			if (polaris_mi8_flow((vm_offset_t)gmu_firmware, sqe, md, b02, 0) == 0) {
+				mi8flow_took = true;
+				printf("adreno: %u: polaris: polaris_mi8_flow took the GPU up; the GPU steps "
+				    "stand aside\n", step);
+			} else {
+				printf("adreno: %u: polaris: polaris_mi8_flow did not take; continuing step by step\n", step);
+			}
+		} else {
+			printf("adreno: %u: polaris: blobs missing (sqe %d mdt %d b02 %d fw %d)\n", step,
+			    sqe != 0, md != 0, b02 != 0, gmu_firmware != NULL);
+		}
+	}
+	if (mi8flow_took) {
+		return true;
+	}
+
 	announce("make sure the clock of the GPU clock controller's registers runs (gcc_gpu_cfg_ahb)");
 	if ((set(&gcc, "gpu_cfg_ahb", GCC_GPU_CFG_AHB_CBCR, CBCR_ENABLE) & CBCR_OFF) &&
 	    !wait_for(&gcc, GCC_GPU_CFG_AHB_CBCR, CBCR_OFF, 0, 10)) {
@@ -579,6 +623,9 @@
 static bool
 step_cx_power(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	uint32_t gdscr;
 
 	if (!gpucc_answers()) {
@@ -692,6 +739,9 @@
 static bool
 step_clocks(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	if (!gpucc_answers()) {
 		return false;
 	}
@@ -1097,6 +1147,9 @@
 static bool
 step_rscc(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	if (!cx_ready()) {
 		return false;
 	}
@@ -1188,6 +1241,9 @@
 static bool
 step_smmu_context(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	uint32_t context;
 
 	if (!cx_ready()) {
@@ -1216,6 +1272,9 @@
 static bool
 step_gmu_memory(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	static const uint32_t pattern[2] = { 0x600d0001, 0x0a110002 };
 	uint32_t was[2], back[2];
 
@@ -1880,6 +1939,9 @@
 static bool
 step_gmu_space(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	/*
 	 * polaris (0371): hand the whole bring-up to polaris_mi8_flow while the GMU is still in
 	 * reset -- that is the one implementation on this hardware that gets the GPU_SET grant
@@ -2071,6 +2133,9 @@
 step_gmu_firmware(void)
 {
 	if (mi8flow_took) {
+		return true;
+	}
+	if (mi8flow_took) {
 		printf("adreno: %u: polaris_mi8_flow already brought the GPU up; not repeating this step\n", step);
 		return true;
 	}
@@ -2212,6 +2277,9 @@
 step_gmu_start(void)
 {
 	if (mi8flow_took) {
+		return true;
+	}
+	if (mi8flow_took) {
 		printf("adreno: %u: polaris_mi8_flow already brought the GPU up; not repeating this step\n", step);
 		return true;
 	}
@@ -3415,6 +3483,9 @@
 step_gmu_queues(void)
 {
 	if (mi8flow_took) {
+		return true;
+	}
+	if (mi8flow_took) {
 		printf("adreno: %u: polaris_mi8_flow already brought the GPU up; not repeating this step\n", step);
 		return true;
 	}
@@ -3854,6 +3925,9 @@
 static bool
 step_core_power(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	static const struct {
 		uint32_t khz, level;
 	} speeds[] = { { 0, 0 }, { 315000, 64 }, { 450000, 128 }, { 550000, 192 } };
@@ -4181,6 +4255,9 @@
 static bool
 step_core_space(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	const uint8_t *microcode;
 	uint64_t size = 0;
 	uint32_t stream1 = 1;
@@ -4264,6 +4341,9 @@
 static bool
 step_zap_load(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	const uint8_t *segment;
 	volatile uint8_t *memory;
 	uint64_t size = 0, header = 0, answer = ~0ull;
@@ -4323,6 +4403,9 @@
 static bool
 step_core_start(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	static const uint32_t address_modes[] = { 0x0842, 0x0c01, 0x8601, 0x8e05, 0x9e01, 0xbe05, 0xa601, 0x9601, 0x0e00, 0xae01,
 		                                  0xb601, 0xf810 };
 	uint32_t blind = 0;
@@ -4439,6 +4522,9 @@
 static bool
 step_core_commands(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	volatile uint32_t *scratch = (volatile uint32_t *)core_scratch.memory;
 
 	if (!cx_ready() || !core_runs) {
@@ -4518,6 +4604,9 @@
 static bool
 step_frame(void)
 {
+	if (mi8flow_took) {
+		return true;
+	}
 	const volatile uint8_t *pixel;
 
 	if (!cx_ready() || !core_runs) {
