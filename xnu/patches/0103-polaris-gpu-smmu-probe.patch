@@ -515,6 +515,10 @@ bsd_init(void)
 		extern void polaris_gpu_gmu_probe(void);
 		polaris_gpu_gmu_probe();
 	}
+	{
+		extern void polaris_gpu_smmu_probe(void);
+		polaris_gpu_smmu_probe();
+	}
 
