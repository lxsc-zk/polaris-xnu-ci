--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -1097,5 +1097,20 @@
 	if (!sweet_gpu_ready() && selector != SWEET_GPU_SEL_INFO) {
 		return kIOReturnNotReady;
 	}
 
-	IOLog("SWEET ADRENO: selector %#x in %u bytes\n", selector, (unsigned)in);
+	/*
+	 * Per-ioctl logging is on the hot path: the compositor issues thousands of GEM_INFO and
+	 * BO_SYNC calls per frame, and formatting plus console output for each of them costs
+	 * more than the ioctl itself. Off by default; boot-arg sweetadreno_log=1 brings it back.
+	 */
+	{
+		static int selog = -1;
+
+		if (selog < 0) {
+			selog = 0;
+			PE_parse_boot_argn("sweetadreno_log", &selog, sizeof(selog));
+		}
+		if (selog != 0) {
+			IOLog("SWEET ADRENO: selector %#x in %u bytes\n", selector, (unsigned)in);
+		}
+	}
