+/* Enumerate cmd_db entries so the GPU rail resource can be identified. */
+void
+polaris_gpu_cmddb(void)
+{
+	int optin = 0;
+	vm_offset_t dict, db;
+	uint32_t pa, size, i, j, h, cnt, ent, addr;
+	char name[9];
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 27) {
+		return;
+	}
+	dict = ml_io_map(0x0c3f000cu, 8);
+	if (!dict) {
+		printf("POLARIS DB: dict map failed\n");
+		return;
+	}
+	pa = pwr_read(dict, 0);
+	size = pwr_read(dict, 4);
+	printf("POLARIS DB: locator pa=0x%08x size=0x%x\n", pa, size);
+	db = ml_io_map(pa, size);
+	if (!db) {
+		printf("POLARIS DB: db map failed\n");
+		return;
+	}
+	for (i = 0; i < 8; i++) {
+		h = 8u + 16u * i;
+		cnt = (pwr_read(db, h + 4u) >> 16) & 0xffffu;   /* cnt at +6 */
+		cnt = (pwr_read(db, h + 4u) >> 16) & 0xffffu;
+		{
+			uint32_t w = pwr_read(db, h + 4u);
+			cnt = (w >> 16) & 0xffffu;
+		}
+		if (cnt == 0 || cnt > 200) {
+			continue;
+		}
+		ent = 0x90u + ((pwr_read(db, h) >> 16) & 0xffffu);
+		printf("POLARIS DB: slave %u cnt=%u ent=0x%x\n", i, cnt, ent);
+		for (j = 0; j < cnt; j++) {
+			uint32_t e = ent + 24u * j;
+			uint32_t w0 = pwr_read(db, e);
+			uint32_t w1 = pwr_read(db, e + 4u);
+			addr = pwr_read(db, e + 16u);
+			name[0] = (char)(w0 & 0xff);
+			name[1] = (char)((w0 >> 8) & 0xff);
+			name[2] = (char)((w0 >> 16) & 0xff);
+			name[3] = (char)((w0 >> 24) & 0xff);
+			name[4] = (char)(w1 & 0xff);
+			name[5] = (char)((w1 >> 8) & 0xff);
+			name[6] = (char)((w1 >> 16) & 0xff);
+			name[7] = (char)((w1 >> 24) & 0xff);
+			name[8] = 0;
+			printf("POLARIS DB: [%u.%u] '%s' addr=0x%08x\n", i, j, name, addr);
+		}
+	}
+	printf("POLARIS DB: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
