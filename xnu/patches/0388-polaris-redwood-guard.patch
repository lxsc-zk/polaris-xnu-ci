Subject: [PATCH] polaris: restore redwood_input.h's include guard

--- a/bsd/sys/redwood_input.h
+++ b/bsd/sys/redwood_input.h
@@ -1,3 +1,11 @@
+#ifndef _SYS_REDWOOD_INPUT_H_
+#define _SYS_REDWOOD_INPUT_H_
+
+#include <sys/types.h>
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+
 void mi8_fts_init(void);                /* boot-arg fts=1 fts_steps=6: the Mi 8 touch screen (ST FTM5), steps 1-5 its probe */
 void mi8_adreno_init(void);             /* boot-arg mi8gpu=N: the first N steps of waking the Mi 8 GPU (Adreno 630) */
 void mi8_rproc_init(void);              /* boot-arg mi8rp_step=N: the first N steps of the Mi 8 remote processors (SMEM, modem, ...) */
@@ -7,7 +15,6 @@
 void redwood_gpu_report(const char *why);
 bool redwood_gpu_recover(void);
 void redwood_gpu_stop(void);
-
 /* The Mi 8's GPU kept on (boot-arg gpu=1; bsd/dev/mi8_adreno.c): redwood_adreno.c hands the calls above over to these when it is on. */
 bool mi8_gpu_kept(void);
 bool mi8_gpu_parameter(uint32_t which, uint64_t *value);
@@ -25,6 +32,7 @@
 void mi8_gpu_report(const char *why);
 bool mi8_gpu_recover(void);
 void mi8_gpu_stop(void);
-#endif
+
+__END_DECLS
 
 #endif /* _SYS_REDWOOD_INPUT_H_ */
