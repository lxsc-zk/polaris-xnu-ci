Subject: [PATCH] polaris: with mi8gpu set, this port's flow stands down

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -1967,7 +1967,20 @@
 			 * buffer at IOVA 0x20000000 and fills it through CP_MEM_WRITE; the recorded
 			 * painting image ran the same function with this flag set.
 			 */
-			int flow_rc = polaris_mi8_flow((vm_offset_t)gmu_firmware, sqe, md, b02, 1);
+			/*
+			 * polaris (0392): one driver at a time. With mi8gpu=N on the command line the
+			 * dipper driver owns the GPU; running this port's flow as well starts the GMU
+			 * under it and makes it roll back (CX off mid-flow).
+			 */
+			uint32_t requested = 0;
+			int flow_rc = -1;
+
+			if (!PE_parse_boot_argn("mi8gpu", &requested, sizeof(requested)) || requested == 0) {
+				flow_rc = polaris_mi8_flow((vm_offset_t)gmu_firmware, sqe, md, b02, 1);
+			} else {
+				printf("adreno: %u: polaris: mi8gpu=%u given; this port's flow stands down for "
+				    "dipper's driver\n", step, requested);
+			}
 
