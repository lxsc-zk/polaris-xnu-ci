--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -378,0 +379,13 @@
+		/*
+		 * sweet_gpu_vm_map() writes ONE 4 KiB PTE and PAGE_SIZE is 16 KiB, so a single call per
+		 * page leaves three quarters of every buffer unmapped - the CP jumped into such a hole
+		 * (the nested command buffer's address read back as PTE 0) and wedged. Fill the page.
+		 */
+		if (ok && (pa & (PAGE_SIZE - 1)) == 0) {
+			for (uint32_t k = 0x1000; k < PAGE_SIZE; k += 0x1000) {
+				if (!sweet_gpu_vm_map(iova + mapped + k, pa + k, ro)) {
+					ok = false;
+					break;
+				}
+			}
+		}
