+	/*
+	 * SMMU registers are banked secure/non-secure. arm-smmu computes the
+	 * non-secure alias of a global register as "base + 0x400", so try the
+	 * alias view for the global block and for context bank 0.
+	 */
+	printf("POLARIS GPU SMMU: sec sCR0=0x%08x ns sCR0=0x%08x\n",
+	    pwr_read(smmu, 0x000u), pwr_read(smmu, 0x400u));
+	printf("POLARIS GPU SMMU: sec ID0=0x%08x ns ID0=0x%08x\n",
+	    pwr_read(smmu, 0x020u), pwr_read(smmu, 0x420u));
+	pwr_write(smmu, 0x400u, 0x00200626u);
+	pwr_delay();
+	printf("POLARIS GPU SMMU: ns sCR0 reads 0x%08x\n", pwr_read(smmu, 0x400u));
+
+	printf("POLARIS GPU SMMU: CB0 secure TTBR0\n");
+	*(volatile uint64_t *)(smmu + 0x8020u) = 0x0000deadb000ull;
+	pwr_delay();
+	printf("POLARIS GPU SMMU: CB0 sec TTBR0=0x%llx\n",
