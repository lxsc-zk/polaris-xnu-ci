+/* dipper's step 21: the zap shader through TrustZone (SCM), then CP_SET_SECURE_MODE(0). */
+#define POLARIS_SCM_64       (1ull << 30)
+#define POLARIS_SCM_SIP      (2ull << 24)
+#define POLARIS_SCM_SUPPORTED 0x207ull
+#define POLARIS_ZAP_PAS      13u
+#define POLARIS_ZAP_PHYS     0x8c415000ull
+#define POLARIS_ZAP_SIZE     0x2000u
+
+static uint8_t polaris_zap_meta[0x4000] __attribute__((aligned(4096)));
+
+/* like polaris_scm_call() but with three arguments and all three results */
+static int64_t
+polaris_scm_ex(uint64_t function, uint64_t arginfo, uint64_t a0,
+    uint64_t a1, uint64_t a2, uint64_t res[3])
+{
+	uint64_t session = 0;
+	uint32_t i;
+
+	for (i = 0; i < 100u; i++) {
+		register uint64_t x0 __asm__("x0") = i ? 1 : function;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2),
+		    "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6), "+r" (x7) : :
+		    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		    "x16", "x17", "memory", "cc");
+		session = x6;
+		if (x0 != 1u) {
+			res[0] = x1;
+			res[1] = x2;
+			res[2] = x3;
+			return (int32_t)x0;
+		}
+	}
+	return -1000;
+}
+
+static int
+polaris_zap_load(vm_offset_t mdt, uint32_t mdt_size, vm_offset_t seg, uint32_t seg_size)
+{
+	const uint64_t how = POLARIS_SCM_64 | POLARIS_SCM_SIP;
+	uint64_t res[3], meta_phys, off;
+	vm_offset_t region;
+	int64_t rc;
+	uint32_t i;
+
+	for (i = 0; i < 3u; i++) {
+		res[i] = 0;
+	}
+	printf("POLARIS ZAP: mdt %u bytes, segment %u bytes\n", mdt_size, seg_size);
+	if (mdt == 0 || seg == 0 || seg_size == 0u) {
+		printf("POLARIS ZAP: the zap blobs are missing\n");
+		return -1;
+	}
+	rc = polaris_scm_ex(how | POLARIS_SCM_SUPPORTED, 1, POLARIS_ZAP_PAS, 0, 0, res);
+	printf("POLARIS ZAP: PAS_SUPPORTED(13): rc=%lld result=0x%llx\n", (long long)rc,
+	    (unsigned long long)res[0]);
+
+	meta_phys = (uint64_t)ml_static_vtop((vm_offset_t)polaris_zap_meta);
+	for (i = 0; i < mdt_size; i++) {
+		polaris_zap_meta[i] = *(volatile uint8_t *)(mdt + i);
+	}
+	polaris_pt_clean((vm_offset_t)polaris_zap_meta, 0x4000u);
+	printf("POLARIS ZAP: metadata at 0x%llx page2=0x%llx %s\n",
+	    (unsigned long long)meta_phys,
+	    (unsigned long long)ml_static_vtop((vm_offset_t)(polaris_zap_meta + 4096)),
+	    (ml_static_vtop((vm_offset_t)(polaris_zap_meta + 4096)) ==
+	    meta_phys + 4096u) ? "contiguous" : "NOT CONTIGUOUS");
+
+	rc = polaris_scm_ex(how | 0x201u, 0x82u, POLARIS_ZAP_PAS, meta_phys, 0, res);
+	printf("POLARIS ZAP: PAS_INIT_IMAGE: rc=%lld result=0x%llx\n", (long long)rc,
+	    (unsigned long long)res[0]);
+	if (rc != 0 || res[0] != 0u) {
+		return -2;
+	}
+	rc = polaris_scm_ex(how | 0x202u, 3u, POLARIS_ZAP_PAS, POLARIS_ZAP_PHYS,
+	    0x1000u, res);
+	printf("POLARIS ZAP: PAS_MEM_SETUP: rc=%lld result=0x%llx\n", (long long)rc,
+	    (unsigned long long)res[0]);
+	if (rc != 0 || res[0] != 0u) {
+		(void)polaris_scm_ex(how | 0x206u, 1, POLARIS_ZAP_PAS, 0, 0, res);
+		return -3;
+	}
+	region = ml_io_map(POLARIS_ZAP_PHYS, POLARIS_ZAP_SIZE);
+	if (region == 0) {
+		printf("POLARIS ZAP: cannot map the zap region\n");
+		return -4;
+	}
+	for (off = 0; off < seg_size; off++) {
+		*(volatile uint8_t *)(region + off) = *(volatile uint8_t *)(seg + off);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("POLARIS ZAP: segment written to 0x%llx\n", (unsigned long long)POLARIS_ZAP_PHYS);
+	rc = polaris_scm_ex(how | 0x205u, 1, POLARIS_ZAP_PAS, 0, 0, res);
+	printf("POLARIS ZAP: PAS_AUTH_AND_RESET: rc=%lld result=0x%llx -- %s\n",
+	    (long long)rc, (unsigned long long)res[0],
+	    (rc == 0 && res[0] == 0u) ? "AUTHENTICATED" : "refused");
+	if (rc != 0 || res[0] != 0u) {
+		(void)polaris_scm_ex(how | 0x206u, 1, POLARIS_ZAP_PAS, 0, 0, res);
+		return -5;
+	}
+	return 0;
+}
+
+static void
+polaris_g3d_zap(vm_offset_t g3, vm_offset_t mdt, uint32_t mdt_size,
+    vm_offset_t seg, uint32_t seg_size)
+{
+	static uint32_t wptr = 9u;
+	uint32_t *ring = (uint32_t *)(polaris_g3d_mem + 0x8000u);
+	uint32_t rptr = 0xffffffffu, i;
+
+	if (*(volatile uint32_t *)(g3 + 4u * 0xf400u) == 0u) {
+		printf("POLARIS ZAP: the core is already out of secure mode\n");
+		return;
+	}
+	if (polaris_zap_load(mdt, mdt_size, seg, seg_size) != 0) {
+		printf("POLARIS ZAP: not authenticated, secure mode left as it is\n");
+		return;
+	}
+	ring[wptr++] = polaris_pkt7(0x66u, 1u);
+	ring[wptr++] = 0u;
+	polaris_pt_clean((vm_offset_t)polaris_g3d_mem, 0x12000u);
+	*(volatile uint32_t *)(g3 + 4u * 0x0807u) = wptr;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (i = 0; i < 200000u; i++) {
+		rptr = *(volatile uint32_t *)(g3 + 4u * 0x0806u);
+		if (rptr == wptr) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	printf("POLARIS ZAP: CP_SET_SECURE_MODE(0) RPTR=%u WPTR=%u %s; SECVID=0x%08x\n",
+	    rptr, wptr, (rptr == wptr) ? "CONSUMED" : "NOT consumed",
+	    *(volatile uint32_t *)(g3 + 4u * 0xf400u));
+	printf("POLARIS ZAP: %s\n",
+	    (*(volatile uint32_t *)(g3 + 4u * 0xf400u) == 0u) ?
+	    "THE CORE IS OUT OF SECURE MODE" : "still secure");
+}
