Subject: [PATCH] polaris: adreno_mi8=1 runs steps 15-16 exactly as the working image

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -1813,6 +1813,7 @@
 static bool skip_rsc_table;
 static bool skip_hfi_start;
 static bool hfi_bypass;         /* adreno_hfi_bypass=1: the firmware sees physical addresses */
+static bool mi8_flow;           /* adreno_mi8=1: steps 15-16 exactly as mi8flow.inc runs them */
 static uint32_t hfi_phys, log_phys;
 static uint32_t gmu_bypass_slot[2] = { 0, 1 };
 static void gmu_post_mortem(void);
@@ -2187,7 +2188,7 @@
 	 * a6xx_rscc_wakeup_sequence, before the firmware starts.
 	 */
 	rscc_show();
-	if (rd(rscc.base + RSCC_RSC_STATUS0_DRV0) & RSCC_ASLEEP) {
+	if (!mi8_flow && (rd(rscc.base + RSCC_RSC_STATUS0_DRV0) & RSCC_ASLEEP)) {
 		put(&gmu, "rscc_control_req", GMU_RSCC_CONTROL_REQ, 2);
 		if (!wait_for(&gmu, GMU_RSCC_CONTROL_ACK, 2, 2, 100) || !wait_for(&rscc, RSCC_SEQ_BUSY_DRV0, ~0u, 0, 100)) {
 			printf("adreno: %u: the GMU's RPMh channel does not wake\n", step);
@@ -2198,8 +2199,10 @@
 		get(&rscc, "seq_busy_drv0", RSCC_SEQ_BUSY_DRV0);
 	}
 	rsc_awake = true;
-	put(&gmu, "cx_falnext_intf", GMU_CX_FALNEXT_INTF, 1);
-	put(&gmu, "cx_fal_intf", GMU_CX_FAL_INTF, 1);
+	if (!mi8_flow) {
+		put(&gmu, "cx_falnext_intf", GMU_CX_FALNEXT_INTF, 1);
+		put(&gmu, "cx_fal_intf", GMU_CX_FAL_INTF, 1);
+	}
 	put(&gmu, "general_7", GMU_GENERAL_7, 1);
 	/*
 	 * polaris: the sequencer's side first -- see gmu_pdc_rsc_setup(). The bring-up that
@@ -2214,7 +2217,9 @@
 	 * polaris: and the rail's own vote, through the path this board was tested with --
 	 * the RSCC table above cannot serve the firmware's RPMh requests on its own.
 	 */
-	gmu_rail_vote();
+	if (!mi8_flow) {
+		gmu_rail_vote();        /* the working image votes through the rail indices only */
+	}
 	put(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT, 0);
 	put(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG, 2);
 	put(&gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, hfi_bypass ? hfi_phys : GMU_HFI_ADDRESS);
@@ -2237,7 +2242,9 @@
 	put(&gmu, "dcache_config", GMU_DCACHE_CONFIG, 1);
 	put(&gmu, "pwr_col_inter_frame_ctrl", GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
 	set(&gmu, "rpmh_ctrl", GMU_RPMH_CTRL, GMU_RPMH_CTRL_ALL);
-	put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	if (!mi8_flow) {
+		put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	}
 
 	gmu_runs = true;
 	/*
@@ -2848,10 +2855,12 @@
 	    rd(gmu.base + GMU_AHB_FENCE_RANGE_0), rd(gmu.base + GMU_AHB_FENCE_RANGE_0 + 4),
 	    rd(gmu.base + GMU_AHB_FENCE_STATUS), rd(gmu.base + GMU_AO_AHB_FENCE_CTRL),
 	    rd(gmu.base + 0x24c4cu), rd(gpucc.base + GPUCC_CX_GMU_CBCR));
-	wr(gmu.base + GMU_GMU2HOST_INTR_INFO, 0xffffffffu);
-	wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
-	wr(gmu.base + GMU_GMU2HOST_INTR_MASK, 0xff7ffffeu);
-	wr(gmu.base + GMU_AO_HOST_INTR_MASK, 0xffffffd6u);
+	if (!mi8_flow) {
+		wr(gmu.base + GMU_GMU2HOST_INTR_INFO, 0xffffffffu);
+		wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
+		wr(gmu.base + GMU_GMU2HOST_INTR_MASK, 0xff7ffffeu);
+		wr(gmu.base + GMU_AO_HOST_INTR_MASK, 0xffffffd6u);
+	}
 	__asm__ __volatile__("dsb sy" ::: "memory");
 	printf("adreno: %u: polaris: latches cleared, masks set: gmu_mask=%#x ao_mask=%#x queued=%#x\n",
 	    step, rd(gmu.base + GMU_GMU2HOST_INTR_MASK), rd(gmu.base + GMU_AO_HOST_INTR_MASK),
@@ -4631,6 +4640,13 @@
 		if (PE_parse_boot_argn("adreno_hfi_bypass", &skip, sizeof(skip))) {
 			hfi_bypass = skip != 0;
 		}
+		skip = 0;
+		if (PE_parse_boot_argn("adreno_mi8", &skip, sizeof(skip))) {
+			mi8_flow = skip != 0;
+		}
+		if (mi8_flow) {
+			printf("adreno: adreno_mi8=1: steps 15-16 follow mi8flow.inc only\n");
+		}
 	}
 	if (!PE_parse_boot_argn("adreno", &last_step, sizeof(last_step))) {
 		if (!(PE_parse_boot_argn("gpu", &only, sizeof(only)) && only) || !start_by_itself()) {
