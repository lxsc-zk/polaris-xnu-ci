Subject: [PATCH] polaris: hfi_send, protocol for protocol as dipper's

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -3643,83 +3643,87 @@
 	get(&gmu, "ahb_fence_status", GMU_AHB_FENCE_STATUS);
 }
 
+/* Send a message whose first word is yet to be made and wait for the GMU's verdict on it. */
 static bool
 hfi_send(const char *what, uint32_t id, uint32_t *message, uint32_t words)
 {
-	volatile struct hfi_queue *queue = &hfi->queue[0];
-	volatile uint32_t *data = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(0));
-	volatile struct hfi_queue *answers = &hfi->queue[1];
-	volatile uint32_t *adata = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(1));
+	volatile struct hfi_queue *cq = &hfi->queue[0];
+	volatile struct hfi_queue *rq = &hfi->queue[1];
+	volatile uint32_t *cdata = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(0));
+	volatile uint32_t *rdata = (volatile uint32_t *)((vm_offset_t)hfi + HFI_QUEUE_AT(1));
 	uint32_t number = ++hfi_number & 0xfff;
-	uint32_t idx, k, info = 0, ri, n, verdict = 0xffffffffu;
+	uint32_t index, space, k;
 
 	/*
-	 * polaris (0356): the working image's sender, moved over whole. It is
-	 * polaris_hfi_xfer() in bsd/dev/polaris_gpu_diag.c, which in this same kernel gets
-	 * err=0x00000000 for id=0..5: tight poll, one clear of bit 0, then read queue 1 at its
-	 * read index without looking at the interrupt again.
+	 * polaris (0365): protocol for protocol as dipper's hfi_send -- see the header of the
+	 * patch. Step 1: take the GMU's view of the header before believing its write index.
 	 */
-	message[0] = (number << 20) | ((words & 0xffu) << 8) | (id & 0xffu);
-	idx = queue->write & (HFI_QUEUE_WORDS - 1u);
-	for (k = 0; k < (words + 3u) / 4u * 4u; k++) {
-		data[idx] = k < words ? message[k] : 0xfafafafau;
-		idx = (idx + 1u) & (HFI_QUEUE_WORDS - 1u);
+	to_memory((vm_offset_t)hfi, 0x1000);
+	index = cq->write & (HFI_QUEUE_WORDS - 1u);
+	space = (cq->read - index - 1u) & (HFI_QUEUE_WORDS - 1u);
+	if (space < words) {
+		printf("adreno: %u: HFI: %s (id %u): the command queue is full (write %u read %u space %u)\n",
+		    step, what, id, index, cq->read, space);
+		return false;
 	}
-	if (hfi_number <= 2) {
-		volatile uint32_t *e = (volatile uint32_t *)hfi + 6;
 
-		printf("adreno: %u: q0 before store (number %u, idx %u):", step, number, idx);
-		for (int i = 0; i < 12; i++) {
-			printf(" %#x", e[i]);
-		}
-		printf("\n");
-	}
-	queue->write = idx;
-	to_memory((vm_offset_t)hfi, 0x4000u);
-	/*
-	 * polaris (0361): the firmware consumes one message per doorbell edge -- it clears the
-	 * write index when it takes one, and with bit 0 left set the next message looks like no
-	 * news at all. Drop the bit and raise it again for this message.
-	 */
-	wr(gmu.base + GMU_HOST2GMU_INTR_SET, 0);
-	__asm__ __volatile__("dsb sy" ::: "memory");
-	if (hfi_number <= 2) {
-		volatile uint32_t *e = (volatile uint32_t *)hfi + 6;
+	message[0] = (number << 20) | (0u << 16) | ((words & 0xffu) << 8) | (id & 0xffu);
+	for (k = 0; k < words; k++) {
+		cdata[index] = message[k];
+		index = (index + 1u) & (HFI_QUEUE_WORDS - 1u);
+	}
+	to_memory((vm_offset_t)cdata, 0x1000);
+	cq->write = index;
+	to_memory((vm_offset_t)hfi, 0x1000);
 
-		printf("adreno: %u: q0 after store:", step);
-		for (int i = 0; i < 12; i++) {
-			printf(" %#x", e[i]);
-		}
-		printf("\n");
-		printf("adreno: %u: candidates +38=%#x +3c=%#x +40=%#x +44=%#x +48=%#x (wanted %#x at +44)\n", step,
-		    e[8], e[9], e[10], e[11], *(volatile uint32_t *)((vm_offset_t)hfi + 0x48u), idx);
-	}
 	wr(gmu.base + GMU_HOST2GMU_INTR_SET, 1);
 	__asm__ __volatile__("dsb sy" ::: "memory");
-	for (k = 0; k < 2000000u; k++) {
-		info = rd(gmu.base + GMU_GMU2HOST_INTR_INFO);
-		if (info & 1u) {
-			break;
-		}
-	}
-	if (!(info & 1u)) {
-		printf("adreno: %u: HFI: %s (id %u, %u words, number %u) NO ANSWER info=%#x\n", step, what, id,
-		    words, number, info);
-		return false;
-	}
-	wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 1);
-	__asm__ __volatile__("dsb sy" ::: "memory");
-	to_memory((vm_offset_t)hfi, 0x4000u);
 
-	ri = answers->read & (HFI_QUEUE_WORDS - 1u);
-	n = (adata[ri] >> 8) & 0xffu;
-	if (n >= 3u) {
-		verdict = adata[(ri + 2u) & (HFI_QUEUE_WORDS - 1u)];
+	for (unsigned round = 0; round < 3u; round++) {
+		if (!wait_for(&gmu, GMU_GMU2HOST_INTR_INFO, 1, 1, 1000)) {
+			printf("adreno: %u: HFI: %s (id %u, number %u): no response within 1 s "
+			    "(intr %#x, queue write %u read %u)\n", step, what, id, number,
+			    rd(gmu.base + GMU_GMU2HOST_INTR_INFO), cq->write, cq->read);
+			return false;
+		}
+		wr(gmu.base + GMU_GMU2HOST_INTR_CLR, 1);
+		for (;;) {
+			uint32_t resp[19], hdr, n, ri;
+
+			to_memory((vm_offset_t)hfi, 0x1000);
+			to_memory((vm_offset_t)rdata, 0x1000);
+			if (rq->read == rq->write) {
+				break;
+			}
+			ri = rq->read & (HFI_QUEUE_WORDS - 1u);
+			hdr = rdata[ri];
+			n = (hdr >> 8) & 0xffu;
+			if (n == 0u || n > 19u) {
+				printf("adreno: %u: HFI: response header %#x has size %u\n", step, hdr, n);
+				return false;
+			}
+			for (uint32_t i = 0; i < n; i++) {
+				resp[i] = rdata[ri];
+				ri = (ri + 1u) & (HFI_QUEUE_WORDS - 1u);
+			}
+			rq->read = ri;
+			to_memory((vm_offset_t)hfi, 0x1000);
+			if ((hdr & 0xffu) == HFI_ERROR) {
+				printf("adreno: %u: HFI: the firmware reports an error, code %u\n", step, resp[1]);
+				continue;
+			}
+			if (n < 3u || ((resp[1] >> 20) & 0xfffu) != number) {
+				printf("adreno: %u: HFI: unexpected response (header %#x ret %#x), waiting on\n",
+				    step, hdr, n > 1u ? resp[1] : 0u);
+				continue;
+			}
+			printf("adreno: %u: HFI: %s (id %u, number %u) err=%#x payload=%#x\n", step, what, id,
+			    number, resp[2], n > 3u ? resp[3] : 0u);
+			return resp[2] == 0u;
+		}
 	}
-	answers->read = (ri + (n ? n : 1u)) & (HFI_QUEUE_WORDS - 1u);
-	printf("adreno: %u: HFI: %s (id %u, %u words, number %u) err=%#x payload=%#x\n", step, what, id, words,
-	    number, verdict, n >= 4u ? adata[(ri + 3u) & (HFI_QUEUE_WORDS - 1u)] : 0u);
-	return verdict == 0;            /* the answer's error word: 0 means accepted */
+	printf("adreno: %u: HFI: %s (id %u): the response queue stayed empty\n", step, what, id);
+	return false;
 }
 
 /*
