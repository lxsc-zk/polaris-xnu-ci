diff --git a/bsd/dev/polaris_gpu_power.c b/bsd/dev/polaris_gpu_power.c
index 10f9057..e45279d 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -1453,6 +1453,105 @@ polaris_gpu_gmu_gx(void)
 	}
 }
 
+/*
+ * Drive the GPU RSC so it asks RPMh for the GFX rail: the same sequence the
+ * vendor driver runs in a6xx_rpmh_power_on_gpu(). The RSC registers are
+ * byte-wide but the interconnect only accepts aligned 32-bit accesses, so
+ * each byte field is read-modify-written through its containing word.
+ */
+void
+polaris_gpu_gmu_rsc(void)
+{
+	int optin = 0;
+	vm_offset_t base, gcc, gmu;
+	uint32_t v, w, ack, busy, i, gx;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 21) {
+		return;
+	}
+	base = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!base || !gcc || !gmu) {
+		printf("POLARIS RSC: map failed\n");
+		return;
+	}
+	/* CX up, GPU clocks on */
+	v = pwr_read(base, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	pwr_write(base, 0x1120u, 0x00000003u);
+	pwr_delay();
+	pwr_write(base, 0x1124u, 0x00000601u);
+	pwr_delay();
+	v = pwr_read(base, 0x1098u);
+	v |= (0xfu << 8) | (0xfu << 4);
+	v &= ~(1u << 31);
+	v |= 1u;
+	pwr_write(base, 0x1098u, v);
+	pwr_delay();
+	gx = pwr_read(base, GDSC_GX);
+	printf("POLARIS RSC: CX=0x%08x GX=0x%08x\n",
+	    pwr_read(base, GDSC_CX), gx);
+	/* RSC control word: 0x23b04..0x23b07 (REQ is byte 3) */
+	w = pwr_read(gmu, 0x23b04u);
+	printf("POLARIS RSC: word23b04=0x%08x\n", w);
+	w |= (0x02u << 24);
+	pwr_write(gmu, 0x23b04u, w);
+	pwr_delay();
+	ack = 0;
+	for (i = 0; i < 2000; i++) {
+		ack = pwr_read(gmu, 0x23b08u);
+		if (ack & 0x2u) {
+			break;
+		}
+	}
+	printf("POLARIS RSC: word23b08=0x%08x ack_ok=%u polls=%u\n",
+	    ack, (ack & 0x2u) ? 1u : 0u, i);
+	busy = 0xffffffffu;
+	for (i = 0; i < 2000; i++) {
+		busy = (pwr_read(gmu, 0x23500u) >> 8) & 0xffu;
+		if (busy == 0u) {
+			break;
+		}
+	}
+	printf("POLARIS RSC: seq_busy=0x%02x polls=%u\n", busy, i);
+	w &= ~(0x02u << 24);
+	pwr_write(gmu, 0x23b04u, w);
+	pwr_delay();
+	printf("POLARIS RSC: GX after=0x%08x %s\n", pwr_read(base, GDSC_GX),
+	    (pwr_read(base, GDSC_GX) & (1u << 31)) ? "ON" : "OFF");
+	/* is the GMU window writable now? */
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	v = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS RSC: general7=0x%08x %s\n", v,
+	    (v == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	printf("POLARIS RSC: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
