+
+		(void)PE_parse_boot_argn("polarisvar", &var, sizeof(var));
+		tva = (var & 8u) ? 0x60009000u : 0x60000000u;
+		polaris_qtbl_va = tva;
+		tt = b + (tva - 0x60000000u);
+		for (k = 0; k < 13u * 4096u; k++) {
+			b[k] = 0u;
+		}
+		*(volatile uint32_t *)(tt + 0x00u) = 0u;
+		*(volatile uint32_t *)(tt + 0x04u) = (var & 1u) ? 168u : 42u;
+		*(volatile uint32_t *)(tt + 0x08u) = 6u;
+		*(volatile uint32_t *)(tt + 0x0cu) = 12u;
+		*(volatile uint32_t *)(tt + 0x10u) = 3u;
+		*(volatile uint32_t *)(tt + 0x14u) = 3u;
+		for (i = 0; i < 3u; i++) {
+			uint32_t h = 0x18u + i * 48u;
+			uint32_t id = (i == 0u) ? 0u : ((i == 1u) ? 4u : 5u);
+			uint32_t prio = ((i == 2u) && !(var & 4u)) ? 40u : 10u;
+			uint32_t qa = (var & 2u) ? (tva + 0x1000u * (i + 1u))
+						 : (tva + 168u + i * 4112u);
+
+			*(volatile uint32_t *)(tt + h + 0x00u) = 1u;
+			*(volatile uint32_t *)(tt + h + 0x04u) = qa;
+			*(volatile uint32_t *)(tt + h + 0x08u) = (prio << 8) | id;
+			*(volatile uint32_t *)(tt + h + 0x0cu) = 1024u;
+			*(volatile uint32_t *)(tt + h + 0x18u) = 1u;
+			*(volatile uint32_t *)(tt + h + 0x1cu) = 1u;
+			*(volatile uint32_t *)(tt + h + 0x20u) = 1u;
+		}
+		for (k = 0; k < 13u; k++) {
+			polaris_pt_map(0x60000000ull + (uint64_t)k * 0x1000ull,
+			    kvtophys((vm_offset_t)(b + k * 4096u)));
+		}
+		polaris_pt_clean((vm_offset_t)b, 13u * 4096u);
+		printf("POLARIS BISECT: var=%u table=0x%08x size=%u q0=0x%08x q1=0x%08x q2=0x%08x\\n",
+		    var, tva, *(volatile uint32_t *)(tt + 0x04u),
+		    *(volatile uint32_t *)(tt + 0x1cu),
+		    *(volatile uint32_t *)(tt + 0x4cu),
+		    *(volatile uint32_t *)(tt + 0x7cu));
+		if (s9) {
