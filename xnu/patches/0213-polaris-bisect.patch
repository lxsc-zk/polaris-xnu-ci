+	/* ---- optin 64: the same six A630 differences, each switchable at boot
+	 * with polarisvar bit 0..5, so one kernel can bisect them:
+	 *   bit0 (1)  table size 168 instead of 42
+	 *   bit1 (2)  queues page aligned instead of packed after the header
+	 *   bit2 (4)  queue 2 priority 10 instead of 40
+	 *   bit3 (8)  table at 0x60009000 and log at 0x60005000
+	 *   bit4 (16) HFI_SFR_ADDR 0x06030100 instead of 0x06030000
+	 *   bit5 (32) AHB_FENCE_RANGE_0 0x802800A0 instead of 0x80A008A0
