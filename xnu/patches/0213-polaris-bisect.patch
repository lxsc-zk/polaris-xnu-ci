+			*(volatile uint32_t *)(s9 + POLARIS_SMR(2)) = 0x80000004u;
+			__asm__ __volatile__("dsb sy" ::: "memory");
+		}
+		*(volatile uint32_t *)(gpu + 0x14608u) = (var & 16u) ? 0x06030100u : 0x06030000u;
+		*(volatile uint32_t *)(gpu + 0x24c44u) = (var & 32u) ? 0x802800a0u : 0x80a008a0u;
+		*(volatile uint32_t *)(gpu + 0x14400u) = (var & 8u) ? 0x60005003u : 0x60004003u;
+		*(volatile uint32_t *)(gpu + 0x14404u) = 0u;
+		*(volatile uint32_t *)(gpu + 0x13000u) = 1u;
