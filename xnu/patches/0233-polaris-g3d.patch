diff --git a/bsd/dev/polaris_gpu_diag.c b/bsd/dev/polaris_gpu_diag.c
index 38c9c12..7393532 100644
--- a/bsd/dev/polaris_gpu_diag.c
+++ b/bsd/dev/polaris_gpu_diag.c
@@ -1024,7 +1024,8 @@ polaris_mi8_flow(vm_offset_t fw)
 	}
 	polaris_pt_clean((vm_offset_t)hm, 13u * 4096u);
 	polaris_tcr_ps = 1u;
-	(void)polaris_smmu_space_on(s, 1u, 1u, 5u);
+	(void)polaris_smmu_space_on(s, 2u, 0u, 5u);
+	(void)polaris_g3d_on(s);
 	*(volatile uint32_t *)(s + POLARIS_S2CR(2)) = 1u;
 	*(volatile uint32_t *)(s + POLARIS_SMR(2)) = 0x80000004u;
 	__asm__ __volatile__("dsb sy" ::: "memory");
@@ -1219,12 +1220,122 @@ polaris_mi8_flow(vm_offset_t fw)
 	(void)polaris_oob(g, 16u, 24u);
 	*(volatile uint32_t *)(g + 0x14644u) = (1u << 24) | (1u << 30);
 	__asm__ __volatile__("dsb sy" ::: "memory");
+	{
+		static const struct { const char *n; uint32_t w; } rd3[] = {
+			{ "RBBM_STATUS", 0x0210 }, { "RBBM_STATUS3", 0x0213 },
+			{ "RBBM_INT_0_STATUS", 0x0201 }, { "SECVID_TRUST_CNTL", 0xf400 },
+			{ "RBBM_CLOCK_CNTL", 0x00ae }, { "CP_SQE_CNTL", 0x0808 },
+			{ "CP_RB_RPTR", 0x0806 }, { "CP_RB_WPTR", 0x0807 },
+		};
+		vm_offset_t g3 = ml_io_map(0x05000000ull, 0x40000ull);
+		uint32_t d;
+
+		if (g3) {
+			printf("POLARIS G3D: the 3D block is mapped, core registers:\\n");
+			for (d = 0; d < sizeof(rd3) / sizeof(rd3[0]); d++) {
+				printf("POLARIS G3D: %-20s = 0x%08x\\n", rd3[d].n,
+				    *(volatile uint32_t *)(g3 + 4u * rd3[d].w));
+			}
+		} else {
+			printf("POLARIS G3D: 3D block map failed\\n");
+		}
+	}
 	printf("POLARIS M8: after GPU_SET GX=0x%08x powerstate=0x%08x info=0x%08x\n",
 	    *(volatile uint32_t *)(cc + 0x100cu), *(volatile uint32_t *)(g + 0x143b0u),
