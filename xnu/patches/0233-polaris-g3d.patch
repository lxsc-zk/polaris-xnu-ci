+/* ---- the 3D core's own address space (dipper: stream 0 -> context bank 1) ---- */
+#define POLARIS_G3D_CTX     1u
+#define POLARIS_G3D_SMR     1u
+#define POLARIS_G3D_STREAM  0u
+#define POLARIS_PTE_UNPRIV  (1ull << 6)	/* AP[1]: the core's accesses are unprivileged */
+
+static uint8_t polaris_g3d_mem[0x12000] __attribute__((aligned(4096)));
+static uint64_t polaris_g3d_l1[512] __attribute__((aligned(4096)));
+static uint64_t polaris_g3d_l2[512] __attribute__((aligned(4096)));
+static uint64_t polaris_g3d_l3[512] __attribute__((aligned(4096)));
+
+static int
+polaris_g3d_on(vm_offset_t s)
+{
+	uint32_t idr1, page, pages, cb, k;
+	uint64_t root;
+
+	idr1 = *(volatile uint32_t *)(s + POLARIS_IDR1);
+	page = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	pages = 2u << ((idr1 >> 28) & 7u);
+	cb = (pages + POLARIS_G3D_CTX) * page;
+
+	for (k = 0; k < 0x12000u; k++) {
+		polaris_g3d_mem[k] = 0u;
+	}
+	for (k = 0; k < 512u; k++) {
+		polaris_g3d_l1[k] = 0u;
+		polaris_g3d_l2[k] = 0u;
+		polaris_g3d_l3[k] = 0u;
+	}
+	polaris_g3d_l1[(0x10000000ull >> 30) & 0x1ffu] =
+	    kvtophys((vm_offset_t)polaris_g3d_l2) | POLARIS_PTE_TABLE;
+	polaris_g3d_l2[(0x10000000ull >> 21) & 0x1ffu] =
+	    kvtophys((vm_offset_t)polaris_g3d_l3) | POLARIS_PTE_TABLE;
+	for (k = 0; k < 0x11u; k++) {
+		polaris_g3d_l3[((0x10000000ull + (uint64_t)k * 0x1000ull) >> 12) & 0x1ffu] =
+		    (kvtophys((vm_offset_t)(polaris_g3d_mem + k * 0x1000u)) &
+		    POLARIS_PTE_ADDR) | POLARIS_PTE_GMU | POLARIS_PTE_UNPRIV |
+		    POLARIS_PTE_PAGE;
+	}
+	polaris_pt_clean((vm_offset_t)polaris_g3d_mem, 0x12000u);
+	polaris_pt_clean((vm_offset_t)polaris_g3d_l1, 4096u);
+	polaris_pt_clean((vm_offset_t)polaris_g3d_l2, 4096u);
+	polaris_pt_clean((vm_offset_t)polaris_g3d_l3, 4096u);
+	root = kvtophys((vm_offset_t)polaris_g3d_l1) | ((uint64_t)POLARIS_G3D_CTX << 48);
+
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR) = 0u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(s + POLARIS_CBA2R(POLARIS_G3D_CTX)) = 1u;
+	*(volatile uint32_t *)(s + POLARIS_CBAR(POLARIS_G3D_CTX)) = POLARIS_CBAR_STAGE_1;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TCR2) = POLARIS_TCR2;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TCR) =
+	    POLARIS_TCR_39 | (polaris_tcr_ps << 16);
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0) = (uint32_t)root;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0 + 4u) = (uint32_t)(root >> 32);
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR1) = 0u;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR1 + 4u) = 0u;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_MAIR0) = POLARIS_MAIR0;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_MAIR1) = 0u;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_FSR) = POLARIS_FSR_ALL;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TLBIASID) = POLARIS_G3D_CTX;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TLBSYNC) = 1u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	for (k = 0; k < 100000u; k++) {
+		if (!(*(volatile uint32_t *)(s + cb + POLARIS_CB_TLBSTATUS) & 1u)) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR) = POLARIS_SCTLR_ON;
+	*(volatile uint32_t *)(s + POLARIS_S2CR(POLARIS_G3D_SMR)) = POLARIS_G3D_CTX;
+	*(volatile uint32_t *)(s + POLARIS_SMR(POLARIS_G3D_SMR)) =
+	    0x80000000u | POLARIS_G3D_STREAM;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS G3D: cb%u sctlr=0x%08x ttbr0=0x%08x smr%d=0x%08x s2cr%d=0x%08x\n",
+	    POLARIS_G3D_CTX, *(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR),
+	    *(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0), POLARIS_G3D_SMR,
+	    *(volatile uint32_t *)(s + POLARIS_SMR(POLARIS_G3D_SMR)), POLARIS_G3D_SMR,
+	    *(volatile uint32_t *)(s + POLARIS_S2CR(POLARIS_G3D_SMR)));
+	if (!(*(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR) & 1u) ||
+	    (*(volatile uint32_t *)(s + POLARIS_SMR(POLARIS_G3D_SMR)) & 0x8000ffffu) !=
+	    (0x80000000u | POLARIS_G3D_STREAM)) {
+		printf("POLARIS G3D: the SMMU did not take the 3D context\n");
+		return -1;
+	}
+	printf("POLARIS G3D: stream %u -> context %u, 17 pages of sqe/ring/memptrs\n",
+	    POLARIS_G3D_STREAM, POLARIS_G3D_CTX);
+	return 0;
+}
+
 void
 polaris_gpu_gmu_boot(void)
