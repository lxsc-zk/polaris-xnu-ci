--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6881,7 +6881,14 @@
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	/*
+	 * ptoa() widens before the shift: pp << PAGE_SHIFT is a 32-bit shift and drops the high
+	 * bits of physical addresses at or above 4 GiB (all of DRAM on boards whose memory starts
+	 * there), which phystokv() then rejects with "illegal PA". UniXNU carries this same fix
+	 * (patches/xnu/zzx-pmap-sync-64bit-pa.patch); here it is what kept buffers above 4 GiB
+	 * from ever being synced, so their cache attributes never settled.
+	 */
+	flush_dcache((vm_offset_t) ptoa(pp), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP
