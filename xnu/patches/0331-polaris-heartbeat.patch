 void
+sweet_gpu_heartbeat(void)
+{
+	static uint32_t beat;
+	vm_offset_t core = gpu_core;
+
+	beat++;
+	if (core == 0) {
+		printf("SWEET HB %u: no core\n", beat);
+		return;
+	}
+	printf("SWEET HB %u: rbbm_status %#x cp_status1 %#x rptr %u wptr %u hw_fault %#x irq %#x live %d\n",
+	    beat, gpu_cp_rd(core, A6XX_RBBM_STATUS), gpu_cp_rd(core, A6XX_CP_STATUS_1),
+	    gpu_cp_rd(core, A6XX_CP_RB_RPTR), gpu_cp_wptr,
+	    gpu_cp_rd(core, A6XX_CP_HW_FAULT), gpu_cp_rd(core, A6XX_CP_INTERRUPT_STATUS),
+	    (int)gpu_live);
+}
