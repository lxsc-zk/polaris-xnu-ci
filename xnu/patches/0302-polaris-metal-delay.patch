 void
+AppleCLCD::accelFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+
+	if (fb != NULL) {
+		fb->publishAccelAgain();
+	}
+}
+
+void
+AppleCLCD::publishAccelAgain(void)
+{
+	IOAcceleratorES *accelerator = OSTypeAlloc(IOAcceleratorES);
+	uint32_t realPlugin = 0;
+	const char *pluginName;
+	const char *pluginClass;
+
+	if (accelerator == NULL) {
+		return;
+	}
+	if (!accelerator->init() || !accelerator->attach(this)) {
+		accelerator->release();
+		return;
+	}
+	(void) PE_parse_boot_argn("metalplugin", &realPlugin, sizeof(realPlugin));
+	pluginName  = realPlugin ? "SweetBGMTL" : "SweetMetalProbe";
+	pluginClass = realPlugin ? "BGMTLDevice" : "SweetMetalDevice";
+	accelerator->setProperty(kIOUserClientClassKey, "IOAcceleratorESUserClient");
+	accelerator->setProperty("MetalPluginName", pluginName);
+	accelerator->setProperty("MetalPluginClassName", pluginClass);
+	accelerator->setName("sgx");
+	accelerator->registerService();
+	IOLog("SWEET FB: IOAcceleratorES published again (MetalPluginName %s class %s)\n",
+	    pluginName, pluginClass);
+}
