+/*
+ * The A6xx GMU block sits behind an AHB fence and GPUCC block reset
+ * controllers (BCR). Writes are silently dropped while the fence is not in
+ * ALLOW mode or the block is held in reset; the vendor driver exposes this
+ * through adreno_gmu_fenced_write() and checks the "writedropped" bits.
+ */
+void
+polaris_gpu_fence(void)
+{
+	int optin = 0;
+	vm_offset_t gpucc, gcc, gmu;
+	uint32_t v, i, w;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 32) {
+		return;
+	}
+	gpucc = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!gpucc || !gcc || !gmu) {
+		printf("POLARIS FNC: map failed\n");
+		return;
+	}
+	printf("POLARIS FNC: GDSC_CX=0x%08x hw_ctrl=0x%08x GDSC_GX=0x%08x\n",
+	    pwr_read(gpucc, GDSC_CX), pwr_read(gpucc, 0x1540u),
+	    pwr_read(gpucc, GDSC_GX));
+	{
+		static const uint32_t bcr[7] = {
+			0x1000u, 0x1008u, 0x1068u, 0x10a0u,
+			0x1110u, 0x111cu, 0x1160u,
+		};
+		static const char *nm[7] = {
+			"xo", "gx", "cx", "gfx3d_aon",
+			"spdm", "gmu", "acd",
+		};
+		for (i = 0; i < 7; i++) {
+			printf("POLARIS FNC: bcr_%s(0x%04x)=0x%08x\n",
+			    nm[i], bcr[i], pwr_read(gpucc, bcr[i]));
+		}
+		for (i = 0; i < 7; i++) {
+			v = pwr_read(gpucc, bcr[i]);
+			if (v & (1u << 31)) {
+				pwr_write(gpucc, bcr[i], v & ~(1u << 31));
+				pwr_delay();
+				printf("POLARIS FNC: bcr_%s cleared -> 0x%08x\n",
+				    nm[i], pwr_read(gpucc, bcr[i]));
+			}
+		}
+	}
+	w = pwr_read(gmu, 0x23b10u);
+	printf("POLARIS FNC: fence_ctrl=0x%08x\n", w);
+	pwr_write(gmu, 0x23b10u, 0u);
+	pwr_delay();
+	w = pwr_read(gmu, 0x23b10u);
+	printf("POLARIS FNC: fence_ctrl after=0x%08x status_byte=0x%02x\n",
+	    w, (w >> 24) & 0xffu);
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	v = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS FNC: general7=0x%08x %s\n", v,
+	    (v == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	pwr_write(gmu, 0x23b06u, 0xffffffffu);
+	pwr_delay();
+	printf("POLARIS FNC: ao_word23b04=0x%08x\n", pwr_read(gmu, 0x23b04u));
+	printf("POLARIS FNC: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
