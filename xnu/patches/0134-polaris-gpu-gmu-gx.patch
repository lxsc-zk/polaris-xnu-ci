diff --git a/bsd/dev/polaris_gpu_power.c b/bsd/dev/polaris_gpu_power.c
index be6ddaa..10f9057 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -1367,6 +1367,92 @@ polaris_gpu_gmu_writetest(void)
 	}
 }
 
+/*
+ * The GMU sits in the GPU core (GX) power domain, not only CX: kgsl's
+ * gmu_enable_gdsc() enables gx_gdsc before touching any GMU register.
+ * Power both domains, then write/read a GMU scratch register.
+ */
+void
+polaris_gpu_gmu_gx(void)
+{
+	int optin = 0;
+	vm_offset_t base, gcc, gmu;
+	uint32_t v, i, back;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 20) {
+		return;
+	}
+	base = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!base || !gcc || !gmu) {
+		printf("POLARIS GX: map failed\n");
+		return;
+	}
+	/* CX */
+	v = pwr_read(base, GDSC_CX);
+	printf("POLARIS GX: CX before=0x%08x\n", v);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	printf("POLARIS GX: CX after=0x%08x\n", pwr_read(base, GDSC_CX));
+	/* GX */
+	v = pwr_read(base, GDSC_GX);
+	printf("POLARIS GX: GX before=0x%08x\n", v);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_GX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_GX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	printf("POLARIS GX: GX after=0x%08x (polls=%u)\n",
+	    pwr_read(base, GDSC_GX), i);
+	/* clocks */
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	pwr_write(base, 0x1120u, 0x00000003u);
+	pwr_delay();
+	pwr_write(base, 0x1124u, 0x00000601u);
+	pwr_delay();
+	v = pwr_read(base, 0x1098u);
+	v |= (0xfu << 8) | (0xfu << 4);
+	v &= ~(1u << 31);
+	v |= 1u;
+	pwr_write(base, 0x1098u, v);
+	pwr_delay();
+	printf("POLARIS GX: cbcr=0x%08x\n", pwr_read(base, 0x1098u));
+	/* GMU scratch write test */
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	back = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS GX: general7 read 0x%08x %s\n", back,
+	    (back == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	pwr_delay();
+	printf("POLARIS GX: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
+
