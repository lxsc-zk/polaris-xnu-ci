Subject: [PATCH] polaris: CP_MEM_WRITE targets the memptrs page where it is mapped

--- a/bsd/dev/polaris_gpu_diag.c
+++ b/bsd/dev/polaris_gpu_diag.c
@@ -1250,7 +1250,11 @@
 	memptrs[3] = 0u;
 	polaris_pt_clean((vm_offset_t)memptrs, 0x1000u);
 	ring[wptr++] = polaris_pkt7(0x3du, 4u);	/* CP_MEM_WRITE */
-	ring[wptr++] = 0x10010008u;		/* IOVA of memptrs[2] */
+	/*
+	 * polaris (0381): the 3D core's pages are mapped at 0x60000000 by polaris_g3d_space();
+	 * the memptrs page is the 17th, so this is 0x60010000 + 8, not 0x10010000 + 8.
+	 */
+	ring[wptr++] = 0x60010008u;		/* IOVA of memptrs[2] */
 	ring[wptr++] = 0u;
 	ring[wptr++] = 0xc0ffee21u;
 	ring[wptr++] = 0x0badf00du;
