--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -575,9 +575,24 @@
 {
 	uint32_t w = off / gpu_arena_window_bytes;
 
-	if (gpu_arena_window_bytes == 0 || w >= GPU_ARENA_WINDOWS || off >= gpu_arena_mapped_bytes) {
+	if (gpu_arena_window_bytes == 0 || w >= GPU_ARENA_WINDOWS || off >= gpu_arena_size) {
 		return 0;
 	}
+	/*
+	 * A window is mapped the first time something reaches it: a whole 64 MiB arena does not
+	 * fit the IOKit submap in one ml_io_map, but 128 windows of 1 MiB do, and a buffer that
+	 * spans several of them still gets valid memory one window at a time.
+	 */
+	if (gpu_arena_windows[w] == 0) {
+		gpu_arena_windows[w] = ml_io_map(
+		    (vm_offset_t)(gpu_arena_pa + (uint64_t)w * gpu_arena_window_bytes),
+		    (vm_size_t)gpu_arena_window_bytes);
+		if (gpu_arena_windows[w] == 0) {
+			printf("SWEET GPU: arena window %u (pa %#llx) does not map\n", w,
+			    (unsigned long long)(gpu_arena_pa + (uint64_t)w * gpu_arena_window_bytes));
+			return 0;
+		}
+	}
 	return gpu_arena_windows[w] + (off % gpu_arena_window_bytes);
 }
 
