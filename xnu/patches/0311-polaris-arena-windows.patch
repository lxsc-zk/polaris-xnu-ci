+		zero = (volatile uint32_t *)gpu_arena_kva(off + done);
+		if (zero == NULL) {
+			break;
+		}
+		for (uint32_t i = 0; i < chunk / 4; i++) {
 			zero[i] = 0;
 		}
+		done += chunk;
 	}
 
