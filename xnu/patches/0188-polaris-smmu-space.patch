+/* ---- SMMU stage-1 context bring-up, after hakios.adreno.c space_on() ---- */
+#define POLARIS_IDR0		0x020u
+#define POLARIS_IDR1		0x024u
+#define POLARIS_SMR(n)		(0x800u + 4u * (n))
+#define POLARIS_S2CR(n)		(0xc00u + 4u * (n))
+#define POLARIS_CBAR(n)		(0x1000u + 4u * (n))
+#define POLARIS_CBA2R(n)	(0x1800u + 4u * (n))
+#define POLARIS_CB_SCTLR	0x00u
+#define POLARIS_CB_TCR2		0x10u
+#define POLARIS_CB_TTBR0	0x20u
+#define POLARIS_CB_TTBR1	0x28u
+#define POLARIS_CB_TCR		0x30u
+#define POLARIS_CB_MAIR0	0x38u
+#define POLARIS_CB_MAIR1	0x3cu
+#define POLARIS_CB_FSR		0x58u
+#define POLARIS_CB_TLBIASID	0x610u
+#define POLARIS_CB_TLBSYNC	0x7f0u
+#define POLARIS_CB_TLBSTATUS	0x7f4u
+
+#define POLARIS_PTE_TABLE	1ull
+#define POLARIS_PTE_PAGE	3ull
+#define POLARIS_PTE_GMU		((2ull << 8) | (1ull << 10) | (1ull << 11))
+#define POLARIS_PTE_ADDR	0x0000fffffffff000ull
+
+#define POLARIS_CBAR_STAGE_1	((1u << 16) | (3u << 8) | (0xfu << 12))
+#define POLARIS_TCR_39		(25u | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23))
+#define POLARIS_TCR2		(1u | (1u << 4) | (7u << 15))
+#define POLARIS_MAIR0		0xf404ff44u
+#define POLARIS_SCTLR_ON	((1u << 0) | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 12))
+#define POLARIS_FSR_ALL		0xc00001feu
+
+static uint64_t polaris_pt_root[512] __attribute__((aligned(4096)));
+static uint64_t polaris_pt_l2[512] __attribute__((aligned(4096)));
+static uint64_t polaris_pt_l3[512] __attribute__((aligned(4096)));
+
+extern addr64_t kvtophys(vm_offset_t);
+
+static void
+polaris_pt_clean(vm_offset_t start, vm_size_t size)
+{
+	vm_offset_t line;
+
+	for (line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ __volatile__("dc civac, %0" : : "r"(line));
+	}
+	__asm__ __volatile__("dsb sy" ::: "memory");
+}
+
+static void
+polaris_pt_map(uint64_t va, uint64_t pa)
+{
+	polaris_pt_root[(va >> 30) & 0x1ffu] = kvtophys((vm_offset_t)polaris_pt_l2) |
+	    POLARIS_PTE_TABLE;
+	polaris_pt_l2[(va >> 21) & 0x1ffu] = kvtophys((vm_offset_t)polaris_pt_l3) |
+	    POLARIS_PTE_TABLE;
+	polaris_pt_l3[(va >> 12) & 0x1ffu] = (pa & POLARIS_PTE_ADDR) |
+	    POLARIS_PTE_GMU | POLARIS_PTE_PAGE;
+}
+
+static int
+polaris_smmu_space_on(vm_offset_t s, uint32_t ctx, uint32_t match, uint32_t stream)
+{
+	uint32_t idr1, idr0, page, pages, cb, i;
+	uint64_t root;
+
+	idr0 = *(volatile uint32_t *)(s + POLARIS_IDR0);
+	idr1 = *(volatile uint32_t *)(s + POLARIS_IDR1);
+	page = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	pages = 2u << ((idr1 >> 28) & 7u);
+	printf("POLARIS SPACE: idr0=0x%08x idr1=0x%08x page=0x%x pages=%u ctxs=%u matches=%u\n",
+	    idr0, idr1, page, pages, idr1 & 0xffu, idr0 & 0xffu);
+	if (2u * pages * page != POLARIS_SMMU_LEN) {
+		printf("POLARIS SPACE: layout mismatch, %u bytes expected\n",
+		    2u * pages * page);
+		return -1;
+	}
+	cb = (pages + ctx) * page;
+
+	polaris_pt_clean((vm_offset_t)polaris_pt_root, sizeof(polaris_pt_root));
+	polaris_pt_clean((vm_offset_t)polaris_pt_l2, sizeof(polaris_pt_l2));
+	polaris_pt_clean((vm_offset_t)polaris_pt_l3, sizeof(polaris_pt_l3));
+	root = kvtophys((vm_offset_t)polaris_pt_root) | ((uint64_t)ctx << 48);
+
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR) = 0u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(s + POLARIS_CBA2R(ctx)) = 1u;
+	*(volatile uint32_t *)(s + POLARIS_CBAR(ctx)) = POLARIS_CBAR_STAGE_1;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TCR2) = POLARIS_TCR2;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TCR) = POLARIS_TCR_39;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0) = (uint32_t)root;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0 + 4u) = (uint32_t)(root >> 32);
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR1) = 0u;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR1 + 4u) = 0u;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_MAIR0) = POLARIS_MAIR0;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_MAIR1) = 0u;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_FSR) = POLARIS_FSR_ALL;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TLBIASID) = ctx;
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_TLBSYNC) = 1u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	for (i = 0; i < 100000u; i++) {
+		if (!(*(volatile uint32_t *)(s + cb + POLARIS_CB_TLBSTATUS) & 1u)) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	printf("POLARIS SPACE: cb%u base=0x%x tlbstatus polls=%u\n", ctx, cb, i);
+	*(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR) = POLARIS_SCTLR_ON;
+	*(volatile uint32_t *)(s + POLARIS_S2CR(match)) = ctx;
+	*(volatile uint32_t *)(s + POLARIS_SMR(match)) = 0x80000000u |
+	    (0x400u << 16) | stream;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+
+	printf("POLARIS SPACE: cb%u sctlr=0x%08x ttbr0=0x%08x/%08x tcr=0x%08x tcr2=0x%08x\n",
+	    ctx, *(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR),
+	    *(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0 + 4u),
+	    *(volatile uint32_t *)(s + cb + POLARIS_CB_TTBR0),
+	    *(volatile uint32_t *)(s + cb + POLARIS_CB_TCR),
+	    *(volatile uint32_t *)(s + cb + POLARIS_CB_TCR2));
+	printf("POLARIS SPACE: cbar=0x%08x cba2r=0x%08x smr=0x%08x s2cr=0x%08x\n",
+	    *(volatile uint32_t *)(s + POLARIS_CBAR(ctx)),
+	    *(volatile uint32_t *)(s + POLARIS_CBA2R(ctx)),
+	    *(volatile uint32_t *)(s + POLARIS_SMR(match)),
+	    *(volatile uint32_t *)(s + POLARIS_S2CR(match)));
+	if (*(volatile uint32_t *)(s + POLARIS_SMR(match)) !=
+	    (0x80000000u | (0x400u << 16) | stream) ||
+	    (*(volatile uint32_t *)(s + POLARIS_S2CR(match)) & 0x300ffu) != ctx ||
+	    !(*(volatile uint32_t *)(s + cb + POLARIS_CB_SCTLR) & 1u)) {
+		printf("POLARIS SPACE: SMMU REJECTED the configuration\n");
+		return -1;
+	}
+	printf("POLARIS SPACE: context %u carries stream %u\n", ctx, stream);
+	return 0;
+}
