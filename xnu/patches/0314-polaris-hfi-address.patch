Subject: [PATCH] polaris: put the HFI table at 0x60000000, log at 0x60100000

--- a/bsd/dev/hakios.adreno.c
+++ b/bsd/dev/hakios.adreno.c
@@ -1770,9 +1770,9 @@
  * 0x60006000 with the queues packed after it, while still telling the GMU 0x60009000 and
  * mapping a single page: the firmware then walked into unmapped IOVAs and the CPU hung on
  * the next GMU register read. */
-#define GMU_LOG_ADDRESS         0x60005000u
+#define GMU_LOG_ADDRESS         0x60100000u       /* the vendor's second kernel slot: 0x60000000 + 1 MB */
 #define GMU_LOG_SIZE            0x4000u
-#define GMU_HFI_ADDRESS         0x60009000u
+#define GMU_HFI_ADDRESS         0x60000000u       /* kgsl_gmu.c: hfi_mem is entry 0 off noncached_kstart */
 #define GMU_HFI_SIZE            0x4000u         /* the table's page and the three queues' */
 /* the address HFI_SFR_ADDR points the firmware at (0x06030100) -- it writes there during
  * HFI bring-up, and nothing used to map that window: an untranslated access resets the SoC. */
@@ -2166,7 +2166,7 @@
 	gmu_rail_vote();
 	put(&gmu, "cm3_fw_init_result", GMU_CM3_FW_INIT_RESULT, 0);
 	put(&gmu, "cm3_boot_config", GMU_CM3_BOOT_CONFIG, 2);
-	put(&gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, 0x60009000u);
+	put(&gmu, "hfi_qtbl_addr", GMU_HFI_QTBL_ADDR, GMU_HFI_ADDRESS);
 	put(&gmu, "hfi_qtbl_info", GMU_HFI_QTBL_INFO, 1);
 	put(&gmu, "ahb_fence_range_0", GMU_AHB_FENCE_RANGE_0, 0x802800a0u);
 	put(&gmu, "cm3_cfg", GMU_CM3_CFG, 0x4052);
@@ -2177,7 +2177,7 @@
 	put(&gmu, "pwr_col_cp_resp", GMU_PWR_COL_CP_RESP, 0);
 	put(&gmu, "wfi_config", GMU_WORD(0x5002), 0);   /* our own bring-up writes this */
 	put(&gmu, "hfi_sfr_addr", GMU_HFI_SFR_ADDR, 0x06030100u);
-	put(&gmu, "pwr_col_cp_msg", GMU_PWR_COL_CP_MSG, 0x60005003u);
+	put(&gmu, "pwr_col_cp_msg", GMU_PWR_COL_CP_MSG, GMU_LOG_ADDRESS | (GMU_LOG_SIZE / PAGE_SIZE - 1));
 	put(&gmu, "sys_bus_config", GMU_SYS_BUS_CONFIG, 1);
 	put(&gmu, "icache_config", GMU_ICACHE_CONFIG, 1);
 	put(&gmu, "dcache_config", GMU_DCACHE_CONFIG, 1);
