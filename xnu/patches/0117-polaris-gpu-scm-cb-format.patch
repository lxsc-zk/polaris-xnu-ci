diff --git a/bsd/dev/polaris_gpu_power.c b/bsd/dev/polaris_gpu_power.c
index 1ae4c2d..a14c055 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -413,6 +413,30 @@ polaris_scm_mp(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t *res
 	return (int)x0;
 }
 
+
+/*
+ * msm_tz_set_cb_format(): SCM_SVC_SMMU_PROGRAM (0x15) with
+ * SMMU_CHANGE_PAGETABLE_FORMAT (0x01):
+ *   args[0] = sec_id (TZ_DEVICE_GPU == 18), args[1] = cb, args[2] = 1
+ */
+static int
+polaris_scm_set_cb_format(uint32_t cb)
+{
+	register uint64_t x0 __asm__("x0") = 0x42001501ull;
+	register uint64_t x1 __asm__("x1") = 3ull;
+	register uint64_t x2 __asm__("x2") = 18ull;
+	register uint64_t x3 __asm__("x3") = (uint64_t)cb;
+	register uint64_t x4 __asm__("x4") = 1ull;
+	register uint64_t x5 __asm__("x5") = 0ull;
+
+	__asm__ __volatile__(
+	    "smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5)
+	    :
+	    : "memory");
+	return (int)x0;
+}
+
