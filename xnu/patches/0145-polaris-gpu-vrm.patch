@@ -587,6 +587,10 @@ bsd_init(void)
 		extern void polaris_gpu_cmddb(void);
 		polaris_gpu_cmddb();
 	}
+	{
+		extern void polaris_gpu_vrm(void);
+		polaris_gpu_vrm();
+	}
 	{
 		extern void polaris_gpu_gmu_window(void);
 		polaris_gpu_gmu_window();
