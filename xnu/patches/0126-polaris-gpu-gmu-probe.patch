 	}
 }
 
+/* Read candidate GMU register addresses one by one so a bad one is visible. */
+void
+polaris_gpu_gmu_probe(void)
+{
+	int optin = 0;
+	vm_offset_t map;
+	uint32_t i;
+	static const struct { uint64_t pa; const char *name; } regs[] = {
+		{ 0x506a000ull, "gmu_base_0" },
+		{ 0x506a004ull, "gmu_base_4" },
+		{ 0x501f800ull, "sysreset" },
+		{ 0x501f801ull, "boot_config" },
+		{ 0x501f81cull, "fw_init_result" },
+		{ 0x501f9ccull, "general_7" },
+		{ 0x501f985ull, "hfi_qtbl_addr" },
+		{ 0x501b400ull, "itcm_start" },
+		{ 0x5023b05ull, "ao_intr_status" },
+		{ 0x506b400ull, "gmu_plus_itcm" },
+	};
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 13) {
+		return;
+	}
+	for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		map = ml_io_map((vm_offset_t)(regs[i].pa & ~0xfffull), 0x1000);
+		if (!map) {
+			printf("POLARIS GMU: %s map failed\n", regs[i].name);
+			continue;
+		}
+		printf("POLARIS GMU: %s @0x%llx = 0x%08x\n", regs[i].name,
+		    (unsigned long long)regs[i].pa,
+		    pwr_read(map, (uint32_t)(regs[i].pa & 0xfffull)));
+	}
+	printf("POLARIS GMU: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
+
