+/* Page-granular HFI: the table and each queue live in their own 4 KiB page,
+ * so no 16 KiB physical contiguity is required. Each queue advertises its own
+ * physical start address, which is what the GMU sees in SMMU bypass mode. */
+static uint8_t polaris_hfi_tbl[4096] __attribute__((aligned(4096)));
+static uint8_t polaris_hfi_q[3][4096] __attribute__((aligned(4096)));
+
+static void
+polaris_hfi_build_pages(const uint32_t *pa_q)
+{
+	static const uint32_t ids[3] = { 0u, 4u, 5u };
+	static const uint32_t prio[3] = { 10u, 10u, 40u };
+	uint32_t i, b;
+
+	for (i = 0; i < 4096u; i += 4u) {
+		*(volatile uint32_t *)(polaris_hfi_tbl + i) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_q[0] + i) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_q[1] + i) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_q[2] + i) = 0u;
+	}
+
+	*(volatile uint32_t *)(polaris_hfi_tbl + 0x00u) = 0u;
+	*(volatile uint32_t *)(polaris_hfi_tbl + 0x04u) = 42u;
+	*(volatile uint32_t *)(polaris_hfi_tbl + 0x08u) = 6u;
+	*(volatile uint32_t *)(polaris_hfi_tbl + 0x0cu) = 12u;
+	*(volatile uint32_t *)(polaris_hfi_tbl + 0x10u) = 3u;
+	*(volatile uint32_t *)(polaris_hfi_tbl + 0x14u) = 3u;
+
+	for (i = 0; i < 3u; i++) {
+		b = 0x18u + i * 48u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x00u) = pa_q[i];
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x04u) =
+		    (ids[i] & 0xffu) | ((prio[i] & 0xffu) << 8);
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x08u) = 1u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x0cu) = 1024u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x10u) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x14u) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x18u) = 1u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x1cu) = 1u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x20u) = 1u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x24u) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x28u) = 0u;
+		*(volatile uint32_t *)(polaris_hfi_tbl + b + 0x2cu) = 0u;
+	}
+	__asm__ __volatile__("dsb sy" ::: "memory");
+}
+
+/* Put every GPU/GMU stream into a BYPASS slot.  S2CR[0..4] already read back
+ * 0x000200ff (TYPE=2 bypass) and are not writable, so we only touch SMR. */
+static void
+polaris_smmu_bypass(vm_offset_t smmu)
+{
+	static const uint32_t slot_sid[5] = { 3u, 4u, 5u, 0u, 1u };
+	uint32_t i;
+
+	*(volatile uint32_t *)(smmu + 0x800u + 5u * 4u) = 0u;
+	*(volatile uint32_t *)(smmu + 0x800u + 6u * 4u) = 0u;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+
+	for (i = 0; i < 5u; i++) {
+		*(volatile uint32_t *)(smmu + 0x800u + i * 4u) =
+		    0x80000000u | slot_sid[i];
+		__asm__ __volatile__("dsb sy" ::: "memory");
+	}
+	for (i = 0; i < 7u; i++) {
+		printf("POLARIS BYPASS: smr%u=0x%08x s2cr%u=0x%08x\n", i,
+		    *(volatile uint32_t *)(smmu + 0x800u + i * 4u), i,
+		    *(volatile uint32_t *)(smmu + 0xc00u + i * 4u));
+	}
+}
