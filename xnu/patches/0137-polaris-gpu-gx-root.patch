diff --git a/bsd/dev/polaris_gpu_power.c b/bsd/dev/polaris_gpu_power.c
index e4d9802..912b6d0 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -1640,6 +1640,93 @@ polaris_gpu_gx_clocks(void)
 	}
 }
 
+/*
+ * gpu_gx_gdsc has "qcom,force-enable-root-clk": the core root clock
+ * (gpu_cc_gx_gfx3d_clk_src at 0x101c) must run before the domain can be
+ * powered. Point the RCG at GPLL0 (parent 5, always on) and enable it.
+ */
+void
+polaris_gpu_gx_root(void)
+{
+	int optin = 0;
+	vm_offset_t base, gcc, gmu;
+	uint32_t v, i, cmd, cfg, br;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 23) {
+		return;
+	}
+	base = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!base || !gcc || !gmu) {
+		printf("POLARIS GRT: map failed\n");
+		return;
+	}
+	/* CX domain */
+	v = pwr_read(base, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	/* GPLL0 gate for the GPU */
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	printf("POLARIS GRT: gcc52004=0x%08x CX=0x%08x GX=0x%08x\n",
+	    pwr_read(gcc, 0x52004u), pwr_read(base, GDSC_CX),
+	    pwr_read(base, GDSC_GX));
+	/* RCG 0x101c: source select GPLL0 (5), divide by 1 */
+	pwr_write(base, 0x101cu, 0x00000002u);
+	pwr_delay();
+	pwr_write(base, 0x1020u, 0x00000501u);
+	pwr_delay();
+	cmd = pwr_read(base, 0x101cu);
+	cfg = pwr_read(base, 0x1020u);
+	printf("POLARIS GRT: rcg cmd=0x%08x cfg=0x%08x\n", cmd, cfg);
+	/* branch gx_gfx3d_clk */
+	br = pwr_read(base, 0x1054u);
+	pwr_write(base, 0x1054u, br | 1u);
+	pwr_delay();
+	printf("POLARIS GRT: branch1054 0x%08x -> 0x%08x\n", br,
+	    pwr_read(base, 0x1054u));
+	/* now the GX domain */
+	v = pwr_read(base, GDSC_GX);
+	printf("POLARIS GRT: GX before=0x%08x\n", v);
+	pwr_write(base, GDSC_GX, v & ~1u);
+	for (i = 0; i < 5000; i++) {
+		pwr_delay();
+		v = pwr_read(base, GDSC_GX);
+		if (v & (1u << 31)) {
+			break;
+		}
+	}
+	printf("POLARIS GRT: GX after=0x%08x polls=%u %s\n", v, i,
+	    (v & (1u << 31)) ? "ON" : "OFF");
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	v = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS GRT: general7=0x%08x %s\n", v,
+	    (v == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	printf("POLARIS GRT: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
+
