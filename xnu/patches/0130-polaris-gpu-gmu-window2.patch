@@ -543,6 +543,10 @@ bsd_init(void)
 		extern void polaris_gpu_gmu_clocked(void);
 		polaris_gpu_gmu_clocked();
 	}
+	{
+		extern void polaris_gpu_gmu_window2(void);
+		polaris_gpu_gmu_window2();
+	}
 	{
 		extern void polaris_gpu_gmu_window(void);
