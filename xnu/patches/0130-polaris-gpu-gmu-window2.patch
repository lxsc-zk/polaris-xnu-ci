diff --git a/bsd/dev/polaris_gpu_power.c b/bsd/dev/polaris_gpu_power.c
index 1244a5f..6e1b96a 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -1051,6 +1051,95 @@ polaris_gpu_gmu_clocked(void)
 	}
 }
 
+/*
+ * Correct clk-rcg2 programming for gpu_cc_cx_gmu_clk: CMD at 0x1120
+ * (ROOT_EN), CFG at 0x1124 (200 MHz from GPLL0/1.5), then the branch at
+ * 0x1098. Finally read the GMU register window.
+ */
+void
+polaris_gpu_gmu_window2(void)
+{
+	int optin = 0;
+	vm_offset_t base, gcc, gmu;
+	uint32_t v, i, halt;
+	static const struct { uint32_t off; const char *name; } regs[] = {
+		{ 0x00000u, "csr_0x00000" },
+		{ 0x1f800u, "sysreset" },
+		{ 0x1f801u, "boot_config" },
+		{ 0x1f81cu, "fw_init_result" },
+		{ 0x1f9ccu, "general_7" },
+		{ 0x1f985u, "hfi_qtbl_addr" },
+		{ 0x23b05u, "ao_intr_status" },
+		{ 0x1b400u, "itcm_start" },
+	};
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 16) {
+		return;
+	}
+	base = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	if (!base || !gcc) {
+		printf("POLARIS GW2: map failed\n");
+		return;
+	}
+	v = pwr_read(base, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	printf("POLARIS GW2: CX=0x%08x\n", pwr_read(base, GDSC_CX));
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	/* CMD: root enable + update */
+	pwr_write(base, 0x1120u, 0x00000003u);
+	pwr_delay();
+	/* CFG: src_sel=6 (gpll0_div), div=1 -> 200 MHz */
+	pwr_write(base, 0x1124u, 0x00000601u);
+	pwr_delay();
+	printf("POLARIS GW2: rcg cmd=0x%08x cfg=0x%08x\n",
+	    pwr_read(base, 0x1120u), pwr_read(base, 0x1124u));
+	v = pwr_read(base, 0x1098u);
+	v |= (0xfu << 8) | (0xfu << 4);
+	v &= ~(1u << 31);
+	v |= 1u;
+	pwr_write(base, 0x1098u, v);
+	halt = 0x80000000u;
+	for (i = 0; i < 1000; i++) {
+		halt = pwr_read(base, 0x1098u);
+		if (!(halt & 0x80000000u)) {
+			break;
+		}
+	}
+	printf("POLARIS GW2: cbcr1098=0x%08x polls=%u\n", halt, i);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!gmu) {
+		printf("POLARIS GW2: gmu map failed\n");
+		return;
+	}
+	for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		printf("POLARIS GW2: %s (+0x%05x) = 0x%08x\n",
+		    regs[i].name, regs[i].off, pwr_read(gmu, regs[i].off));
+	}
+	printf("POLARIS GW2: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
+
