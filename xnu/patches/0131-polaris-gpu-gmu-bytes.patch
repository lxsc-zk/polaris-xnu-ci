index 6e1b96a..d8872b5 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -1140,6 +1140,76 @@ polaris_gpu_gmu_window2(void)
 	}
 }
 
+/*
+ * GMU register window with correct access widths: the A6xx GMU block has
+ * byte-wide registers (BOOT_CONFIG 0x1f801, HFI_QTBL_ADDR 0x1f985,
+ * AO interrupt status 0x23b05) next to 32-bit ones.
+ */
+void
+polaris_gpu_gmu_bytes(void)
+{
+	int optin = 0;
+	vm_offset_t base, gcc, gmu;
+	uint32_t v, i;
+	volatile uint8_t *b;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 17) {
+		return;
+	}
+	base = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!base || !gcc || !gmu) {
+		printf("POLARIS GB: map failed\n");
+		return;
+	}
+	v = pwr_read(base, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	pwr_write(base, 0x1120u, 0x00000003u);
+	pwr_delay();
+	pwr_write(base, 0x1124u, 0x00000601u);
+	pwr_delay();
+	v = pwr_read(base, 0x1098u);
+	v |= (0xfu << 8) | (0xfu << 4);
+	v &= ~(1u << 31);
+	v |= 1u;
+	pwr_write(base, 0x1098u, v);
+	pwr_delay();
+	printf("POLARIS GB: CX=0x%08x cbcr=0x%08x\n",
+	    pwr_read(base, GDSC_CX), pwr_read(base, 0x1098u));
+	b = (volatile uint8_t *)gmu;
+	printf("POLARIS GB: sysreset32(+0x1f800)=0x%08x\n", pwr_read(gmu, 0x1f800u));
+	printf("POLARIS GB: boot_config8(+0x1f801)=0x%02x\n", b[0x1f801]);
+	printf("POLARIS GB: fw_init32(+0x1f81c)=0x%08x\n", pwr_read(gmu, 0x1f81cu));
+	printf("POLARIS GB: general7_32(+0x1f9cc)=0x%08x\n", pwr_read(gmu, 0x1f9ccu));
+	printf("POLARIS GB: hfi_qtbl8(+0x1f985)=0x%02x\n", b[0x1f985]);
+	printf("POLARIS GB: ao_intr8(+0x23b05)=0x%02x\n", b[0x23b05]);
+	printf("POLARIS GB: itcm32(+0x1b400)=0x%08x\n", pwr_read(gmu, 0x1b400u));
+	printf("POLARIS GB: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
