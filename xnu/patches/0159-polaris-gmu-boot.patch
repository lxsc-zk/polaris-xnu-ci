diff --git a/bsd/dev/polaris_gpu_diag.c b/bsd/dev/polaris_gpu_diag.c
index 86777d0..d7427f2 100644
--- a/bsd/dev/polaris_gpu_diag.c
+++ b/bsd/dev/polaris_gpu_diag.c
@@ -137,4 +137,149 @@ polaris_gpu_diag(void)
 		}
 	}
 }
+
+/*
+ * Minimal GMU boot attempt with the correct A6xx addressing
+ * (absolute = 0x5000000 + (register define << 2)):
+ *   CX + clocks -> ITCM 32 KiB -> BOOT_CONFIG=2 -> SYSRESET 1->0
+ *   -> poll CM3_FW_INIT_RESULT for 0xBABEFACE.
+ */
+void
+polaris_gpu_gmu_boot(void)
+{
+	DTEntry mmap;
+	uint64_t blob = 0, blob_size = 0;
+	vm_offset_t gpu, gpucc, gcc, src;
+	uint32_t v, i;
+	int optin = 0;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 34) {
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mmap) != kSuccess ||
+	    !gpu_pair(mmap, "GPU-GMU", &blob, &blob_size) ||
+	    blob_size != 32768u || !blob) {
+		printf("POLARIS BOOT: GPU-GMU blob missing/size=%llu\n", blob_size);
+		return;
+	}
+	printf("POLARIS BOOT: blob=0x%llx size=%llu\n",
+	    (unsigned long long)blob, (unsigned long long)blob_size);
+
+	gpu = ml_io_map(0x5000000ull, 0x1000000);
+	gpucc = ml_io_map(0x5090000ull, 0x10000);
+	gcc = ml_io_map(0x100000ull, 0x100000);
+	src = ml_io_map((vm_offset_t)blob, (vm_size_t)blob_size);
+	if (!gpu || !gpucc || !gcc || !src) {
+		printf("POLARIS BOOT: map failed\n");
+		return;
+	}
+
+	/* 1. CX domain */
+	v = *(volatile uint32_t *)(gpucc + 0x106cu);
+	if (!(v & (1u << 31))) {
+		*(volatile uint32_t *)(gpucc + 0x106cu) = v & ~1u;
+		for (i = 0; i < 5000; i++) {
+			if (*(volatile uint32_t *)(gpucc + 0x106cu) & (1u << 31)) {
+				break;
+			}
+			__asm__ __volatile__("nop");
+		}
+	}
+	printf("POLARIS BOOT: CX=0x%08x polls=%u\n",
+	    *(volatile uint32_t *)(gpucc + 0x106cu), i);
+
+	/* 2. GPU clocks: GPLL0 gates + GCC branches + GPUCC GMU clocks */
+	v = *(volatile uint32_t *)(gcc + 0x52004u);
+	*(volatile uint32_t *)(gcc + 0x52004u) = v | (1u << 15) | (1u << 16);
+	*(volatile uint32_t *)(gcc + 0x71004u) |= 1u;
+	*(volatile uint32_t *)(gcc + 0x7100cu) |= 1u;
+	*(volatile uint32_t *)(gcc + 0x71018u) |= 1u;
+	*(volatile uint32_t *)(gcc + 0x44038u) |= 1u;
+	/* gmu_clk_src RCG: root enable, 200 MHz from GPLL0/1.5, then update */
+	*(volatile uint32_t *)(gpucc + 0x1120u) = 0x00000002u;
+	*(volatile uint32_t *)(gpucc + 0x1124u) = 0x00000601u;
+	*(volatile uint32_t *)(gpucc + 0x1120u) = 0x00000003u;
+	/* cx_gmu_clk branch: wake/sleep nibbles + enable */
+	v = *(volatile uint32_t *)(gpucc + 0x1098u);
+	*(volatile uint32_t *)(gpucc + 0x1098u) =
+	    (v & ~(1u << 31)) | 1u | (0xfu << 4) | (0xfu << 8);
+	*(volatile uint32_t *)(gpucc + 0x109cu) |= 1u;	/* cxo_clk */
+	*(volatile uint32_t *)(gpucc + 0x1064u) |= 1u;	/* gx_gmu_clk */
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS BOOT: rcg=0x%08x cbcr1098=0x%08x 109c=0x%08x 1064=0x%08x\n",
+	    *(volatile uint32_t *)(gpucc + 0x1120u),
+	    *(volatile uint32_t *)(gpucc + 0x1098u),
+	    *(volatile uint32_t *)(gpucc + 0x109cu),
+	    *(volatile uint32_t *)(gpucc + 0x1064u));
+
+	/* 3. addressing proof: GENERAL_7 at 0x507E730 */
+	*(volatile uint32_t *)(gpu + 0x7e730u) = 0xdeadbeefu;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	v = *(volatile uint32_t *)(gpu + 0x7e730u);
+	printf("POLARIS BOOT: GENERAL_7@0x507E730=0x%08x %s\n", v,
+	    (v == 0xdeadbeefu) ? "ADDR-OK" : "ADDR-FAIL");
+	if (v != 0xdeadbeefu) {
+		/* compare with the previously used (wrong) address */
+		*(volatile uint32_t *)(gpu + 0x1f9ccu) = 0xcafebabeu;
+		__asm__ __volatile__("dsb sy" ::: "memory");
+		printf("POLARIS BOOT: old@0x50899CC=0x%08x (hole expected)\n",
+		    *(volatile uint32_t *)(gpu + 0x1f9ccu));
+		return;
+	}
+	/* TCM retention on */
+	*(volatile uint32_t *)(gpu + 0x7e730u) = 1u;
+
+	/* 4. ITCM: 32 KiB -> 0x506D000 */
+	for (i = 0; i < 8192u; i++) {
+		*(volatile uint32_t *)(gpu + 0x6d000u + i * 4u) =
+		    *(volatile uint32_t *)(src + i * 4u);
+	}
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS BOOT: ITCM loaded, first=0x%08x last=0x%08x\n",
+	    *(volatile uint32_t *)(gpu + 0x6d000u),
+	    *(volatile uint32_t *)(gpu + 0x6d000u + 8191u * 4u));
+
+	/* 5. boot config + reset release */
+	*(volatile uint32_t *)(gpu + 0x7e008u) = 0u;	/* CX_GMU_WFI_CONFIG */
+	*(volatile uint32_t *)(gpu + 0x7e070u) = 0u;	/* CM3_FW_INIT_RESULT */
+	*(volatile uint32_t *)(gpu + 0x7e004u) = 2u;	/* CM3_BOOT_CONFIG = TCM_BOOT */
+	*(volatile uint32_t *)(gpu + 0x7e610u) = 0u;	/* HFI_QTBL_INFO = 0 */
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	printf("POLARIS BOOT: bootcfg=0x%08x fwinit=0x%08x\n",
+	    *(volatile uint32_t *)(gpu + 0x7e004u),
+	    *(volatile uint32_t *)(gpu + 0x7e070u));
+
+	*(volatile uint32_t *)(gpu + 0x7e000u) = 1u;	/* CM3_SYSRESET = 1 */
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(gpu + 0x7e000u) = 0u;	/* release */
+	__asm__ __volatile__("dsb sy" ::: "memory");
+
+	/* 6. poll for the GMU init magic */
+	v = 0;
+	for (i = 0; i < 300000u; i++) {
+		v = *(volatile uint32_t *)(gpu + 0x7e070u);
+		if (v == 0xbabefaceu) {
+			break;
+		}
+		__asm__ __volatile__("nop");
+	}
+	printf("POLARIS BOOT: FW_INIT_RESULT=0x%08x polls=%u %s\n", v, i,
+	    (v == 0xbabefaceu) ? "GMU-BOOTED" : "FAIL");
+	printf("POLARIS BOOT: GX=0x%08x CX=0x%08x\n",
+	    *(volatile uint32_t *)(gpucc + 0x100cu),
+	    *(volatile uint32_t *)(gpucc + 0x106cu));
+	printf("POLARIS BOOT: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
+
 #endif
