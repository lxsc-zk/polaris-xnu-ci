+	IOMemoryDescriptor *buf = NULL;
+	/*
+	 * UniXNU's rule, and it is the one that survives here: a buffer is VM memory the driver
+	 * wires, not memory the driver carves out. The VM only manages DRAM above gPhysBase, so
+	 * its pages are pmap-owned and can be mapped into a client - a carved-out arena cannot
+	 * (pmap_enter_pv: unexpected PV head, pmap_data.c:2393). mapGem() takes the pages one at
