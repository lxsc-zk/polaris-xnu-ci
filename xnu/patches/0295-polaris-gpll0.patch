--- a/bsd/dev/hakios.adreno.c	2026-11-01 16:51:12.381193532 +0800
+++ b/bsd/dev/hakios.adreno.c	2026-11-01 16:51:12.405701853 +0800
@@ -2079,6 +2079,27 @@
 	put(&gmu, "gmu2host_intr_clr", GMU_GMU2HOST_INTR_CLR, 0xffffffff);
 
 	gmu_runs = true;
+	/*
+	 * polaris: the GMU's clock comes from GPLL0 and this SoC leaves that PLL
+	 * off, so the CM3 never executes (GMU memory stays 0xdeadbeef). This port's
+	 * own bring-up turns it on explicitly before releasing the reset, with
+	 * gmu_clk_src 3/0x601 rather than the 0x80000011/0x602 used elsewhere.
+	 */
+	{
+		uint32_t v;
+
+		v = rd(gcc.base + 0x52004u);
+		wr(gcc.base + 0x52004u, v | (1u << 15) | (1u << 16));
+		wr(gpucc.base + 0x1120u, 0x3u);
+		wr(gpucc.base + 0x1124u, 0x601u);
+		v = rd(gpucc.base + GPUCC_CX_GMU_CBCR);
+		v |= (0xfu << 8) | (0xfu << 4);
+		v &= ~(1u << 31);
+		v |= 1u;
+		wr(gpucc.base + GPUCC_CX_GMU_CBCR, v);
+		sleep_ms(2);
+		printf("adreno: %u: gpll0 and the GMU clock asked for explicitly (polaris)\n", step);
+	}
 	put(&gmu, "cm3_sysreset", GMU_CM3_SYSRESET, 0);
 	for (int i = 0; i < 5000 && (result & GMU_STARTED_MASK) != GMU_STARTED && !(result & GMU_FAILED); i++) {
