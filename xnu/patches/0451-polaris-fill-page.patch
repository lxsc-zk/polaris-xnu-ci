--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -376,6 +376,20 @@
 			    mapped / PAGE_SIZE, iova + mapped, pa);
 		}
 		ok = pa != 0 && (pa & (PAGE_SIZE - 1)) == 0 && sweet_gpu_vm_map(iova + mapped, pa, ro);
+		/*
+		 * sweet_gpu_vm_map() writes ONE 4 KiB PTE while PAGE_SIZE is 16 KiB, so the call above
+		 * leaves three quarters of every page unmapped: the CP jumped into a hole (the nested
+		 * command buffer's address read back as PTE 0) and wedged with rbbm_status 0x800005,
+		 * its fence never retiring. Fill the rest of the page here, additively.
+		 */
+		if (ok && (pa & (PAGE_SIZE - 1)) == 0) {
+			for (uint32_t k = 0x1000; k < PAGE_SIZE; k += 0x1000) {
+				if (!sweet_gpu_vm_map(iova + mapped + k, pa + k, ro)) {
+					ok = false;
+					break;
+				}
+			}
+		}
 		if (!ok) {
 			IOLog("SWEET GPU: mapGem page %llu of %llu failed: iova %#llx pa %#llx\n",
 			    mapped / PAGE_SIZE, size / PAGE_SIZE, iova, pa);
