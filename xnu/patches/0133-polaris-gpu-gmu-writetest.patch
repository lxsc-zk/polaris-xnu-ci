index 27b3ad2..be6ddaa 100644
--- a/bsd/dev/polaris_gpu_power.c
+++ b/bsd/dev/polaris_gpu_power.c
@@ -1288,6 +1288,85 @@ polaris_gpu_gmu_words(void)
 	}
 }
 
+/*
+ * Write-test the GMU register block: if a known register keeps the value we
+ * write, the block is alive and the firmware can be loaded. Also try the
+ * ITCM window and the RSCC control pair used by the vendor wake sequence.
+ */
+void
+polaris_gpu_gmu_writetest(void)
+{
+	int optin = 0;
+	vm_offset_t base, gcc, gmu;
+	uint32_t v, i, back;
+
+	if (!polaris_touch_i2c_board()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("polarisgpu", &optin, sizeof(optin));
+	if (optin != 19) {
+		return;
+	}
+	base = ml_io_map(GPUCC_PA, GPUCC_LEN);
+	gcc = ml_io_map(GCC_PA, GCC_LEN);
+	gmu = ml_io_map(0x506a000ull, 0x30000);
+	if (!base || !gcc || !gmu) {
+		printf("POLARIS GWT: map failed\n");
+		return;
+	}
+	v = pwr_read(base, GDSC_CX);
+	if (!(v & (1u << 31))) {
+		pwr_write(base, GDSC_CX, v & ~1u);
+		for (i = 0; i < 2000; i++) {
+			v = pwr_read(base, GDSC_CX);
+			if (v & (1u << 31)) {
+				break;
+			}
+		}
+	}
+	v = pwr_read(gcc, 0x52004u);
+	pwr_write(gcc, 0x52004u, v | (1u << 15) | (1u << 16));
+	pwr_delay();
+	pwr_write(base, 0x1120u, 0x00000003u);
+	pwr_delay();
+	pwr_write(base, 0x1124u, 0x00000601u);
+	pwr_delay();
+	v = pwr_read(base, 0x1098u);
+	v |= (0xfu << 8) | (0xfu << 4);
+	v &= ~(1u << 31);
+	v |= 1u;
+	pwr_write(base, 0x1098u, v);
+	pwr_delay();
+	printf("POLARIS GWT: CX=0x%08x cbcr=0x%08x\n",
+	    pwr_read(base, GDSC_CX), pwr_read(base, 0x1098u));
+	/* general_7 is a plain scratch register in the vendor driver */
+	pwr_write(gmu, 0x1f9ccu, 0xdeadbeefu);
+	pwr_delay();
+	back = pwr_read(gmu, 0x1f9ccu);
+	printf("POLARIS GWT: general7 wrote 0xdeadbeef read 0x%08x %s\n",
+	    back, (back == 0xdeadbeefu) ? "OK" : "FAIL");
+	pwr_write(gmu, 0x1f9ccu, 0u);
+	/* ITCM first word */
+	pwr_write(gmu, 0x1b400u, 0xcafebabeu);
+	pwr_delay();
+	back = pwr_read(gmu, 0x1b400u);
+	printf("POLARIS GWT: itcm wrote 0xcafebabe read 0x%08x %s\n",
+	    back, (back == 0xcafebabeu) ? "OK" : "FAIL");
+	/* RSCC request/ack pair */
+	pwr_write(gmu, 0x23b00u, 0x00000002u);
+	pwr_delay();
+	printf("POLARIS GWT: rscc_req=0x%08x ack=0x%08x\n",
+	    pwr_read(gmu, 0x23b00u), pwr_read(gmu, 0x23b01u & ~3u));
+	printf("POLARIS GWT: done\n");
+	{
+		volatile uint64_t spin = 0;
+		while (spin < 20000000000ull) {
+			spin++;
+			__asm__ __volatile__("nop");
+		}
+	}
+}
